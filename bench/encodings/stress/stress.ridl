package bench.stress

/// A string at the top of what a signal carries.
type LongText: string [1..512] = "-"

/// A short label.
type Label: string [1..16] = "-"

/// A small count.
type Count: integer [0..65535]

/// A string of several kilobytes.
type BigText: string [1..3000] = "-"

/// One integer of a long list of samples.
type Sample: integer [0..65535]

/// A signal payload that holds one long string.
struct LongStringPayload {
  /// The text.
  text: LongText
}

/// One element of a list of structs.
struct Item {
  /// The element label.
  label: Label
  /// The element count.
  count: Count
}

/// A signal payload that holds a list of structs.
struct ItemListPayload {
  /// The elements.
  items: [Item; 1..16]
}

/// A signal payload whose optional fields hold optional structs.
struct NestedOptionalPayload {
  /// The outer optional.
  outer: Inner?
  /// A plain optional beside it.
  tag: Label?
}

/// The middle layer of the nested optionals.
struct Inner {
  /// An optional struct inside the optional.
  leaf: Leaf?
  /// An optional count.
  count: Count?
}

/// The innermost layer of the nested optionals.
struct Leaf {
  /// The leaf label.
  label: Label
}

/// A signal payload that holds a map.
struct MapPayload {
  /// Counts by label.
  counts: [Label : Count; 0..16]
}

/// A signal payload that holds a string of several kilobytes.
struct BigStringPayload {
  /// The text.
  text: BigText
}

/// A signal payload that holds a long list of structs.
struct BigItemListPayload {
  /// The elements.
  items: [Item; 1..100]
}

/// A signal payload that holds a long list of integers.
struct BigSamplesPayload {
  /// The samples.
  samples: [Sample; 1..1500]
}

/// A signal payload that holds a large map.
struct BigMapPayload {
  /// Counts by label.
  counts: [Label : Count; 0..120]
}

/// A line of a deeply nested payload: a label, a pair of scalars and a short
/// list.
struct DeepRow {
  /// The row label.
  label: Label
  /// The row measurements.
  pair: DeepPair
  /// The cells of the row.
  cells: [DeepCell; 1..4]
}

/// Two scalars.
struct DeepPair {
  /// The first scalar.
  first: Count
  /// The second scalar.
  second: Count
}

/// A cell of a row.
struct DeepCell {
  /// The cell name.
  name: Label
  /// The cell value.
  value: Count
}

/// A signal payload that nests lists of structs three levels deep.
struct DeepNestedPayload {
  /// The rows.
  rows: [DeepRow; 1..10]
}

/// A mode that a peer may extend.
open enum Mode {
  /// Off.
  OFF = 0
  /// On.
  ON = 1
  /// Chosen by the device.
  AUTO = 2
}

/// A reading that is a count, a text or an item.
union Reading {
  /// A count.
  count: Count
  /// A text.
  text: Label
  /// An item.
  item: Item
}

/// A signal payload that holds a union and an open enum.
struct UnionPayload {
  /// The reading.
  reading: Reading
  /// The mode.
  mode: Mode
}

/// The innermost layer of the sparse payload.
struct SparseInner {
  /// Innermost field 0.
  z0: Count?
  /// Innermost field 1.
  z1: Label?
  /// Innermost field 2.
  z2: Count?
  /// Innermost field 3.
  z3: Label?
  /// Innermost field 4.
  z4: Count?
  /// Innermost field 5.
  z5: Label?
  /// Innermost field 6.
  z6: Count?
  /// Innermost field 7.
  z7: Label?
  /// Innermost field 8.
  z8: Count?
  /// Innermost field 9.
  z9: Label?
}

/// The middle layer of the sparse payload.
struct SparseMid {
  /// Middle field 0.
  m0: Count?
  /// Middle field 1.
  m1: Label?
  /// Middle field 2.
  m2: Count?
  /// Middle field 3.
  m3: Label?
  /// Middle field 4.
  m4: Count?
  /// Middle field 5.
  m5: Label?
  /// Middle field 6.
  m6: Count?
  /// Middle field 7.
  m7: Label?
  /// Middle field 8.
  m8: Count?
  /// Middle field 9.
  m9: Label?
  /// The inner layer.
  inner: SparseInner
}

/// A signal payload of three nested layers whose fields are almost all
/// optional.
struct DeepSparsePayload {
  /// Outer field 0.
  a0: Count?
  /// Outer field 1.
  a1: Label?
  /// Outer field 2.
  a2: Count?
  /// Outer field 3.
  a3: Label?
  /// Outer field 4.
  a4: Count?
  /// Outer field 5.
  a5: Label?
  /// Outer field 6.
  a6: Count?
  /// Outer field 7.
  a7: Label?
  /// Outer field 8.
  a8: Count?
  /// Outer field 9.
  a9: Label?
  /// The middle layer.
  mid: SparseMid
}

/// Interface that makes the stress shapes interaction payloads.
interface Stress {
  /// A long string.
  signal longString: LongStringPayload @10ms
  /// A list of structs.
  signal itemList: ItemListPayload @10ms
  /// Nested optionals.
  signal nestedOptional: NestedOptionalPayload @10ms
  /// A map.
  signal map: MapPayload @10ms
  /// A string of several kilobytes.
  signal bigString: BigStringPayload @10ms
  /// A long list of structs.
  signal bigItemList: BigItemListPayload @10ms
  /// A long list of integers.
  signal bigSamples: BigSamplesPayload @10ms
  /// A large map.
  signal bigMap: BigMapPayload @10ms
  /// Rows of structs that hold structs and lists.
  signal deepNested: DeepNestedPayload @10ms
  /// A union and an open enum.
  signal variant: UnionPayload @10ms
  /// A sparse three-layer struct with 30 optional fields.
  signal deepSparse: DeepSparsePayload @10ms
  /// The same struct with every field set.
  signal deepFull: DeepSparsePayload @10ms
}
