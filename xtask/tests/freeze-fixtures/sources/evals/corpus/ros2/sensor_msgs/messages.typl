type RosFloat32 : float
type RosFloat64 : float
type RosInt32 : integer [-2147483648..2147483647]
type RosInt8 : integer [-128..127]
type RosLux : lx
type RosMetres : m
type RosPascals : Pa
type RosSeconds : s
type RosSquareMetres : m2
