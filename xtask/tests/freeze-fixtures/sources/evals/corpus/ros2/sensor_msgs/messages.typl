// Upstream: sensor_msgs/msg/BatteryState.msg
struct BatteryState {

// Constants are chosen to match the enums in the linux kernel
// defined in include/linux/power_supply.h as of version 3.7
// The one difference is for style reasons the constants are
// all uppercase not mixed case.

// Power supply status constants
  // ROS constant POWER_SUPPLY_STATUS_UNKNOWN = 0; package constant BATTERY_STATE_POWER_SUPPLY_STATUS_UNKNOWN
  // ROS constant POWER_SUPPLY_STATUS_CHARGING = 1; package constant BATTERY_STATE_POWER_SUPPLY_STATUS_CHARGING
  // ROS constant POWER_SUPPLY_STATUS_DISCHARGING = 2; package constant BATTERY_STATE_POWER_SUPPLY_STATUS_DISCHARGING
  // ROS constant POWER_SUPPLY_STATUS_NOT_CHARGING = 3; package constant BATTERY_STATE_POWER_SUPPLY_STATUS_NOT_CHARGING
  // ROS constant POWER_SUPPLY_STATUS_FULL = 4; package constant BATTERY_STATE_POWER_SUPPLY_STATUS_FULL

// Power supply health constants
  // ROS constant POWER_SUPPLY_HEALTH_UNKNOWN = 0; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_UNKNOWN
  // ROS constant POWER_SUPPLY_HEALTH_GOOD = 1; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_GOOD
  // ROS constant POWER_SUPPLY_HEALTH_OVERHEAT = 2; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_OVERHEAT
  // ROS constant POWER_SUPPLY_HEALTH_DEAD = 3; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_DEAD
  // ROS constant POWER_SUPPLY_HEALTH_OVERVOLTAGE = 4; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_OVERVOLTAGE
  // ROS constant POWER_SUPPLY_HEALTH_UNSPEC_FAILURE = 5; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_UNSPEC_FAILURE
  // ROS constant POWER_SUPPLY_HEALTH_COLD = 6; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_COLD
  // ROS constant POWER_SUPPLY_HEALTH_WATCHDOG_TIMER_EXPIRE = 7; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_WATCHDOG_TIMER_EXPIRE
  // ROS constant POWER_SUPPLY_HEALTH_SAFETY_TIMER_EXPIRE = 8; package constant BATTERY_STATE_POWER_SUPPLY_HEALTH_SAFETY_TIMER_EXPIRE

// Power supply technology (chemistry) constants
  // ROS constant POWER_SUPPLY_TECHNOLOGY_UNKNOWN = 0; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_UNKNOWN // Unknown battery technology
  // ROS constant POWER_SUPPLY_TECHNOLOGY_NIMH = 1; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_NIMH // Nickel-Metal Hydride battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_LION = 2; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_LION // Lithium-ion battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_LIPO = 3; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_LIPO // Lithium Polymer battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_LIFE = 4; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_LIFE // Lithium Iron Phosphate battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_NICD = 5; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_NICD // Nickel-Cadmium battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_LIMN = 6; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_LIMN // Lithium Manganese Dioxide battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_TERNARY = 7; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_TERNARY // Ternary Lithium battery
  // ROS constant POWER_SUPPLY_TECHNOLOGY_VRLA = 8; package constant BATTERY_STATE_POWER_SUPPLY_TECHNOLOGY_VRLA // Valve Regulated Lead-Acid battery

  header : Header
  voltage : RosVolts // Voltage in Volts (Mandatory)
  temperature : RosCelsius // Temperature in Degrees Celsius (If unmeasured NaN)
  currentValue : RosAmperes // Negative when discharging (A)  (If unmeasured NaN)
  charge : RosAmpereHours // Current charge in Ah  (If unmeasured NaN)
  capacity : RosAmpereHours // Capacity in Ah (last full capacity)  (If unmeasured NaN)
  designCapacity : RosAmpereHours // Capacity in Ah (design capacity)  (If unmeasured NaN)
  percentage : RosFloat32 // Charge percentage on 0 to 1 range  (If unmeasured NaN)
  powerSupplyStatus : RosUInt8 // The charging status as reported. Values defined above
  powerSupplyHealth : RosUInt8 // The battery health metric. Values defined above
  powerSupplyTechnology : RosUInt8 // The battery chemistry. Values defined above
  present : RosBoolean // True if the battery is present

  cellVoltage : [RosFloat32; 0..18446744073709551615] // An array of individual cell voltages for each cell in the pack
                         // If individual voltages unknown but number of cells known set each to NaN
  cellTemperature : [RosFloat32; 0..18446744073709551615] // An array of individual cell temperatures for each cell in the pack
                           // If individual temperatures unknown but number of cells known set each to NaN
  location : RosString // The location into which the battery is inserted. (slot number or plug)
  serialNumber : RosString // The best approximation of the battery serial number
}
const BATTERY_STATE_POWER_SUPPLY_STATUS_UNKNOWN : RosUInt8 = 0
const BATTERY_STATE_POWER_SUPPLY_STATUS_CHARGING : RosUInt8 = 1
const BATTERY_STATE_POWER_SUPPLY_STATUS_DISCHARGING : RosUInt8 = 2
const BATTERY_STATE_POWER_SUPPLY_STATUS_NOT_CHARGING : RosUInt8 = 3
const BATTERY_STATE_POWER_SUPPLY_STATUS_FULL : RosUInt8 = 4
const BATTERY_STATE_POWER_SUPPLY_HEALTH_UNKNOWN : RosUInt8 = 0
