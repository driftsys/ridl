{
  "name": "ridl-vscode",
  "displayName": "RIDL (typl + ridl + rsdl)",
  "description": "Syntax highlighting and a language server client for the RIDL family: typl, the type language, ridl, the interface description language, and rsdl, the system description language.",
  "version": "0.2.0",
  "publisher": "driftsys",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/driftsys/ridl.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ridl.installToPath",
        "title": "Install ridl to PATH",
        "category": "RIDL"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "ridl",
        "label": "RIDL"
      }
    ],
    "languages": [
      {
        "id": "typl",
        "aliases": [
          "typl",
          "RIDL typl"
        ],
        "extensions": [
          ".typl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ridl",
        "aliases": [
          "ridl",
          "RIDL interface description"
        ],
        "extensions": [
          ".ridl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rsdl",
        "aliases": [
          "rsdl",
          "RIDL system description"
        ],
        "extensions": [
          ".rsdl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "typl",
        "scopeName": "source.typl",
        "path": "./syntaxes/typl.tmLanguage.json"
      },
      {
        "language": "ridl",
        "scopeName": "source.ridl",
        "path": "./syntaxes/ridl.tmLanguage.json"
      },
      {
        "language": "rsdl",
        "scopeName": "source.rsdl",
        "path": "./syntaxes/rsdl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "RIDL",
      "properties": {
        "ridl.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ridl binary, which the extension runs as ridl lsp and ridl mcp. Empty (the default) uses the binary bundled in the extension, or ridl found on PATH when none is bundled."
        },
        "ridl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC communication between VS Code and the ridl language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/binaryResolution.test.js out/installToPath.test.js out/contributions.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "3.9.2",
    "ovsx": "0.10.5",
    "typescript": "5.9.2"
  }
}
