{
  "name": "ridl-vscode",
  "displayName": "RIDL (typl + ridl)",
  "description": "Syntax highlighting and a language server client for the RIDL family: typl, the type language, and ridl, the interface description language.",
  "version": "0.0.1",
  "publisher": "driftsys",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/driftsys/ridl.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "typl",
        "aliases": [
          "typl",
          "RIDL typl"
        ],
        "extensions": [
          ".typl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ridl",
        "aliases": [
          "ridl",
          "RIDL interface description"
        ],
        "extensions": [
          ".ridl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "typl",
        "scopeName": "source.typl",
        "path": "./syntaxes/typl.tmLanguage.json"
      },
      {
        "language": "ridl",
        "scopeName": "source.ridl",
        "path": "./syntaxes/ridl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "RIDL",
      "properties": {
        "ridl.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ridl binary, which the extension runs as ridl lsp and ridl mcp. Empty (the default) uses the binary bundled in the extension, or ridl found on PATH when none is bundled."
        },
        "ridl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC communication between VS Code and the ridl language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/binaryResolution.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.2"
  }
}
