root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# MD051 rejects a correct anchor when the heading it points at contains a
# section sign: rumdl keeps the "§" in the slug it computes, while GitHub
# strips it as punctuation, so the link a reader's browser resolves is the one
# the rule reports. See driftsys/prim#180 — remove this block once that is
# fixed upstream, and `prim lint` will check these anchors again.
#
# Scoped to docs/ because that is where the convention lives: four files under
# docs/specification, docs/book and docs/archive carry "§" headings today,
# though only expr-core-specification.md links to one so far. A per-file list
# would need extending the next time somebody adds a table of contents.
[docs/**.md]
prim_mdlint_disable = MD051

[*.{yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab
