[
  {
    "description": "Pass the workspace root as `path` to check its files, with optional unsaved-text overlays. Read-only and offline. Alternatively, type-check one typl, ridl or rsdl source text against the embedded ridl.std. Returns the compiler's coded diagnostics with their spans and fix-its; a lint diagnostic also names its lint. In source mode every lint has its default level. In source mode every span reports the path `input.typl`, `input.ridl` or `input.rsdl`, a fixed synthetic name for the text you supplied rather than a file on disk. In source mode the text is checked as a workspace of one file, so the workspace-wide checks run over it as `ridl check` runs them, the rsdl system checks included. Source mode does not check files beside the input, such as `interfaces.lock` and `.ridl/baseline/`. Path mode checks `interfaces.lock` and reports real source paths. Path mode applies the workspace's `[lints]` levels, so a lint's severity follows ridl.toml and a lint at `allow` is not reported. It omits remote fetching, the `ridl.lock` round trip and baseline checks.",
    "inputSchema": {
      "$defs": {
        "OverlayInput": {
          "properties": {
            "path": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "source"
          ],
          "type": "object"
        },
        "Profile": {
          "description": "Which language a source text is parsed as. These are the three profiles the\ncompiler has; the `.rxdl` form does not exist yet (epic E3.5). An rsdl text\nis checked as a workspace of one file, so the rsdl system checks run over\nit as `ridl check` runs them over the same text in a file. The checks of\nfiles beside a file on disk (an `interfaces.lock`, a `.ridl/baseline/`\nsnapshot) do not run: a source text has no such files.",
          "enum": [
            "typl",
            "ridl",
            "rsdl"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "overlays": {
          "items": {
            "$ref": "#/$defs/OverlayInput"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/Profile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which language `source` is parsed as."
        },
        "source": {
          "description": "The full text of one `.typl`, `.ridl` or `.rsdl` file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "ridl_check",
    "outputSchema": {
      "$defs": {
        "WorkspaceStatus": {
          "properties": {
            "errors": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "root": {
              "type": "string"
            },
            "warnings": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "root",
            "errors",
            "warnings",
            "notes"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "diagnostics": {
          "items": true,
          "type": "array"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "diagnostics"
      ],
      "type": "object"
    }
  },
