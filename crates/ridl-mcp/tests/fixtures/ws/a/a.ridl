package fx.a

/// Vehicle speed in kilometres per hour.
type Speed: km/h [0.0..250.0 step 0.5]

type Level: integer [0..100]

/// The health of a subsystem.
enum Health {
  OK = 0
  WARN = 1
  FAIL = 2
}

struct Reading {
  level: Level
  health: Health
}

union Outcome {
  ok: Reading
  fault: Health
}

internal type PrivateLevel: integer [0..10]

enumset HealthSet: Health

const HEALTH_PATTERN = /^[A-Z]+$/

type HealthCode: string [1..8 match HEALTH_PATTERN] = "OK"
