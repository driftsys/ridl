syntax = "proto3";

package proto.parts;

message Wheel {
  uint32 radius = 1;
}

// strict: a value outside this list is refused by RIDL codecs
enum Grade {
  GRADE_A = 0;
  GRADE_B = 1;
}

message GradeBox {
  Grade value = 1;
}
