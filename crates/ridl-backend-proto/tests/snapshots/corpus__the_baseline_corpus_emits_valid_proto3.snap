---
source: crates/ridl-backend-proto/tests/corpus.rs
expression: generated.proto_source
---
syntax = "proto3";

package corpus.baseline;

message SpeedBox {
  // Speed — km/h [0..250 step 0.5]
  float value = 1;
}

message DoorStateBox {
  // DoorState — [0..1]
  uint32 value = 1;
}

message GearIndexBox {
  // GearIndex — [0..6]
  uint32 value = 1;
}

enum VehicleStatusOrdinal {
  VEHICLE_STATUS_ORDINAL_UNSPECIFIED = 0;
  VEHICLE_STATUS_ORDINAL_CURRENT_SPEED = 1;
  VEHICLE_STATUS_ORDINAL_TYRE_PRESSURE = 2;
  VEHICLE_STATUS_ORDINAL_DOOR_CLOSED = 3;
  VEHICLE_STATUS_ORDINAL_DOOR_OPENED = 4;
  VEHICLE_STATUS_ORDINAL_LEGACY_WHEEL_PHASE = 5;
}

enum CorpusBaselineHvacOrdinal {
  CORPUS_BASELINE_HVAC_ORDINAL_UNSPECIFIED = 0;
  CORPUS_BASELINE_HVAC_ORDINAL_CABIN_TEMP = 1;
  CORPUS_BASELINE_HVAC_ORDINAL_FILTER_CLOGGED = 2;
}
