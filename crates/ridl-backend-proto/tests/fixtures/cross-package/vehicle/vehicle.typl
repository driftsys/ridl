package proto.vehicle

import proto.parts.Wheel
import proto.parts.Grade

// Both fields reference a foreign declaration that becomes a message or an
// enum of its own — the case a named scalar or an enum set never reaches
// (design §3.1, §3.2) — so this struct is what makes `import "proto.parts.proto";`
// appear in the emitted schema.
struct Axle {
  wheel : Wheel
  grade : Grade
}
