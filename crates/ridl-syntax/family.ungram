// family.ungram — the typl profile grammar as a rowan tree shape.
//
// Transliterated from the typl language reference, Appendix E (EBNF), per
// ADR-0007 decision 1. This file describes the shape of the syntax tree,
// not the parser: it is the node-inventory SSOT for the generated typed
// AST. `cargo xtask codegen` reads it and writes
// crates/ridl-syntax/src/ast/generated.rs; a drift test in xtask fails
// when the committed file and this grammar diverge.
//
// Conventions (see xtask/src/codegen.rs for the exact rules):
//
// - `SomeRule = ...` names a CST node; the generator emits a struct named
//   exactly after the rule, cast from the same-named SyntaxKind variant.
// - `'token'` names a token; the mapping from token names to SyntaxKind
//   variants lives in xtask/src/codegen.rs.
// - A rule that is a pure alternation of other nodes (Definition, Backing,
//   StructMember, FieldType) generates no struct — src/ast.rs defines it
//   as a hand-written enum over the alternatives.
// - `label:Rule` renames the generated accessor.
// - Doc comments are trivia tokens and never appear in the tree shape
//   (typl reference §14): consumers read them from the trivia immediately
//   preceding a definition (ast::HasDocComments).
// - `ErrorNode` is the one node kind with no rule here: error recovery
//   (task E1.2c) wraps arbitrary skipped tokens in it, so it has no
//   describable shape. The generator appends its struct unconditionally.
//
// Separator discipline (typl reference §15.2): newline and comma are
// interchangeable inside every block construct, and a trailing comma is
// permitted. Newlines are trivia; separator commas are real tokens, and
// the parser places them as direct children of the block node, between
// members — the `','?` in each member repetition below admits them. The
// parser owns the separator checks.

// ---------- Top level ----------

SourceFile =
  PackageDecl?
  imports:Import*
  definitions:Definition*
  interfaces:InterfaceDef*

PackageDecl =
  'package' QualifiedName

// No wildcards, no relative paths, no re-exports — ADR-0002.
Import =
  'import' QualifiedName ('as' alias:Name)?

// 'error' is valid on struct, enum, and union definitions only (typl
// reference §10.1); the parser accepts it everywhere and the checker
// rejects the rest, so every alternative carries both modifiers.
Definition =
  TypeDef
| ConstDef
| StructDef
| EnumDef
| EnumSetDef
| UnionDef

// ---------- Type ----------

TypeDef =
  'internal'? 'error'? 'type' Name ':' Backing Constraint? InitValue?

Backing =
  PrimitiveType
| UnitExpr

// The optional constraint covers the inline constrained-primitive field
// type (`integer [0..250]`, typl reference §15.3). In a `type` definition
// the constraint is a direct child of TypeDef instead.
PrimitiveType =
  ('boolean' | 'integer' | 'float' | 'string' | 'bytes') Constraint?

// A UCUM unit expression, spelled with the family tokens: `km/h`, `N.m`,
// `/min`, `%`, `m/s2` (typl reference §5.1). Semantic validation of the
// expression is the ucum module's job (TYPL-110), not the grammar's.
UnitExpr =
  ('ident' | '/' | '.' | '%')*

// Declared init value, bare literal — typl reference §5.8.
InitValue =
  '=' Literal

// The constraint clause (typl reference §5.2–§5.5). Three shapes share
// the brackets: a scalar range with optional step, a length bound with
// optional match, and a bare match. Scalar endpoints are direct Literal
// children told apart by the anchor tokens ('..', 'step', 'match'), so
// their accessors are hand-written in src/ast.rs; length bounds nest in
// a Bound node.
Constraint =
  '[' (
      min:Literal? '..' max:Literal? ('step' step:Literal)?
    | len:Bound ('match' match_pattern:Literal)?
    | 'match' match_pattern:Literal
  ) ']'

// A collection or length bound: an exact count or an inclusive range
// (typl reference §12.3, §5.3).
Bound =
  min:Literal ('..' max:Literal)?

// ---------- Constants ----------

// The value of a regex constant (typl reference §6.2) is a Literal
// wrapping a 'regex' token; ConstDef::regex() in src/ast.rs extracts it.
ConstDef =
  'internal'? 'error'? 'const' Name (':' type_ref:PathType)? '=' value:Literal

// ---------- Struct ----------

StructDef =
  'internal'? 'error'? 'struct' Name '{' (members:StructMember ','?)* '}'

StructMember =
  FieldDef
| ReservedEntry

FieldDef =
  Name ':' FieldType InitValue?

// Tombstone — typl reference §7.4: name form for structs and unions,
// integer form for enums.
ReservedEntry =
  'reserved' (Name | Literal)

FieldType =
  PathType
| PrimitiveType
| TupleType
| ArrayType
| MapType
| OptionalType

OptionalType =
  FieldType '?'

ArrayType =
  '[' element:FieldType ';' Bound ']'

MapType =
  '[' key:FieldType ':' value:FieldType ';' Bound ']'

// Appendix E requires at least one field, but typl reference §11 names the
// empty tuple `()` as the unit type — the parser follows §11 and admits a
// tuple with zero fields; the ok corpus freezes that shape.
TupleType =
  '(' fields:TupleField (',' fields:TupleField)* ')'

TupleField =
  Name ':' FieldType

// ---------- Enum ----------

EnumDef =
  'internal'? 'error'? 'enum' Name '{' ((values:EnumValue | reserved:ReservedEntry) ','?)* '}'

EnumValue =
  Name '=' value:Literal

// ---------- EnumSet ----------

// Standalone form and derived form (typl reference §9.1–§9.2).
EnumSetDef =
  'internal'? 'error'? 'enumset' Name '{' (bits:EnumSetBit ','?)* '}'
| 'internal'? 'error'? 'enumset' Name ':' backing_ref:PathType

EnumSetBit =
  Name '=' value:Literal

// ---------- Union ----------

UnionDef =
  'internal'? 'error'? 'union' Name '{' ((arms:UnionArm | reserved:ReservedEntry) ','?)* '}'

UnionArm =
  Name ':' type_ref:PathType

// ---------- ridl interactions ----------
//
// Transliterated from the ridl language reference, Appendix C, with the two
// decided supersessions baked in (ADR-0008 decisions 1 and 2): the return
// type gains `fallible_type = type_ref "|" type_ref` (general form §6.1),
// and a signal's bare `= value` init comes before its timing annotation.
//
// The parser is deliberately more lenient than the reference — the checker
// narrows (RIDL-1xx/2xx/3xx, E2 task 5): a `: return_type` after a
// command's params parses; timing parses on command, query, and final;
// an attr block parses on signal, event, and final; an init value parses
// on event and final. The rules below name a child only where the typed
// AST exposes an accessor for it; the extra lenient children (an attr
// block on a signal or event, an init value on an event or final) still
// land inside the definition node and are reached through the CST.

InterfaceDef =
  'internal'? 'error'? 'interface' Name '{' (members:InterfaceMember ','?)* '}'

InterfaceMember =
  SignalDef
| EventDef
| CommandDef
| QueryDef
| FinalDef
| ReservedEntry

SignalDef =
  'signal' Name ':' payload:FieldType InitValue? Timing?

EventDef =
  'event' Name ':' payload:FieldType Timing?

CommandDef =
  'command' Name params:ParamList (':' return_type:ReturnType)? AttrBlock? Timing?

QueryDef =
  'query' Name params:ParamList ':' return_type:ReturnType AttrBlock? Timing?

FinalDef =
  'final' Name ':' payload:FieldType Timing? AttrBlock?

ParamList =
  '(' (params:Param ','?)* ')'

Param =
  Name ':' param_type:ParamType

ParamType =
  FieldType
| StreamType

// The four return shapes (ridl reference §7.1, general form §6.1). The
// labels force a struct with one accessor per shape instead of an enum —
// the checker asks "which shape" through the four `Option`s.
ReturnType =
  type_ref:PathType
| tuple_type:TupleType
| stream_type:StreamType
| fallible_type:FallibleType

// `ok | err` — both arms are named types (general form §6.1); the
// accessors are positional (first and second `PathType` child).
FallibleType =
  ok:PathType '|' err:PathType

// The stream container `<T>` (ridl reference §12): a named element type,
// or raw `string`/`bytes` held as a bare token child
// (`StreamType::element_primitive()` in src/ast.rs).
StreamType =
  '<' (element_type:PathType | 'string' | 'bytes') '>'

// `@10ms` (strict periodic) or `@[min..max]` (range) — ridl reference §9.
// `Timing::duration()`, `TimingRange::min()`, and `TimingRange::max()` are
// hand-written in src/ast.rs: the range endpoints are both `duration`
// tokens told apart by the `..` anchor.
Timing =
  '@' ('duration' | '[' range:TimingRange ']')

TimingRange =
  min:'duration'? '..' max:'duration'?

// ---------- Attributes (general form §4.2–§4.3, E2 task 4) ----------
//
// The single attr_block production: three forms — a flag key, an
// assignment `key = const_value`, and a predicate `require|ensure expr`.
// gf §4.2 requires at least one attribute per block; the parser accepts
// an empty `[]` losslessly and reports FORM-101 at the closing bracket.
// Which keys are legal on which declaration kind is a semantic allow-list
// (gf §4.3, FORM-106/107/108) — checker scope, E2 task 5.

AttrBlock =
  '[' (attributes:Attribute ','?)* ']'

Attribute =
  key:Name
| key:Name '=' value:AttrValue
| ('require' | 'ensure') expr:Expr

// `const_value` (gf §4.2): a literal or a SCREAMING_SNAKE constant
// reference (both are one `Literal` child — `ident` is a value token
// there), or a parenthesised list of nested values.
AttrValue =
  Literal
| '(' (values:AttrValue ','?)* ')'

// ---------- The guaranteed-subset expr grammar (E2.4) ----------
//
// The expr-core specification §3.1 productions (ridl reference §13,
// ADR-0008 decision 10), collapsed to their tree shapes: the
// precedence-climbing parser produces exactly these six node kinds.
// Inside an expr `<` is always the comparison operator — the stream-type
// reading exists only in param-type and return-type position; the two
// positions never overlap.

Expr =
  BinaryExpr
| PrefixExpr
| MemberExpr
| PathExpr
| ParenExpr
| LiteralExpr

// One binary step of or/and/cmp/add/mul. Precedence and associativity
// live in the parser: a comparison never chains (`a < b < c` is a parse
// error), the other levels are left-associative.
BinaryExpr =
  lhs:Expr
  ('||' | '&&' | '==' | '!=' | '<' | '<=' | '>' | '>=' | '+' | '-' | '*' | '/' | '%')
  rhs:Expr

// `unary_expr = [ "!" | "-" ] postfix_expr` — at most one prefix.
PrefixExpr =
  ('!' | '-') operand:Expr

// One `.member` postfix step: a tuple field (camelCase) or an enum
// member (SCREAMING_SNAKE) — both are `ident` tokens.
MemberExpr =
  base:Expr '.' 'ident'

// `path_head` — a parameter, `result`, a constant, or a type name.
PathExpr =
  'ident'

ParenExpr =
  '(' inner:Expr ')'

// A literal or duration operand. The unary minus of a negative number is
// a PrefixExpr here, never part of the literal token.
LiteralExpr =
  'int_number' | 'float_number' | 'string_lit' | 'true' | 'false' | 'duration'

// ---------- Names and literals ----------

// A declared name: the single identifier a definition, field, value,
// bit, or arm introduces.
Name =
  'ident'

// A reference path: `Type` or `pkg.Type` for types, `veh.common` for
// packages and imports. A segment may also be one of the five primitive
// keywords, so `const MAX_GEAR : integer = 6` (typl reference Appendix B)
// parses; the checker narrows where a primitive is not allowed. Because a
// segment is not always an 'ident' token, consumers must read the path
// text (concatenate the non-trivia tokens, as ridl-core's
// `significant_text` does), never `ident_token()` — that accessor returns
// only the first plain-identifier segment.
QualifiedName =
  ('ident' | 'boolean' | 'integer' | 'float' | 'string' | 'bytes')
  ('.' ('ident' | 'boolean' | 'integer' | 'float' | 'string' | 'bytes'))*

// A type reference in type position (field types, union arms, const
// types, enumset backing).
PathType =
  QualifiedName

// One literal value token, with the optional unary minus of a negative
// number (the lexer emits '-' separately, typl reference §2.4). An
// 'ident' here is a SCREAMING_SNAKE constant reference in a value
// position — a scalar bound or a match pattern (Appendix E `scalar` and
// `pattern`).
Literal =
  '-'? ('int_number' | 'float_number' | 'string_lit' | 'true' | 'false' | 'regex' | 'ident')
