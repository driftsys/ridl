static inline const uint8_t *pod_parts_hub_size_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 0, 8) ? h + 0 : NULL;
}

static inline const uint8_t *pod_parts_hub_size(const uint8_t *buf) {
