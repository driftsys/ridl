static inline uint8_t pod_parts_sparse_o6(const uint8_t *buf) {
  return pod_parts_sparse_o6_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline int pod_parts_sparse_has_o6_at(const uint8_t *h, uint32_t sz) {
  return (int)((ridl_podbuf_load(h, sz, 0, 1) >> 5) & 1u);
}

