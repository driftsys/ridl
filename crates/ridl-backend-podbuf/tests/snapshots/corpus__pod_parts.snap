}

static inline const uint8_t *pod_parts_tyre_flat_arm_size_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 0, 8) ? h + 0 : NULL;
}

static inline const char *pod_parts_tyre_flat_arm_label_at(const uint8_t *buf, const uint8_t *h, uint32_t sz, uint32_t *len) {
  ridl_podbuf_desc d = ridl_podbuf_desc_at(h, sz, 8);
  *len = d.len;
  return d.len ? (const char *)(buf + d.off) : NULL;
}

