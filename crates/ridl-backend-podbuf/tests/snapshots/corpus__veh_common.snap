_Static_assert(sizeof(((veh_common_driver_profile_head *)0)->name) == 8, "veh_common_driver_profile_head.name size");
_Static_assert(offsetof(veh_common_driver_profile_head, speed) == 8, "veh_common_driver_profile_head.speed offset");
_Static_assert(sizeof(((veh_common_driver_profile_head *)0)->speed) == 4, "veh_common_driver_profile_head.speed size");
_Static_assert(offsetof(veh_common_driver_profile_head, _flags0) == 12, "veh_common_driver_profile_head._flags0 offset");
_Static_assert(sizeof(((veh_common_driver_profile_head *)0)->_flags0) == 1, "veh_common_driver_profile_head._flags0 size");
