_Static_assert(sizeof(((veh_common_driver_profile_head *)0)->gears) == 1, "veh_common_driver_profile_head.gears size");
_Static_assert(offsetof(veh_common_driver_profile_head, override) == 16, "veh_common_driver_profile_head.override offset");
_Static_assert(sizeof(((veh_common_driver_profile_head *)0)->override) == 4, "veh_common_driver_profile_head.override size");
#endif

