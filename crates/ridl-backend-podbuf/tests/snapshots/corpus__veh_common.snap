static inline float veh_common_speed_limit_payload_limit(const uint8_t *buf) {
  return ridl_podbuf_load_f32(buf, 0);
}
static inline float veh_common_speed_limit_payload_actual(const uint8_t *buf) {
  return ridl_podbuf_load_f32(buf, 4);
}
static inline const char *veh_common_driver_profile_name(const uint8_t *buf, uint32_t *len) {
  ridl_podbuf_desc d = ridl_podbuf_desc_at(buf, 0);
  *len = d.len;
  return d.len ? (const char *)(buf + d.off) : NULL;
}
static inline float veh_common_driver_profile_speed(const uint8_t *buf) {
  return ridl_podbuf_load_f32(buf, 8);
}
static inline uint8_t veh_common_driver_profile_gears(const uint8_t *buf) {
  return (uint8_t)ridl_podbuf_load(buf, 13, 1);
}
static inline float veh_common_driver_profile_override(const uint8_t *buf) {
  return ridl_podbuf_load_f32(buf, 16);
}
static inline int veh_common_driver_profile_has_override(const uint8_t *buf) {
  return (int)((ridl_podbuf_load(buf, 12, 1) >> 0) & 1u);
}

static inline const veh_common_sensor_bounds_range_head *veh_common_sensor_bounds_range(const uint8_t *buf) {
  return ridl_podbuf_fits(buf, 0, 8)
    ? (const veh_common_sensor_bounds_range_head *)(buf + RIDL_PODBUF_PREAMBLE_SIZE + 0) : NULL;
}
static inline const float *veh_common_sensor_bounds_readings(const uint8_t *buf) {
  return ridl_podbuf_fits(buf, 8, 32)
    ? (const float *)(buf + RIDL_PODBUF_PREAMBLE_SIZE + 8) : NULL;
}
static inline const uint8_t *veh_common_sensor_bounds_labels(const uint8_t *buf, uint16_t *count, uint16_t *elem_size) {
  ridl_podbuf_array_desc d = ridl_podbuf_array_desc_at(buf, 40);
  *count = d.len;
  *elem_size = d.elem_size;
  return d.len ? buf + d.off : NULL;
}
static inline const uint8_t *veh_common_sensor_bounds_meta(const uint8_t *buf, uint16_t *count, uint16_t *elem_size) {
  ridl_podbuf_array_desc d = ridl_podbuf_array_desc_at(buf, 48);
  *count = d.len;
  *elem_size = d.elem_size;
  return d.len ? buf + d.off : NULL;
}
static inline uint8_t veh_common_sensor_result_tag(const uint8_t *buf) {
  return (uint8_t)ridl_podbuf_load(buf, 0, 1);
}
static inline const uint8_t *veh_common_sensor_result_arm(const uint8_t *buf, uint32_t *len) {
  ridl_podbuf_desc d = ridl_podbuf_desc_at(buf, 4);
  *len = d.len;
  return d.len ? buf + d.off : NULL;
}
static inline float veh_common_sensor_reading_value(const uint8_t *buf) {
  return ridl_podbuf_load_f32(buf, 0);
}
static inline uint64_t veh_common_sensor_reading_timestamp(const uint8_t *buf) {
  return (uint64_t)ridl_podbuf_load(buf, 8, 8);
}
static inline uint16_t veh_common_sensor_fault_code(const uint8_t *buf) {
  return (uint16_t)ridl_podbuf_load(buf, 0, 2);
}
static inline const char *veh_common_sensor_fault_message(const uint8_t *buf, uint32_t *len) {
  ridl_podbuf_desc d = ridl_podbuf_desc_at(buf, 4);
  *len = d.len;
  return d.len ? (const char *)(buf + d.off) : NULL;
}
static inline uint16_t veh_common_raw_wheel_frame_ticks(const uint8_t *buf) {
  return (uint16_t)ridl_podbuf_load(buf, 0, 2);
}
static inline const uint8_t *veh_common_raw_wheel_frame_frame(const uint8_t *buf) {
  return ridl_podbuf_fits(buf, 2, 8)
    ? (const uint8_t *)(buf + RIDL_PODBUF_PREAMBLE_SIZE + 2) : NULL;
}
#endif /* RIDL_PODBUF_VEH_COMMON_H */
