#ifndef RIDL_PODBUF_VEH_COMMON_H
#define RIDL_PODBUF_VEH_COMMON_H

#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
#error "podbuf requires a little-endian target"
#endif

#include <stddef.h>
#include <stdint.h>

#ifndef RIDL_PODBUF_PREAMBLE_DEFINED
#define RIDL_PODBUF_PREAMBLE_DEFINED

#define RIDL_PODBUF_PREAMBLE_SIZE 8

/* The first 8 bytes of every buffer. */
typedef struct ridl_podbuf_preamble {
  uint32_t head_size;
  uint32_t reserved;
} ridl_podbuf_preamble;
_Static_assert(sizeof(ridl_podbuf_preamble) == 8, "ridl_podbuf_preamble size");

/* A string, bytes or union arm: `off` counts from the buffer start. */
typedef struct ridl_podbuf_desc {
  uint32_t off;
  uint32_t len;
} ridl_podbuf_desc;
_Static_assert(sizeof(ridl_podbuf_desc) == 8, "ridl_podbuf_desc size");
_Static_assert(_Alignof(ridl_podbuf_desc) == 4, "ridl_podbuf_desc alignment");

/* An array or map: `len` counts elements, `elem_size` is the stride. */
typedef struct ridl_podbuf_array_desc {
  uint32_t off;
  uint16_t len;
  uint16_t elem_size;
} ridl_podbuf_array_desc;
_Static_assert(sizeof(ridl_podbuf_array_desc) == 8, "ridl_podbuf_array_desc size");
_Static_assert(_Alignof(ridl_podbuf_array_desc) == 4, "ridl_podbuf_array_desc alignment");

/* The head size the producer wrote. */
static inline uint32_t ridl_podbuf_head_size(const uint8_t *buf) {
  return (uint32_t)buf[0] | ((uint32_t)buf[1] << 8) | ((uint32_t)buf[2] << 16) |
         ((uint32_t)buf[3] << 24);
}

/* Whether `size` bytes at head offset `off` lie inside the producer's head. */
static inline int ridl_podbuf_fits(const uint8_t *buf, uint32_t off, uint32_t size) {
  return (uint64_t)off + size <= ridl_podbuf_head_size(buf);
}

/* A little-endian unsigned load from the head; 0 past the producer's head. */
static inline uint64_t ridl_podbuf_load(const uint8_t *buf, uint32_t off, uint32_t size) {
  uint64_t value = 0;
  uint32_t i;
  if (!ridl_podbuf_fits(buf, off, size)) {
    return 0;
  }
  for (i = size; i > 0; i--) {
    value = (value << 8) | buf[RIDL_PODBUF_PREAMBLE_SIZE + off + i - 1];
  }
  return value;
}

static inline float ridl_podbuf_load_f32(const uint8_t *buf, uint32_t off) {
  union {
    uint32_t bits;
    float value;
  } pun;
  pun.bits = (uint32_t)ridl_podbuf_load(buf, off, 4);
  return pun.value;
}

static inline double ridl_podbuf_load_f64(const uint8_t *buf, uint32_t off) {
  union {
    uint64_t bits;
    double value;
  } pun;
  pun.bits = ridl_podbuf_load(buf, off, 8);
  return pun.value;
}

static inline ridl_podbuf_desc ridl_podbuf_desc_at(const uint8_t *buf, uint32_t off) {
  ridl_podbuf_desc d;
  d.off = (uint32_t)ridl_podbuf_load(buf, off, 4);
  d.len = (uint32_t)ridl_podbuf_load(buf, off + 4, 4);
  return d;
}

static inline ridl_podbuf_array_desc ridl_podbuf_array_desc_at(const uint8_t *buf, uint32_t off) {
  ridl_podbuf_array_desc d;
  d.off = (uint32_t)ridl_podbuf_load(buf, off, 4);
  d.len = (uint16_t)ridl_podbuf_load(buf, off + 4, 2);
  d.elem_size = (uint16_t)ridl_podbuf_load(buf, off + 6, 2);
  return d;
}

#endif

