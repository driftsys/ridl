static inline uint8_t veh_cluster_door_payload_sensor_id_at(const uint8_t *h, uint32_t sz) {
  return (uint8_t)ridl_podbuf_load(h, sz, 0, 1);
}

static inline uint8_t veh_cluster_door_payload_sensor_id(const uint8_t *buf) {
  return veh_cluster_door_payload_sensor_id_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline uint8_t veh_cluster_door_payload_is_open_at(const uint8_t *h, uint32_t sz) {
  return (uint8_t)ridl_podbuf_load(h, sz, 1, 1);
}

static inline uint8_t veh_cluster_door_payload_is_open(const uint8_t *buf) {
