_Static_assert(offsetof(pod_vehicle_axle_head, clash) == 56, "pod_vehicle_axle_head.clash offset");
_Static_assert(sizeof(((pod_vehicle_axle_head *)0)->clash) == 24, "pod_vehicle_axle_head.clash size");

static inline uint8_t pod_vehicle_axle_note_at(const uint8_t *h, uint32_t sz) {
  return (uint8_t)ridl_podbuf_load(h, sz, 0, 1);
}

static inline uint8_t pod_vehicle_axle_note(const uint8_t *buf) {
  return pod_vehicle_axle_note_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline const uint8_t *pod_vehicle_axle_wheel_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 8, 8) ? h + 8 : NULL;
}

static inline const uint8_t *pod_vehicle_axle_wheel(const uint8_t *buf) {
  return pod_vehicle_axle_wheel_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline const uint8_t *pod_vehicle_axle_hub_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 16, 16) ? h + 16 : NULL;
}

static inline const uint8_t *pod_vehicle_axle_hub(const uint8_t *buf) {
  return pod_vehicle_axle_hub_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline const uint8_t *pod_vehicle_axle_tyre_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 32, 16) ? h + 32 : NULL;
}

static inline const uint8_t *pod_vehicle_axle_tyre(const uint8_t *buf) {
  return pod_vehicle_axle_tyre_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline const uint8_t *pod_vehicle_axle_gauge_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 48, 8) ? h + 48 : NULL;
}

static inline const uint8_t *pod_vehicle_axle_gauge(const uint8_t *buf) {
  return pod_vehicle_axle_gauge_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

static inline const uint8_t *pod_vehicle_axle_clash_at(const uint8_t *h, uint32_t sz) {
  return ridl_podbuf_fits(sz, 56, 24) ? h + 56 : NULL;
}

static inline const uint8_t *pod_vehicle_axle_clash(const uint8_t *buf) {
  return pod_vehicle_axle_clash_at(buf + RIDL_PODBUF_PREAMBLE_SIZE, ridl_podbuf_head_size(buf));
}

#endif /* RIDL_PODBUF_POD_VEHICLE_H */
