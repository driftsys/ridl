package pod.parts

// A struct, a union and a struct that holds a tuple: the three kinds of head
// that another package lays out inline.

struct Wheel {
  radius : integer [0..100]
  grip   : integer [0..1000000]
}

// `size` holds a tuple at a tuple position and `grid` a tuple as the element
// of a fixed-count array: each is a head of its own, defined in both headers.
// `items` holds a tuple as the element of a variable-count array: its head is
// a tail head, which only the declaring header defines.
struct Hub {
  size  : (width: integer [0..10], height: integer [0..10], inner: (p: integer [0..10], q: integer [0..10]))
  label : string [0..16]
  items : [(left: integer [0..10], right: integer [0..10]); 0..4]
  grid  : [(top: integer [0..10], bottom: integer [0..10]); 2]
}

// Two positions whose induced Rust names are one (`ABC`), of one shape: the
// declaring package gives them one entry, under the wire name of the first
// reached (`A.bC`), and an importing package that reaches `A` before `AB`
// names that same head for both. (`A` and `AB` are the shortest pair whose
// C accessor names stay apart: `a_b_c_at` and `ab_c_at`.)
struct A {
  bC : (x: integer [0..10], y: integer [0..10])
}

struct AB {
  c : (x: integer [0..10], y: integer [0..10])
}

// A tuple as the key and as the value of a map: the entry head and both
// tuple heads are tail heads, which only the declaring header defines.
struct Table {
  byPair : [(k1: integer [0..10], k2: integer [0..10]) : (v1: integer [0..10], v2: integer [0..10]); 0..4]
}

// Two tuples of one shape at two members: each member has its own head.
struct Pair {
  a : (x: integer [0..10], y: integer [0..10])
  b : (x: integer [0..10], y: integer [0..10])
}

union Tyre {
  slick : Wheel
  flat  : Hub
}

// A union whose arm is a union: the tuples of `Hub` are reached through two
// arm heads, and each names the tuple's own head.
union Mount {
  tyre  : Tyre
  wheel : Wheel
}

// A signed field, and a field that a producer of an older type leaves out.
struct Reading {
  delta : integer [-30000..30000]
  extra : integer [0..9223372036854775807]
}

struct Bag {
  items : [Reading; 0..4]
}

// Nine optional fields: the flags byte at 0 holds the bits of the first
// eight, a second flags byte at 9 holds the bit of the ninth.
struct Sparse {
  o1 : integer [0..255]?
  o2 : integer [0..255]?
  o3 : integer [0..255]?
  o4 : integer [0..255]?
  o5 : integer [0..255]?
  o6 : integer [0..255]?
  o7 : integer [0..255]?
  o8 : integer [0..255]?
  o9 : integer [0..255]?
}

// A tuple with a camelCase member and a member whose name C reserves.
struct Gauge {
  span : (lowMark: integer [0..255], int: integer [0..255])
}

// Two tuples whose spelled C names clash — two members equal under
// snake_case, and a member equal to the presence test of an optional member —
// next to one that does not.
struct Clash {
  pair     : (minSpeed: integer [0..255], min_speed: integer [0..255])
  presence : (x: integer [0..255]?, hasX: integer [0..255])
  trim     : (int: integer [0..255]?, hasInt: integer [0..255])
  plain    : (x: integer [0..255], hasX: integer [0..255])
  clear    : (left: integer [0..255], right: integer [0..255])
}
