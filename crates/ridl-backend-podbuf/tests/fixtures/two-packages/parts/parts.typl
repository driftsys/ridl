package pod.parts

// A struct, a union and a struct that holds a tuple: the three kinds of head
// that another package lays out inline.

struct Wheel {
  radius : integer [0..100]
  grip   : integer [0..1000000]
}

// `size` holds a tuple at a tuple position and `items` a tuple as an array
// element: each is a head of its own in both headers.
struct Hub {
  size  : (width: integer [0..10], height: integer [0..10], inner: (p: integer [0..10], q: integer [0..10]))
  label : string [0..16]
  items : [(left: integer [0..10], right: integer [0..10]); 0..4]
}

// Two tuples of one shape at two members: each member has its own head.
struct Pair {
  a : (x: integer [0..10], y: integer [0..10])
  b : (x: integer [0..10], y: integer [0..10])
}

union Tyre {
  slick : Wheel
  flat  : Hub
}

// A union whose arm is a union: the tuples of `Hub` are reached through two
// arm heads, and each names the tuple's own head.
union Mount {
  tyre  : Tyre
  wheel : Wheel
}

// A signed field, and a field that a producer of an older type leaves out.
struct Reading {
  delta : integer [-30000..30000]
  extra : integer [0..9223372036854775807]
}

struct Bag {
  items : [Reading; 0..4]
}

// Nine optional fields: the flags byte at 0 holds the bits of the first
// eight, a second flags byte at 9 holds the bit of the ninth.
struct Sparse {
  o1 : integer [0..255]?
  o2 : integer [0..255]?
  o3 : integer [0..255]?
  o4 : integer [0..255]?
  o5 : integer [0..255]?
  o6 : integer [0..255]?
  o7 : integer [0..255]?
  o8 : integer [0..255]?
  o9 : integer [0..255]?
}

// A tuple with a camelCase member and a member whose name C reserves.
struct Gauge {
  span : (lowMark: integer [0..255], int: integer [0..255])
}

// Two tuples whose spelled C names clash — two members equal under
// snake_case, and a member equal to the presence test of an optional member —
// next to one that does not.
struct Clash {
  pair     : (minSpeed: integer [0..255], min_speed: integer [0..255])
  presence : (x: integer [0..255]?, hasX: integer [0..255])
  trim     : (int: integer [0..255]?, hasInt: integer [0..255])
  plain    : (x: integer [0..255], hasX: integer [0..255])
  clear    : (left: integer [0..255], right: integer [0..255])
}
