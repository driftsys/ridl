package pod.parts

// A struct, a union and a struct that holds a tuple: the three kinds of head
// that another package lays out inline.

struct Wheel {
  radius : integer [0..100]
  grip   : integer [0..1000000]
}

struct Hub {
  size  : (width: integer [0..10], height: integer [0..10])
  label : string [0..16]
}

union Tyre {
  slick : Wheel
  flat  : Hub
}

// A signed field, and a field that a producer of an older type leaves out.
struct Reading {
  delta : integer [-30000..30000]
  extra : integer [0..9223372036854775807]
}

struct Bag {
  items : [Reading; 0..4]
}

// Nine optional fields: the flags byte at 0 holds the bits of the first
// eight, a second flags byte at 9 holds the bit of the ninth.
struct Sparse {
  o1 : integer [0..255]?
  o2 : integer [0..255]?
  o3 : integer [0..255]?
  o4 : integer [0..255]?
  o5 : integer [0..255]?
  o6 : integer [0..255]?
  o7 : integer [0..255]?
  o8 : integer [0..255]?
  o9 : integer [0..255]?
}
