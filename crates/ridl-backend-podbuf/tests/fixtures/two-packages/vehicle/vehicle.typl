package pod.vehicle

import pod.parts.Wheel
import pod.parts.Hub
import pod.parts.Tyre
import pod.parts.Gauge
import pod.parts.Clash
import pod.parts.Pair
import pod.parts.Mount

struct Axle {
  note  : integer [0..255]
  wheel : Wheel
  hub   : Hub
  tyre  : Tyre
  gauge : Gauge
  clash : Clash
  pair  : Pair
  mount : Mount
  // The shape of `Pair.a`, local to this package: no foreign head uses it.
  own   : (x: integer [0..10], y: integer [0..10])
}
