package veh.topology

component Cruise [ instances = (primary, backup) ] {
  offers veh.adas.AdaptiveCruise
  requires LaneAssist
}

component Lane {
  offers veh.adas.LaneKeeping
}

component Panel {
  requires CruiseControl
  requires LaneAssist
}

component Backend [ external ] {
  requires CruiseControl
}
