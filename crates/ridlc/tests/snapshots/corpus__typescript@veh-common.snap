}

export function initRatio(): Ratio {
  return 0.0 as Ratio;
}

/**
 * Build a value with `makeCounter`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 65535
 *
 * @range [0..65535]
 */
export type Counter = number & { readonly __ridl: 'veh.common.Counter' };

/** Builds a `Counter`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeCounter(value: number): Counter {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new ConstraintError('range', 'veh.common.Counter', value, 'a safe integer');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'veh.common.Counter', value, '[0..65535]');
  }
  if (value > 65535) {
    throw new ConstraintError('range', 'veh.common.Counter', value, '[0..65535]');
  }
  return value as Counter;
}

/** Builds a `Counter` without checking a value already known to satisfy its constraints. */
export function makeCounterUnchecked(value: number): Counter {
  return value as Counter;
}

export function initCounter(): Counter {
  return 0 as Counter;
}

/**
 * Build a value with `makeGain`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 1
 * - step 0.01
 *
 * @range [0..1 step 0.01]
 */
export type Gain = number & { readonly __ridl: 'veh.common.Gain' };

/** Builds a `Gain`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeGain(value: number): Gain {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'veh.common.Gain', value, '[0..1]');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'veh.common.Gain', value, '[0..1]');
  }
  if (value > 1) {
    throw new ConstraintError('range', 'veh.common.Gain', value, '[0..1]');
  }
  return value as Gain;
}

/** Builds a `Gain` without checking a value already known to satisfy its constraints. */
export function makeGainUnchecked(value: number): Gain {
  return value as Gain;
}

export function initGain(): Gain {
  return 0.0 as Gain;
}

export const MAX_SPEED = 250.0;

export const SPEED_LIMIT_EU = 130.0;

export const MAX_GEAR = 6;

export const IDLE_RPM = 800.0;

export enum GearPosition {
  PARK = 0,
  DRIVE = 1,
  REVERSE = 2,
  NEUTRAL = 3,
}

export function initGearPosition(): GearPosition {
  return GearPosition.PARK;
}

export enum Warning {
  LOW_FUEL = 0,
  CHECK_ENGINE = 1,
  DOOR_OPEN = 2,
  SEATBELT = 3,
}

export function initWarning(): Warning {
  return Warning.LOW_FUEL;
}

export type WarningFlags = number & { readonly __ridl: 'veh.common.WarningFlags' };

export const WarningFlagsBits = {
  LOW_FUEL: 1,
  CHECK_ENGINE: 2,
  DOOR_OPEN: 4,
  SEATBELT: 8,
} as const;

export function initWarningFlags(): WarningFlags {
  return 0 as WarningFlags;
}

export interface SpeedLimitPayload {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 250
   * - step 0.5
   * - unit km/h
   */
  limit: Speed;
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 250
   * - step 0.5
   * - unit km/h
   */
  actual: Speed;
}

export function initSpeedLimitPayload(): SpeedLimitPayload {
  return {
    limit: initSpeed(),
    actual: initSpeed(),
  };
}

export interface DriverProfile {
  name: ridl_std.Name;
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 250
   * - step 0.5
   * - unit km/h
   */
  speed: Speed;
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 250
   * - step 0.5
   * - unit km/h
   */
  override?: Speed;
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 6
   *
   * @range [0..6]
   */
  gears: number;
}

export interface SensorBounds {
  range: { min: Speed; max: Speed };
  /**
   * @remarks
   * Rules:
   * - count 8
   *
   * @bounds 8
   */
  readings: readonly Speed[];
  /**
   * @remarks
   * Rules:
   * - count 1 ..= 16
   *
   * @bounds 1..16
   */
  labels: readonly ridl_std.Label[];
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 32
   *
   * @bounds 0..32
   */
  meta: ReadonlyArray<readonly [ridl_std.Label, ridl_std.Name]>;
}

export type SensorResult =
  | { kind: 'ok'; value: SensorReading }
  | { kind: 'err'; value: SensorFault };

export function initSensorResult(): SensorResult {
  return { kind: 'ok', value: initSensorReading() };
}

export interface SensorReading {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 250
   * - step 0.5
   * - unit km/h
   */
  value: Speed;
  timestamp: ridl_std.Timestamp;
}

export function initSensorReading(): SensorReading {
  return {
    value: initSpeed(),
    timestamp: ridl_std.initTimestamp(),
  };
}

export interface SensorFault {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 65535
   */
  code: Counter;
  message: ridl_std.Message;
}

interface RawWheelFrame {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 65535
   */
  ticks: Counter;
  /**
   * @remarks
   * Rules:
   * - length 8
   */
  frame: Uint8Array;
}
