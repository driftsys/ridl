/** Builds a `Ratio`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeRatio(value: number): Ratio {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'veh.common.Ratio', value, '[0..100]');
