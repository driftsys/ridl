                    inner: <super::Client<P> as ::ridl_rt::face::Bind>::new(port),
                    timeout: None,
                }
            }
        }
        impl<
            P: ::ridl_rt::port::Encoded + ::ridl_rt::port::SignalReader
                + ::ridl_rt::port::Caller + ::ridl_rt::port::Clock
                + ::ridl_rt::port::Wakeable,
        > ::ridl_rt::face::Timeout for Client<P>
        where
            super::super::Telemetry: ::ridl_rt::contract::Sizes<P::Encoding>,
            super::super::Odometer: ::ridl_rt::payload::Payload<P::Encoding>,
            super::super::TelemetryFuelLevelParams: ::ridl_rt::payload::Payload<
                P::Encoding,
            >,
            super::super::Percent: ::ridl_rt::payload::Payload<P::Encoding>,
        {
