        _ => DoorFault::Stuck,
    }
}
#[allow(deprecated)]
impl ::ridl_rt::payload::Payload<::ridl_rt::encoding::FlatBuffers> for DoorFault {
    /// The largest FlatBuffers buffer any legal `DoorFault` encodes to: 50 bytes.
    const MAX_SIZE: ::core::primitive::usize = 50usize;
