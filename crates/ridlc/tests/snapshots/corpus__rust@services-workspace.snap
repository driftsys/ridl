        super::Odometer: ::ridl_rt::payload::Payload<H::Encoding>,
        super::TelemetryFuelLevelParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Percent: ::ridl_rt::payload::Payload<H::Encoding>,
