        buf: &[::core::primitive::u8],
    ) -> ::core::result::Result<DoorFaultFbView<'_>, ::ridl_rt::payload::VerifyError> {
        let table = ::ridl_rt::flatbuffers::root(buf)
            .map_err(::ridl_rt::payload::VerifyError::Structure)?;
        __ridl_fb_verify_DoorFault(buf, table)?;
        ::core::result::Result::Ok(DoorFaultFbView { buf, table })
    }
    fn decode(
        r: ::ridl_rt::payload::Ref<'_, Self, ::ridl_rt::encoding::FlatBuffers>,
    ) -> Self {
        let __view = r.view();
        __ridl_fb_decode_DoorFault(__view.buf, __view.table)
    }
}


