/// A package-private payload type, so the interaction layer's legal
/// `internal`-over-`internal` case is exercised inside one package. The
/// cross-package counterpart is impossible by construction: a foreign
/// `internal` name never resolves (typl §3.3).
#[repr(transparent)]
pub(crate) struct RawTickCount(pub(crate) i64);
impl Default for RawTickCount {
    fn default() -> Self {
        RawTickCount(0)
    }
}
