// ===== package lint.shapes =====
import { ConstraintError, codePointLength, isWellFormedString, offFloatStep } from '@driftsys/ridl-runtime';

/**
 * A bounded integer.
 *
 * Build a value with `makeCount`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 200
 *
 * @range [0..200]
 */
export type Count = number & { readonly __ridl: 'lint.shapes.Count' };

/** Builds a `Count`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeCount(value: number): Count {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new ConstraintError('range', 'lint.shapes.Count', value, 'a safe integer');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'lint.shapes.Count', value, '[0..200]');
  }
  if (value > 200) {
    throw new ConstraintError('range', 'lint.shapes.Count', value, '[0..200]');
  }
  return value as Count;
}

/** Builds a `Count` without checking a value already known to satisfy its constraints. */
export function makeCountUnchecked(value: number): Count {
  return value as Count;
}

export function initCount(): Count {
  return 0 as Count;
}

/**
 * An integer whose range holds negative values and 0.
 *
 * Build a value with `makeLevel`.
 *
 * @remarks
 * Rules:
 * - range -5 ..= 10
 *
 * @range [-5..10]
 */
export type Level = number & { readonly __ridl: 'lint.shapes.Level' };

/** Builds a `Level`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeLevel(value: number): Level {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new ConstraintError('range', 'lint.shapes.Level', value, 'a safe integer');
  }
  if (value < -5) {
    throw new ConstraintError('range', 'lint.shapes.Level', value, '[-5..10]');
  }
  if (value > 10) {
    throw new ConstraintError('range', 'lint.shapes.Level', value, '[-5..10]');
  }
  return value as Level;
}

/** Builds a `Level` without checking a value already known to satisfy its constraints. */
export function makeLevelUnchecked(value: number): Level {
  return value as Level;
}

export function initLevel(): Level {
  return 0 as Level;
}

/**
 * A float with a step and a unit.
 *
 * Build a value with `makeHeat`.
 *
 * @remarks
 * Rules:
 * - range -40 ..= 125
 * - step 0.5
 * - unit Cel
 *
 * @unit Cel
 * @range [-40..125 step 0.5]
 */
export type Heat = number & { readonly __ridl: 'lint.shapes.Heat' };

/** Builds a `Heat`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeHeat(value: number): Heat {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'lint.shapes.Heat', value, '[-40..125]');
  }
  if (value < -40) {
    throw new ConstraintError('range', 'lint.shapes.Heat', value, '[-40..125]');
  }
  if (value > 125) {
    throw new ConstraintError('range', 'lint.shapes.Heat', value, '[-40..125]');
  }
  if (offFloatStep(value, true, [1.0, 0.5, 0.5, 0.0, 0.0, 0.0])) {
    throw new ConstraintError('step', 'lint.shapes.Heat', value, 'step 0.5 from -40');
  }
  return value as Heat;
}

/** Builds a `Heat` without checking a value already known to satisfy its constraints. */
export function makeHeatUnchecked(value: number): Heat {
  return value as Heat;
}

export function initHeat(): Heat {
  return 0.0 as Heat;
}

/**
 * A float with a lower bound only and a step.
 *
 * Build a value with `makeFloor`.
 *
 * @remarks
 * Rules:
 * - range 0 ..
 * - step 0.25
 *
 * @range [0.. step 0.25]
 */
export type Floor = number & { readonly __ridl: 'lint.shapes.Floor' };

/** Builds a `Floor`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeFloor(value: number): Floor {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'lint.shapes.Floor', value, '[0..]');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'lint.shapes.Floor', value, '[0..]');
  }
  if (offFloatStep(value, false, [1.0, 0.25, 0.25, 0.0, 0.0, 0.0])) {
    throw new ConstraintError('step', 'lint.shapes.Floor', value, 'step 0.25 from 0');
  }
  return value as Floor;
}

/** Builds a `Floor` without checking a value already known to satisfy its constraints. */
export function makeFloorUnchecked(value: number): Floor {
  return value as Floor;
}

export function initFloor(): Floor {
  return 0.0 as Floor;
}

/**
 * A string with a length and a pattern.
 *
 * Build a value with `makeTag`.
 *
 * @remarks
 * Rules:
 * - length 1 ..= 16
 * - pattern `/^[a-z][a-z0-9-]*$/`
 */
export type Tag = string & { readonly __ridl: 'lint.shapes.Tag' };

const __ridlPatternTag = new globalThis.RegExp('^[a-z][a-z0-9-]*$');

/** Builds a `Tag`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeTag(value: string): Tag {
  if (!isWellFormedString(value)) {
    throw new ConstraintError('utf8', 'lint.shapes.Tag', value, 'well-formed text');
  }
  if (codePointLength(value) < 1) {
    throw new ConstraintError('length', 'lint.shapes.Tag', value, '[1..16]');
  }
  if (codePointLength(value) > 16) {
    throw new ConstraintError('length', 'lint.shapes.Tag', value, '[1..16]');
  }
  if (!__ridlPatternTag.test(value)) {
    throw new ConstraintError('pattern', 'lint.shapes.Tag', value, '/^[a-z][a-z0-9-]*$/');
  }
  return value as Tag;
}

/** Builds a `Tag` without checking a value already known to satisfy its constraints. */
export function makeTagUnchecked(value: string): Tag {
  return value as Tag;
}

export function initTag(): Tag {
  return 'unit' as Tag;
}

/**
 * A string with a length only.
 *
 * Build a value with `makeLabel`.
 *
 * @remarks
 * Rules:
 * - length 0 ..= 32
 */
export type Label = string & { readonly __ridl: 'lint.shapes.Label' };

/** Builds a `Label`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeLabel(value: string): Label {
  if (!isWellFormedString(value)) {
    throw new ConstraintError('utf8', 'lint.shapes.Label', value, 'well-formed text');
  }
  if (codePointLength(value) > 32) {
    throw new ConstraintError('length', 'lint.shapes.Label', value, '[0..32]');
  }
  return value as Label;
}

/** Builds a `Label` without checking a value already known to satisfy its constraints. */
export function makeLabelUnchecked(value: string): Label {
  return value as Label;
}

export function initLabel(): Label {
  return '' as Label;
}

/**
 * Bytes with a fixed length.
 *
 * Build a value with `makeFrame`.
 *
 * @remarks
 * Rules:
 * - length 8
 */
export type Frame = Uint8Array & { readonly __ridl: 'lint.shapes.Frame' };

/** Builds a `Frame`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeFrame(value: Uint8Array): Frame {
  if (value.length < 8) {
    throw new ConstraintError('length', 'lint.shapes.Frame', value, '[8..8]');
  }
  if (value.length > 8) {
    throw new ConstraintError('length', 'lint.shapes.Frame', value, '[8..8]');
  }
  return value as Frame;
}

/** Builds a `Frame` without checking a value already known to satisfy its constraints. */
export function makeFrameUnchecked(value: Uint8Array): Frame {
  return value as Frame;
}

/**
 * Bytes with a length range.
 *
 * Build a value with `makeBlob`.
 *
 * @remarks
 * Rules:
 * - length 0 ..= 64
 */
export type Blob = Uint8Array & { readonly __ridl: 'lint.shapes.Blob' };

/** Builds a `Blob`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeBlob(value: Uint8Array): Blob {
  if (value.length > 64) {
    throw new ConstraintError('length', 'lint.shapes.Blob', value, '[0..64]');
  }
  return value as Blob;
}

/** Builds a `Blob` without checking a value already known to satisfy its constraints. */
export function makeBlobUnchecked(value: Uint8Array): Blob {
  return value as Blob;
}

export function initBlob(): Blob {
  return new Uint8Array(0) as Blob;
}

/**
 * The upper bound of a `Count`.
 */
export const MAX_COUNT = 200;

/**
 * A constant that names another constant.
 */
export const COUNT_LIMIT = 200;

/**
 * A string constant.
 */
export const DEFAULT_TAG = 'unit' as const;

/**
 * A mode.
 */
export enum Mode {
  /**
   * Not running.
   */
  IDLE = 0,
  /**
   * Running.
   */
  ACTIVE = 1,
  /**
   * Stopped by a fault, with a gap in the values before it.
   */
  FAULT = 4,
}

export function initMode(): Mode {
  return Mode.IDLE;
}

/**
 * A set of modes.
 */
export type Modes = number & { readonly __ridl: 'lint.shapes.Modes' };

export const ModesBits = {
  IDLE: 1,
  ACTIVE: 2,
  FAULT: 16,
} as const;

export function initModes(): Modes {
  return 0 as Modes;
}

/**
 * A failure.
 */
export enum Failure {
  /**
   * The station is busy.
   */
  BUSY = 0,
  /**
   * The caller may not read.
   */
  DENIED = 1,
}

export function initFailure(): Failure {
  return Failure.BUSY;
}

/**
 * A lamp state that a newer producer may extend.
 */
export enum Lamp {
  /**
   * Off.
   */
  OFF = 0,
  /**
   * On.
   */
  ON = 1,
}

/**
 * A `Lamp`, or a value that the enum does not declare.
 *
 * The codec decodes a declared value to the enum member and any other value to
 * `{ unknown: n }`, and it encodes `{ unknown: n }` as `n`. A value
 * `{ unknown: n }` whose `n` is declared is encoded as `n` and decodes as the
 * member.
 */
export type LampValue = Lamp | { readonly unknown: number };

export function initLamp(): LampValue {
  return Lamp.OFF;
}

/**
 * Lamps that a newer producer may extend.
 */
export type Lamps = number & { readonly __ridl: 'lint.shapes.Lamps' };

export const LampsBits = {
  /**
   * The low beam.
   */
  LOW: 1,
  /**
   * The high beam.
   */
  HIGH: 2,
  /** The bits of `value` that no bit of this set declares. */
  unknownBits(value: Lamps): Lamps {
    return ((value & ~3) >>> 0) as Lamps;
  },
} as const;

export function initLamps(): Lamps {
  return 0 as Lamps;
}

/**
 * An open enum set of width 64.
 */
export type Faults = bigint & { readonly __ridl: 'lint.shapes.Faults' };

export const FaultsBits = {
  /**
   * The first fault.
   */
  FIRST: 1n,
  /**
   * The last bit of the 64-bit width.
   */
  LAST: 9223372036854775808n,
  /** The bits of `value` that no bit of this set declares. */
  unknownBits(value: Faults): Faults {
    return BigInt.asUintN(64, value & ~9223372036854775809n) as Faults;
  },
} as const;

export function initFaults(): Faults {
  return 0n as Faults;
}

/**
 * A struct that nests inside `Panel`.
 */
export interface Inner {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 200
   */
  count: Count;
  /**
   * @remarks
   * Rules:
   * - length 0 ..= 32
   */
  label: Label;
}

export function initInner(): Inner {
  return {
    count: initCount(),
    label: initLabel(),
  };
}

/**
 * A failure that carries data.
 */
export interface Fault {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 200
   */
  code: Count;
  /**
   * @remarks
   * Rules:
   * - length 0 ..= 32
   */
  message: Label;
}

export function initFault(): Fault {
  return {
    code: initCount(),
    message: initLabel(),
  };
}

/**
 * Every kind of field.
 */
export interface Panel {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 200
   */
  count: Count;
  /**
   * @remarks
   * Rules:
   * - range -5 ..= 10
   */
  level: Level;
  /**
   * @remarks
   * Rules:
   * - range -40 ..= 125
   * - step 0.5
   * - unit Cel
   */
  heat: Heat;
  /**
   * @remarks
   * Rules:
   * - range 0 ..
   * - step 0.25
   */
  floor: Floor;
  /**
   * @remarks
   * Rules:
   * - length 1 ..= 16
   * - pattern `/^[a-z][a-z0-9-]*$/`
   */
  tag: Tag;
  /**
   * @remarks
   * Rules:
   * - length 0 ..= 32
   */
  note?: Label;
  /**
   * @remarks
   * Rules:
   * - length 8
   */
  frame: Frame;
  /**
   * @remarks
   * Rules:
   * - length 0 ..= 64
   */
  blob?: Blob;
  flag: boolean;
  mode: Mode;
  modes: Modes;
  inner: Inner;
  span: { low: Level; high: Level };
  /**
   * @remarks
   * Rules:
   * - count 4
   *
   * @bounds 4
   */
  fixed4: readonly Count[];
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 4
   *
   * @bounds 0..4
   */
  levels: readonly Level[];
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 2
   *
   * @bounds 0..2
   */
  texts: readonly string[];
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 3
   *
   * @bounds 0..3
   */
  byTag: ReadonlyArray<readonly [Tag, Count]>;
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 2
   *
   * @bounds 0..2
   */
  nested: readonly Inner[];
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 200
   *
   * @deprecated read `count`
   */
  legacy?: Count;
}

/**
 * Open enums and open enum sets, alone and in an array, and an open enum set
 * of width 64. An open enum whose podbuf integer is a `u64` has no place
 * here: its values are outside int32, which the proto3 codec of this corpus
 * refuses.
 */
export interface Lights {
  lamp: LampValue;
  lamps: Lamps;
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 4
   *
   * @bounds 0..4
   */
  trail: readonly LampValue[];
  /**
   * @remarks
   * Rules:
   * - count 0 ..= 4
   *
   * @bounds 0..4
   */
  sets: readonly Lamps[];
  faults: Faults;
}

export function initLights(): Lights {
  return {
    lamp: initLamp(),
    lamps: initLamps(),
    trail: [],
    sets: [],
    faults: initFaults(),
  };
}

/**
 * A union with data arms only.
 */
export type Outcome =
  | { kind: 'number'; value: Count }
  | { kind: 'text'; value: Label }
  | { kind: 'panel'; value: Panel };

export function initOutcome(): Outcome {
  return { kind: 'number', value: initCount() };
}

/**
 * A result union: one success arm and one error arm.
 */
export type Checked =
  | { kind: 'ok'; value: Inner }
  | { kind: 'err'; value: Fault };

export function initChecked(): Checked {
  return { kind: 'ok', value: initInner() };
}

/**
 * A package-private struct.
 */
interface Raw {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 200
   */
  ticks: Count;
  /**
   * @remarks
   * Rules:
   * - length 8
   */
  frame: Frame;
}
