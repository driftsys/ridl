// ===== package veh.adas =====


// ===== package veh.common =====
import { ConstraintError } from '@driftsys/ridl-runtime';

/**
 * Build a value with `makeSpeed`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 250
 * - step 0.5
 * - unit km/h
 *
 * @unit km/h
 * @range [0..250 step 0.5]
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

/** Builds a `Speed`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeSpeed(value: number): Speed {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'veh.common.Speed', value, '[0..250]');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'veh.common.Speed', value, '[0..250]');
  }
  if (value > 250) {
    throw new ConstraintError('range', 'veh.common.Speed', value, '[0..250]');
  }
  return value as Speed;
}

/** Builds a `Speed` without checking a value already known to satisfy its constraints. */
export function makeSpeedUnchecked(value: number): Speed {
  return value as Speed;
}

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

/**
 * Build a value with `makeEngaged`.
 */
export type Engaged = boolean & { readonly __ridl: 'veh.common.Engaged' };

/** Builds a `Engaged`. */
export function makeEngaged(value: boolean): Engaged {
  return value as Engaged;
}

export function initEngaged(): Engaged {
  return false as Engaged;
}

export enum LeverCmd {
  SET = 1,
  CANCEL = 2,
  RESUME = 3,
}

export function initLeverCmd(): LeverCmd {
  return LeverCmd.SET;
}

export interface FaultReport {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 255
   *
   * @range [0..255]
   */
  count: number;
}

export function initFaultReport(): FaultReport {
  return {
    count: 0,
  };
}


