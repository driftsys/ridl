// ===== package fleet.contracts =====
import { ConstraintError, offFloatStep } from '@driftsys/ridl-runtime';

/**
 * Build a value with `makeDoorId`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 7
 *
 * @range [0..7]
 */
export type DoorId = number & { readonly __ridl: 'fleet.contracts.DoorId' };

/** Builds a `DoorId`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeDoorId(value: number): DoorId {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new ConstraintError('range', 'fleet.contracts.DoorId', value, 'a safe integer');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'fleet.contracts.DoorId', value, '[0..7]');
  }
  if (value > 7) {
    throw new ConstraintError('range', 'fleet.contracts.DoorId', value, '[0..7]');
  }
  return value as DoorId;
}

/** Builds a `DoorId` without checking a value already known to satisfy its constraints. */
export function makeDoorIdUnchecked(value: number): DoorId {
  return value as DoorId;
}

export function initDoorId(): DoorId {
  return 0 as DoorId;
}

/**
 * Build a value with `makePercent`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 100
 * - step 0.5
 * - unit %
 *
 * @unit %
 * @range [0..100 step 0.5]
 */
export type Percent = number & { readonly __ridl: 'fleet.contracts.Percent' };

/** Builds a `Percent`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makePercent(value: number): Percent {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'fleet.contracts.Percent', value, '[0..100]');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'fleet.contracts.Percent', value, '[0..100]');
  }
  if (value > 100) {
    throw new ConstraintError('range', 'fleet.contracts.Percent', value, '[0..100]');
  }
  if (offFloatStep(value, true, [1.0, 0.5, 0.5, 0.0, 0.0, 0.0])) {
    throw new ConstraintError('step', 'fleet.contracts.Percent', value, 'step 0.5 from 0');
  }
  return value as Percent;
}

/** Builds a `Percent` without checking a value already known to satisfy its constraints. */
export function makePercentUnchecked(value: number): Percent {
  return value as Percent;
}

export function initPercent(): Percent {
  return 0.0 as Percent;
}

/**
 * Build a value with `makeOdometer`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 4294967295
 *
 * @range [0..4294967295]
 */
export type Odometer = number & { readonly __ridl: 'fleet.contracts.Odometer' };

/** Builds a `Odometer`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeOdometer(value: number): Odometer {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new ConstraintError('range', 'fleet.contracts.Odometer', value, 'a safe integer');
  }
  if (value < 0) {
    throw new ConstraintError('range', 'fleet.contracts.Odometer', value, '[0..4294967295]');
  }
  if (value > 4294967295) {
    throw new ConstraintError('range', 'fleet.contracts.Odometer', value, '[0..4294967295]');
  }
  return value as Odometer;
}

/** Builds a `Odometer` without checking a value already known to satisfy its constraints. */
export function makeOdometerUnchecked(value: number): Odometer {
  return value as Odometer;
}

export function initOdometer(): Odometer {
  return 0 as Odometer;
}

export enum LockState {
  UNLOCKED = 0,
  LOCKED = 1,
}

export function initLockState(): LockState {
  return LockState.UNLOCKED;
}

export interface DoorReport {
  /**
   * @remarks
   * Rules:
   * - range 0 ..= 7
   */
  door: DoorId;
  locked: LockState;
}

export function initDoorReport(): DoorReport {
  return {
    door: initDoorId(),
    locked: initLockState(),
  };
}

export enum DoorFault {
  JAMMED = 0,
  UNPOWERED = 1,
}

export function initDoorFault(): DoorFault {
  return DoorFault.JAMMED;
}


// ===== package fleet.legacy =====
/**
 * The M1 fleet's door failure set, kept for contracts still on the old wire.
 */
export enum DoorFault {
  STUCK = 0,
  NO_POWER = 1,
}

export function initDoorFault(): DoorFault {
  return DoorFault.STUCK;
}


