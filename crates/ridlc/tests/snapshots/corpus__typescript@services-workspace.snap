// ===== package fleet.contracts =====
/**
 * @range [0..7]
 */
export type DoorId = number & { readonly __ridl: 'fleet.contracts.DoorId' };

export function initDoorId(): DoorId {
  return 0 as DoorId;
}

/**
 * @unit %
 * @range [0..100 step 0.5]
 */
export type Percent = number & { readonly __ridl: 'fleet.contracts.Percent' };

export function initPercent(): Percent {
  return 0.0 as Percent;
}

/**
 * @range [0..4294967295]
 */
export type Odometer = number & { readonly __ridl: 'fleet.contracts.Odometer' };

export function initOdometer(): Odometer {
  return 0 as Odometer;
}

export enum LockState {
  UNLOCKED = 0,
  LOCKED = 1,
}

export function initLockState(): LockState {
  return LockState.UNLOCKED;
}

export interface DoorReport {
  door: DoorId;
  locked: LockState;
}

export function initDoorReport(): DoorReport {
  return {
    door: initDoorId(),
    locked: initLockState(),
  };
}

export enum DoorFault {
  JAMMED = 0,
  UNPOWERED = 1,
}

export function initDoorFault(): DoorFault {
  return DoorFault.JAMMED;
}


// ===== package fleet.legacy =====
/**
 * The M1 fleet's door failure set, kept for contracts still on the old wire.
 */
export enum DoorFault {
  STUCK = 0,
  NO_POWER = 1,
}

export function initDoorFault(): DoorFault {
  return DoorFault.STUCK;
}


