    #[allow(deprecated)]
    pub(crate) fn dispatch<H, P>(
        h: &mut H,
        p: &mut P,
        buf: &mut [u8],
        budget: &mut usize,
    ) -> ::core::result::Result<usize, ::ridl_rt::port::ReadError>
    where
        H: ::ridl_rt::port::Encoded + ::ridl_rt::port::Handler,
        P: Provider,
        super::Station: ::ridl_rt::contract::Sizes<H::Encoding>,
        super::Count: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Heat: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Modes: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Inner: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Panel: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationSetParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Tag: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationOutcomeParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Outcome: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationCheckedParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Checked: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationBoundsParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationBoundsReply: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationOldParams: ::ridl_rt::payload::Payload<H::Encoding>,
    {
        if buf.len()
            < <super::Station as ::ridl_rt::contract::Sizes<
                H::Encoding,
            >>::MAX_BUFFER_SIZE
        {
            return Ok(0);
        }
        let mut settled = 0usize;
        while *budget > 0 {
            let settlement = match h.next_claim(buf) {
                Ok(None) => break,
                Err(::ridl_rt::port::ReadError::ShortClaim { claim, .. }) => {
                    let settlement = h
                        .settle(
                            claim,
                            Err(
                                ::ridl_rt::error::CallError::Transport(
                                    ::ridl_rt::error::Transport::Corrupt,
                                ),
                            ),
                        );
                    if settlement.is_err() {
                        return Ok(settled);
                    }
                    settlement
                }
                Err(error) => return Err(error),
                Ok(Some(claim)) => {
                    if claim.iface
                        != <super::Station as ::ridl_rt::contract::Interface>::NUMBER
                    {
                        h.settle(
                            claim.id,
                            Err(
                                ::ridl_rt::error::CallError::Contract(
                                    ::ridl_rt::error::Contract::UnknownInteraction,
                                ),
                            ),
                        )
                    } else {
                        match claim.ord {
                            ::ridl_rt::contract::Ordinal(6u32) => {
                                let decoded = match ::ridl_rt::payload::Ref::<
                                    super::StationSetParams,
                                    H::Encoding,
                                >::verify(&buf[..claim.len]) {
