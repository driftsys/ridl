    const SERVE_BUDGET: usize = 32;
    /// Serves interface `Station`'s commands and queries with `p`, over the handler port `h`, and returns the future that does the serving. `Handler::serve` is called with the interface's command and query ordinals when this function runs; a refusal is a future that is ready with `ProviderError::Serve`. Each poll of the future registers its interest in the interface's claims, then takes and settles the claims the handler has, at most 32 in one poll, so that one poll does not hold a single-threaded executor while callers keep sending. A poll that took 32 claims wakes the future's waker and is `Pending`, so the executor polls it again after other tasks have run; a poll that found no claim left before 32 is `Pending` without waking it. Under `ridl_rt::task::noop_waker` that wake is discarded, so a frame loop that polls the future once per frame settles at most 32 claims per frame; a frame loop that polls with `ridl_rt::task::flag_waker` polls again while its flag was set, up to the loop's own limit of polls per frame. The future resolves only when the handler port fails, to `ProviderError::Claim`; every claim settled before the failure stays settled. `h` is held by value and `p` by `&mut` until the future is dropped.
    ///
    /// # Panics
    ///
    /// Panics when `h` is attached to a catalog other than the one this face was generated from, that is, when the package name or the catalog hash differs (ADR-0023 decision 8); the comparison is made once, before `Handler::serve` is called. A program that must not panic makes the same comparison first, `h.catalog() == <Station as ridl_rt::contract::Interface>::CATALOG` with `ridl_rt::port::Attached` in scope, where `Station` is the interface's descriptor type, declared beside this interface's module, and handles a mismatch its own way.
    #[track_caller]
    pub fn serve<H, P>(mut h: H, p: &mut P) -> Serve<'_, H, P>
    where
        H: ::ridl_rt::port::Encoded + ::ridl_rt::port::Handler
            + ::ridl_rt::port::Wakeable,
        P: Provider,
        super::Station: ::ridl_rt::contract::Sizes<H::Encoding>,
        super::Count: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Heat: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Modes: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Inner: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Panel: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationSetParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Tag: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationOutcomeParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Outcome: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationCheckedParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Checked: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationBoundsParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationBoundsReply: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationOldParams: ::ridl_rt::payload::Payload<H::Encoding>,
    {
        check_catalog(::ridl_rt::port::Attached::catalog(&h));
        let state = match h
            .serve(
                <super::Station as ::ridl_rt::contract::Interface>::NUMBER,
                &[
                    ::ridl_rt::contract::Ordinal(6u32),
                    ::ridl_rt::contract::Ordinal(7u32),
                    ::ridl_rt::contract::Ordinal(9u32),
                    ::ridl_rt::contract::Ordinal(10u32),
                    ::ridl_rt::contract::Ordinal(11u32),
                    ::ridl_rt::contract::Ordinal(12u32),
                    ::ridl_rt::contract::Ordinal(14u32),
                ],
            )
        {
            Ok(()) => ServeState::Serving,
            Err(error) => ServeState::Refused(error),
        };
        Serve {
            handler: h,
            provider: p,
            buf: <super::Station as ::ridl_rt::contract::Sizes<
                H::Encoding,
            >>::CLAIM_BUFFER,
            state,
        }
    }
    ///The future `serve` returns over interface `Station`. It holds the handler, the provider, and the claim buffer of `<Station as Sizes<H::Encoding>>::MAX_BUFFER_SIZE` bytes, in the encoding the handler port carries. It never resolves to `Ok`, and polling it again after it resolved panics.
    #[must_use = "claims are served only while the future is polled"]
    pub struct Serve<
        'a,
        H: ::ridl_rt::port::Encoded + ::ridl_rt::port::Handler
            + ::ridl_rt::port::Wakeable,
        P: Provider,
    >
    where
        super::Station: ::ridl_rt::contract::Sizes<H::Encoding>,
    {
        handler: H,
        provider: &'a mut P,
        buf: <super::Station as ::ridl_rt::contract::Sizes<H::Encoding>>::ClaimBuffer,
        state: ServeState,
    }
    #[derive(Clone, Copy)]
    enum ServeState {
        Refused(::ridl_rt::port::ServeError),
        Serving,
        Done,
    }
    /// `Unpin` whatever `H` is: nothing in the future is pinned, and a
    /// frame loop that stores it in its own state polls it through
    /// `Pin::new`.
    impl<
        H: ::ridl_rt::port::Encoded + ::ridl_rt::port::Handler
            + ::ridl_rt::port::Wakeable,
        P: Provider,
    > ::core::marker::Unpin for Serve<'_, H, P>
    where
        super::Station: ::ridl_rt::contract::Sizes<H::Encoding>,
        super::Count: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Heat: ::ridl_rt::payload::Payload<H::Encoding>,
