            + ::ridl_rt::port::Wakeable,
        P: Provider,
    > ::core::future::Future for Serve<'_, H, P>
    where
        super::Station: ::ridl_rt::contract::Sizes<H::Encoding>,
        super::Count: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Heat: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Modes: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Inner: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Panel: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationSetParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Tag: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationOutcomeParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Outcome: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationCheckedParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::Checked: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationBoundsParams: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationBoundsReply: ::ridl_rt::payload::Payload<H::Encoding>,
        super::StationOldParams: ::ridl_rt::payload::Payload<H::Encoding>,
    {
        type Output = ::core::result::Result<
            ::core::convert::Infallible,
