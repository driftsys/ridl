// ===== package veh.common =====
import * as ridl_std from './ridl.std';

/**
 * Vehicle speed over ground
 *
 * @unit km/h
 * @range [0..250 step 0.5]
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

/**
 * Coolant / ambient temperature
 *
 * @unit Cel
 * @range [-40..125 step 0.1]
 */
export type Temperature = number & { readonly __ridl: 'veh.common.Temperature' };

export function initTemperature(): Temperature {
  return 0.0 as Temperature;
}

/**
 * Engine crankshaft speed
 *
 * @unit /min
 * @range [0..8000 step 10]
 */
export type RPM = number & { readonly __ridl: 'veh.common.RPM' };

export function initRPM(): RPM {
  return 0.0 as RPM;
}

/**
 * Normalised ratio
 *
 * @unit %
 * @range [0..100 step 0.1]
 */
export type Ratio = number & { readonly __ridl: 'veh.common.Ratio' };

export function initRatio(): Ratio {
  return 0.0 as Ratio;
}

/**
 * @range [0..65535]
 */
export type Counter = number & { readonly __ridl: 'veh.common.Counter' };

export function initCounter(): Counter {
  return 0 as Counter;
}

/**
 * @range [0..1 step 0.01]
 */
export type Gain = number & { readonly __ridl: 'veh.common.Gain' };

export function initGain(): Gain {
  return 0.0 as Gain;
}

export const MAX_SPEED = 250.0;

export const SPEED_LIMIT_EU = 130.0;

export const MAX_GEAR = 6;

export const IDLE_RPM = 800.0;

export enum GearPosition {
  PARK = 0,
  DRIVE = 1,
  REVERSE = 2,
  NEUTRAL = 3,
}

export function initGearPosition(): GearPosition {
  return GearPosition.PARK;
}

export enum Warning {
  LOW_FUEL = 0,
  CHECK_ENGINE = 1,
  DOOR_OPEN = 2,
  SEATBELT = 3,
}

export function initWarning(): Warning {
  return Warning.LOW_FUEL;
}

export type WarningFlags = number & { readonly __ridl: 'veh.common.WarningFlags' };

export const WarningFlagsBits = {
  LOW_FUEL: 1,
  CHECK_ENGINE: 2,
  DOOR_OPEN: 4,
  SEATBELT: 8,
} as const;

export function initWarningFlags(): WarningFlags {
  return 0 as WarningFlags;
}

export interface SpeedLimitPayload {
  limit: Speed;
  actual: Speed;
}

export function initSpeedLimitPayload(): SpeedLimitPayload {
  return {
    limit: initSpeed(),
    actual: initSpeed(),
  };
}

export interface DriverProfile {
  name: ridl_std.Name;
  speed: Speed;
  override?: Speed;
  /**
   * @range [0..6]
   */
  gears: number;
}

export interface SensorBounds {
  range: { min: Speed; max: Speed };
  /**
   * @bounds 8
   */
  readings: readonly Speed[];
  /**
   * @bounds 1..16
   */
  labels: readonly ridl_std.Label[];
  /**
   * @bounds 0..32
   */
  meta: ReadonlyArray<readonly [ridl_std.Label, ridl_std.Name]>;
}

export type SensorResult =
  | { kind: 'ok'; value: SensorReading }
  | { kind: 'err'; value: SensorFault };

export function initSensorResult(): SensorResult {
  return { kind: 'ok', value: initSensorReading() };
}

export interface SensorReading {
  value: Speed;
  timestamp: ridl_std.Timestamp;
}

export function initSensorReading(): SensorReading {
  return {
    value: initSpeed(),
    timestamp: ridl_std.initTimestamp(),
  };
}

export interface SensorFault {
  code: Counter;
  message: ridl_std.Message;
}

interface RawWheelFrame {
  ticks: Counter;
  frame: Uint8Array;
}


// ===== package veh.cluster =====
import * as ridl_std from './ridl.std';
import * as veh_common from './veh.common';

export interface DoorPayload {
  /**
   * @range [0..15]
   */
  sensorId: number;
  isOpen: boolean;
}

export function initDoorPayload(): DoorPayload {
  return {
    sensorId: 0,
    isOpen: false,
  };
}

export interface DiagFilter {
  /**
   * @range [0..5]
   */
  severity: number;
  category?: ridl_std.Label;
}

export function initDiagFilter(): DiagFilter {
  return {
    severity: 0,
  };
}

export interface FaultEvent {
  /**
   * @range [0..65535]
   */
  code: number;
  message: ridl_std.Message;
  timestamp: ridl_std.Timestamp;
}

export enum DiagError {
  FILTER_INVALID = 0,
  STORAGE_BUSY = 1,
  ACCESS_DENIED = 2,
}

export function initDiagError(): DiagError {
  return DiagError.FILTER_INVALID;
}

export interface FaultPage {
  /**
   * @bounds 0..64
   */
  faults: readonly FaultEvent[];
}

export function initFaultPage(): FaultPage {
  return {
    faults: [],
  };
}

/**
 * A package-private payload type, so the interaction layer's legal
 * `internal`-over-`internal` case is exercised inside one package. The
 * cross-package counterpart is impossible by construction: a foreign
 * `internal` name never resolves (typl §3.3).
 *
 * @range [0..65535]
 */
type RawTickCount = number & { readonly __ridl: 'veh.cluster.RawTickCount' };

function initRawTickCount(): RawTickCount {
  return 0 as RawTickCount;
}

/**
 * The window of raw tick counts a wheel diagnostic covers.
 */
interface RawWheelSpan {
  span: { first: RawTickCount; latest: RawTickCount };
}

function initRawWheelSpan(): RawWheelSpan {
  return {
    span: { first: initRawTickCount(), latest: initRawTickCount() },
  };
}

/**
 * @range [0..7]
 */
export type FanLevel = number & { readonly __ridl: 'veh.cluster.FanLevel' };

export function initFanLevel(): FanLevel {
  return 0 as FanLevel;
}

export interface FilterState {
  /**
   * @range [0..65535]
   */
  hoursRun: number;
  clogged: boolean;
}

export function initFilterState(): FilterState {
  return {
    hoursRun: 0,
    clogged: false,
  };
}

export interface ClimateReport {
  cabin: veh_common.Temperature;
  setpoint: veh_common.Temperature;
  fan: FanLevel;
}

export function initClimateReport(): ClimateReport {
  return {
    cabin: veh_common.initTemperature(),
    setpoint: veh_common.initTemperature(),
    fan: initFanLevel(),
  };
}

export enum HvacError {
  COMPRESSOR_OFF = 0,
  SENSOR_FAULT = 1,
}

export function initHvacError(): HvacError {
  return HvacError.COMPRESSOR_OFF;
}

/**
 * A declared constant, so a contract clause can reference one. The guaranteed
 * expression subset admits constants (ridl §13) and nothing in the corpus
 * exercised that until these members were added.
 */
export const MAX_FAN = 7;

/**
 * The ceiling a fan request is clamped to.
 */
export const FAN_CEILING = 7;

/**
 * The same ceiling, one hop further along the chain.
 */
export const FAN_LIMIT = 7;

/**
 * The label a cabin fan reports itself under.
 */
export type FanTag = string & { readonly __ridl: 'veh.cluster.FanTag' };

export function initFanTag(): FanTag {
  return 'unset' as FanTag;
}

/**
 * The cabin fan's label.
 */
export const FAN_TAG = 'cabin-fan' as const;

/**
 * The same label, reached through the constant above.
 */
export const FAN_LABEL = 'cabin-fan' as const;

/**
 * What a signal read is standing on (ridl §4.5). `'init'` — the provider has
 * not published yet and the value is the channel init (ridl §4.4); `'live'` —
 * a published value; `'invalid'` — the channel is in the invalid state
 * because a published payload violated its constraints, and the value is the
 * last good one. A read always yields a value; provenance is what says
 * whether to act on it. Invalidity is never hidden from a subscriber.
 */
export type Provenance = 'init' | 'live' | 'invalid';

/**
 * A consumer's handle on a signal (ridl §4): continuous state, never empty —
 * the channel holds a value from the moment it exists, so a read always
 * succeeds and a subscription delivers immediately (ridl §4.4).
 * `subscribe` returns the function that cancels it.
 */
export interface SignalHandle<T> {
  read(): { value: T; provenance: Provenance };
  subscribe(fn: (value: T, provenance: Provenance) => void): () => void;
}

/**
 * A consumer's handle on an event (ridl §5): discrete occurrences, with no
 * readable current value — an event that has not occurred has nothing to
 * read. `subscribe` returns the function that cancels it.
 */
export interface EventHandle<T> {
  subscribe(fn: (occurrence: T) => void): () => void;
}

/**
 * The result of a fallible query (ridl §7, gf §6.1): a declared Stratum-1
 * outcome the provider owns. A transport failure is not an `error` here — it
 * rejects the promise instead, an infrastructure failure — detected, undeclared (gf §6.4).
 */
export type Result<T, E> =
  | { ok: true; value: T }
  | { ok: false; error: E };

/**
 * Main vehicle status interface.
 *
 * The consumer face of this interface (ridl §14): what code holding a
 * binding to it sees. Signals are read and subscribed, events are
 * subscribed, commands and queries are called, finals are read.
 *
 * @reserved ordinal 6 (`resetCounters`) — retired, never reused.
 */
export interface VehicleStatusConsumer {
  /**
   * Current vehicle speed — isochronous, drives rmdl clocks downstream
   *
   * @ordinal 1
   * @init 0
   * @provenance `'init'` until the provider's first publication (ridl §4.4).
   */
  currentSpeed: SignalHandle<veh_common.Speed>;
  /**
   * Engine temperature — change-driven, 100ms freshness SLO
   *
   * @ordinal 2
   * @init 0
   * @provenance `'init'` until the provider's first publication (ridl §4.4).
   */
  engineTemp: SignalHandle<veh_common.Temperature>;
  /**
   * Active warnings — last-value delivered on subscribe (§4.4)
   *
   * @ordinal 3
   * @provenance `'init'` until the provider's first publication (ridl §4.4).
   */
  warnings: SignalHandle<veh_common.WarningFlags>;
  /**
   * Raised on every door state change; stale after 500ms
   *
   * @ordinal 4
   */
  doorOpened: EventHandle<DoorPayload>;
  /**
   * Request a gear change — outcome observed via currentGear, not returned
   *
   * A command is fire-and-forget (ridl §6): it declares no result, and an
   * observable outcome travels back as state, not as a return value. The
   * promise settles on the runtime's delivery acknowledgment, which "carries
   * no functional payload, never reaches the contract surface, and is not
   * application-visible as a return value" (ridl §6.1).
   *
   * @ordinal 5
   * @remarks A rejected promise is an infrastructure failure — detected, undeclared (gf §6.4).
   */
  setGear(position: veh_common.GearPosition): Promise<void>;
  /**
   * Sliding-window average
   *
   * @ordinal 7
   * @remarks A rejected promise is an infrastructure failure — detected, undeclared (gf §6.4).
   */
  getAverageSpeed(window: ridl_std.Duration): Promise<veh_common.Speed>;
  /**
   * Fault history as a finite stream
   *
   * @ordinal 8
   * @remarks A rejected promise is an infrastructure failure — detected, undeclared (gf §6.4).
   */
  streamFaults(filter: DiagFilter): AsyncIterable<FaultEvent>;
  /**
   * Paged fault snapshot — fallible query via inline `T | E` (§10.1)
   *
   * @ordinal 9
   * @transportIdentity VehicleStatus#9:FaultPage|DiagError
   * @remarks A rejected promise is an infrastructure failure — detected, undeclared (gf §6.4).
   */
  getFaultPage(filter: DiagFilter): Promise<Result<FaultPage, DiagError>>;
  /**
   * @ordinal 10
   */
  readonly softwareVersion: ridl_std.Version;
  /**
   * @ordinal 11
   */
  readonly capabilities: readonly ridl_std.Label[];
}

