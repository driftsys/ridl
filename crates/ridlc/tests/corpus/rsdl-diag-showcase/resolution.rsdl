package rsdl.showcase

// RSDL-408 (rsdl reference §8): `Braking` is listed by `ChassisService`
// and by `BrakesService`, both offered in the closure.
component Brakes { offers BrakesService }

// RSDL-502 (§8): `Front` and `Rear` both offer `Lights`.
component Front { offers Lights }
component Rear { offers Lights }

// RSDL-409, a warning (§7): `Driver` requires `Horn`, offered by `Hooter`,
// which has two instances.
// RSDL-403 (§8): no closure service lists `Wiper`; `Wipers`, outside the
// closure, offers one that does.
component Hooter [ instances = (left, right) ] { offers HornService }
component Driver {
  requires Horn
  requires Wiper
  // The link that draws RSDL-806 in `Bench` (placement.rsdl).
  requires Alerts
}
component Wipers { offers WipersService }

// RSDL-308 (§3.2): `Echo` requires the interface of the service it offers.
component Echo {
  offers EchoService
  requires EchoService
}
