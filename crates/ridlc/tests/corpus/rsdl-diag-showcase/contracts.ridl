package rsdl.showcase

// The ridl contracts the rsdl showcase names. They draw no diagnostic.

type Flag: boolean

interface Steering {
  signal angle: Flag @[100ms..1s]
}

interface Braking {
  signal active: Flag @[100ms..1s]
}

service ChassisService : Steering, Braking

service Status {
  signal alive: Flag @[100ms..1s]
}

interface Horn {
  signal sounding: Flag @[100ms..1s]
}

interface Wiper {
  signal wiping: Flag @[100ms..1s]
}

service BrakesService : Braking

service HornService : Horn

service WipersService : Wiper

service Lights {
  signal lit: Flag @[100ms..1s]
}

service EchoService {
  signal ping: Flag @[100ms..1s]
}

// The events the depth rules of rsdl §5 read: `honked` has the contract bound
// `ceil(1s / 100ms)` = 10; `released` is half-open and has none.
interface Alerts {
  event honked: Flag @[100ms..1s]
  event released: Flag @[100ms..]
}

service AlertsService : Alerts
