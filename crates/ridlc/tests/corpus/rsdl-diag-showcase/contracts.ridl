package rsdl.showcase

// The ridl contracts the rsdl showcase names. They draw no diagnostic.

type Flag: boolean

interface Steering {
  signal angle: Flag @[100ms..1s]
}

interface Braking {
  signal active: Flag @[100ms..1s]
}

service rsdl.showcase.chassis : Steering, Braking

service rsdl.showcase.status {
  signal alive: Flag @[100ms..1s]
}

interface Horn {
  signal sounding: Flag @[100ms..1s]
}

interface Wiper {
  signal wiping: Flag @[100ms..1s]
}

service rsdl.showcase.brakes : Braking

service rsdl.showcase.horn : Horn

service rsdl.showcase.wipers : Wiper

service rsdl.showcase.lights {
  signal lit: Flag @[100ms..1s]
}

service rsdl.showcase.echo {
  signal ping: Flag @[100ms..1s]
}
