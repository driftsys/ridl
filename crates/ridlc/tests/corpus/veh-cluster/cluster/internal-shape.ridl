// `internal` on the interaction layer (typl §3.3, ADR-0008 decision 7).
//
// `internal` is accepted on an `interface` — not on an interaction and not on a
// service, which are parse errors — and the IR records it faithfully
// (`Interface.visibility = 2`). What the backends do with it is the point of
// this file: it is what caught them dropping `internal` entirely. See
// `veh-cluster/NOTES`, "`internal` was dropped by both backends".

package veh.cluster

/// A package-private contract shape: realized inside this package, never part
/// of the cross-package surface.
internal interface WheelDiagnostics {
  signal wheelTicks : FanLevel @[100ms..1s]
  event slipDetected : FilterState @[50ms..500ms]
  query readTicks(): FanLevel
}

/// A public shape beside it, so the generated output shows the two side by
/// side and the difference is readable in one snapshot.
interface WheelSummary {
  signal wheelHealth : FanLevel @[1s..10s]
}
