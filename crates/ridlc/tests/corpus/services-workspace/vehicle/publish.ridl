// The publishing member: it declares no interface of its own and gives global
// identity to shapes that live in the sibling members. This is the
// cross-package service path — the checker has to resolve `DoorControl`
// through the workspace-member import before it can tell a service names an
// interface (RIDL-141 is what it would say otherwise).
//
// It is also where the corpus records what a *cross-package* transport
// identity looks like. An inline `T | E` return synthesizes its union's
// transport identity from the enclosing shape, the ordinal, and the two arm
// references (ADR-0008 decision 4) — and the arm references are written
// differently depending on where the arms live:
//
//   same-package arms  →  DoorControl#4:DoorReport|DoorFault
//   cross-package arms →  fleet.vehicle.mirrors#5:fleet.contracts.DoorReport|…
//
// A registry keys a wire contract on that string, so both shapes belong in the
// golden record. `fleet.contracts` holds the bare one; the two queries at the
// end of the inline shape below hold the qualified one, including the property
// that an *alias* is canonicalized away: `LegacyFault` is written in source and
// `fleet.legacy.DoorFault` appears in the identity.

package fleet.vehicle

import fleet.contracts.DoorControl
import fleet.contracts.Telemetry
import fleet.contracts.DoorId
import fleet.contracts.Percent
import fleet.contracts.DoorReport
import fleet.contracts.DoorFault
import fleet.legacy.DoorFault as LegacyFault

/// Two services over one imported shape: the front and rear door controllers
/// are separate system-wide addresses realizing the same contract.
service fleet.vehicle.doors.front : DoorControl

service fleet.vehicle.doors.rear : DoorControl

/// A second imported shape.
service fleet.vehicle.telemetry : Telemetry

/// One address composing both shapes (ADR-0015 decision 12): the interface
/// stays the generation unit, the service the addressing unit, so this
/// declaration generates nothing new — it gives the two contracts one more
/// global name. The tombstone holds interface id 2 permanently (ADR-0015
/// decision 15), so `Telemetry` is id 3.
service fleet.vehicle.cockpit : DoorControl, reserved LegacyCabin, Telemetry

/// An inline shape in a package that owns none of its vocabulary: every
/// payload, parameter and return type here is a cross-package reference
/// resolved through the workspace members above.
service fleet.vehicle.mirrors {
  signal foldAngle : Percent @[200ms..2s]
  command fold(door: DoorId) @[..50ms]
  query readFold(door: DoorId): Percent [
    require door <= 7
    ensure result >= 0.0
  ] @[..50ms]
  fixed mirrorCount : DoorId

  /// Cross-package `T | E`: both arms live in `fleet.contracts`, so the
  /// synthesized transport identity carries their fully qualified names.
  query readDoor(door: DoorId): DoorReport | DoorFault @[..50ms]

  /// The same, with the error arm reached through an import alias. The alias
  /// is a source-level convenience; the transport identity must show the
  /// canonical `fleet.legacy.DoorFault`, because a registry keying on it has
  /// to be stable against how a consumer chose to spell its imports.
  query readLegacyDoor(door: DoorId): DoorReport | LegacyFault @[..50ms]
}
