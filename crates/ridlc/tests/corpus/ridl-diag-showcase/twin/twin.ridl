// The second workspace member. Its job is the cross-package half a single
// package cannot provoke: republishing `diag.showcase.duplicate` collides
// with the `diag.ridl` member (RIDL-140).

package diag.twin

type Heartbeat : integer [0..255]

interface Twin {
  signal alive : Heartbeat @[1s..10s]
}

service diag.showcase.duplicate : Twin
