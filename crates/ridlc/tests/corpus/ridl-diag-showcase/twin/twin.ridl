// The second workspace member. Its jobs are the two cross-package halves a
// single package cannot provoke: republishing `diag.showcase.duplicate`
// collides with the `diag.ridl` member (RIDL-140), and its own `Published`
// gives `diag.ridl` a second interface with that name to compose (RIDL-147) —
// one package cannot declare two interfaces with one name.

package diag.twin

type Heartbeat : integer [0..255]

interface Twin {
  signal alive : Heartbeat @[1s..10s]
}

/// The cross-package half of the interface-name collision (RIDL-147): the
/// `diag.ridl` member composes this `Published` beside its own.
interface Published {
  signal alive : Heartbeat @[1s..10s]
}

service diag.showcase.duplicate : Twin
