// Per-kind shape diagnostics (ridl §6.1, §7.1, §8, §9, §14.1): RIDL-104, 105,
// 106, 107.

package diag.ridl

interface Kinds {

  /// A command always returns `()`; writing a return type is an error.
  command withReturn(level: Level): Speed

  /// A query must return something; an empty return belongs to `command`.
  query nothingBack(): ()

  /// `fixed` takes no timing annotation.
  fixed timedFixed : Level @1s

  /// Neither does a command: timing belongs to `signal` and `event` (ridl §9),
  /// and one rule is one code — this drew FORM-102 ("unexpected token") until
  /// the E2 close-out, for a token the grammar accepts on purpose.
  command timedCommand() @1s

  /// Nor a query.
  query timedQuery(): Level @1s

  /// `fixed` takes no attribute block either.
  fixed constrainedFixed : Level [
    require true
  ]

  /// Type declarations live at package level, never inside an interface.
  struct Nested {
    x : Level
  }
}
