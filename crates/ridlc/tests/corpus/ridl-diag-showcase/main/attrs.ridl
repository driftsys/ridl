// Attribute allow-list diagnostics (general form §4.3): FORM-106, FORM-107,
// FORM-108. Every key is looked up in the attribute registry
// (`ridl_core::attributes`): a key with a row that does not name this site
// draws FORM-107, a key with no row draws FORM-106, and a key written twice
// in one block draws FORM-108.

package diag.ridl

interface Attrs {

  /// `tier` has a registry row, and its only site is a `distribution`.
  /// Writing it twice in one block adds the duplicate-key report.
  command flagged(level: Level) [
    tier = PLATFORM
    tier = PLATFORM
  ] @[..50ms]

  /// `persist` has no registry row at all, on any site.
  command unknown(level: Level) [
    persist
    frobnicate = 3
  ] @[..50ms]
}
