// Regex patterns (typl §2.7, §6.2): TYPL-106 for a construct outside the
// language, including groups nested beyond 250 and reversed quantifier bounds
// compared as exact integers; TYPL-220 for an accepted pattern over the
// `regex` crate's size limit.

package diag.ridl

/// Nested counted repetitions over the compiled-size limit.
type NestedCode : string [1..8 match /(([a-z]{1,64}){1,64}){1,64}/]

/// A leading anchor is refused before the later backreference.
const REPEATED_PATTERN = /^(a)\1$/

/// Groups nested beyond the recogniser limit.
const DEEP_PATTERN = /(((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((a)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))/

/// A quantifier with its maximum below its minimum.
const REVERSED_PATTERN = /a{3,2}/
