// Service diagnostics (ridl §14.5, §16.4): RIDL-141 and the composition
// rules RIDL-144 to RIDL-148 here, RIDL-140 across the workspace — the twin
// member republishes `diag.showcase.duplicate`, and its `Published` is the
// second half of the RIDL-147 name collision.

package diag.ridl

interface Published {
  signal speed : Speed @10ms
}

/// The catalog entry the twin member collides with (RIDL-140).
service diag.showcase.duplicate : Published

/// `Sample` is a struct, not an interface, and no inline shape is given.
service diag.showcase.mistyped : Sample

/// Both declare `status`, so `diag.showcase.doors.status` would have two
/// referents (RIDL-144) — flat addressing cannot express that.
interface DoorBlock {
  signal status : Speed @10ms
}

interface HealthBlock {
  signal status : Speed @10ms
}

service diag.showcase.doors : DoorBlock, HealthBlock

/// The same interface listed twice (RIDL-145) — its own code, so the mistake
/// is one diagnostic rather than one RIDL-144 per member.
service diag.showcase.twice : Published, Published

/// A shape re-declared under a service-level `reserved` name (RIDL-146) —
/// RIDL-401 one level up: the tombstone retires `Published` for this service
/// wherever it sits in the list.
service diag.showcase.retired : reserved Published, Published

/// Two shapes with one interface name from different packages (RIDL-147) —
/// RIDL-145 keys on the reference and stays silent, and the members are
/// disjoint so RIDL-144 stays silent too, but a binding separates the ordinal
/// spaces by interface name (ADR-0015 decision 24).
service diag.showcase.collide : Published, diag.twin.Published

/// A service-level tombstone spells an interface name; the numeric spelling
/// lowers to a nameless tombstone no shape can ever match (RIDL-148).
service diag.showcase.numbered : Published, reserved 2
