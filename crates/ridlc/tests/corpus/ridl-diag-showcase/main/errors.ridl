// Error-model diagnostics (ridl §10, §16.3): RIDL-303, RIDL-304, RIDL-307,
// RIDL-308.

package diag.ridl

/// An `error` enum may not name a Stratum 2 contract-error category — the
/// reserved set is `INVALID_VALUE`, `PRECONDITION_FAILED`, `CONTRACT_BROKEN`
/// and `UNKNOWN_INTERACTION`. They are derived by the runtime, never declared
/// as functional failure vocabulary (ridl §10.2).
error enum Categories {
  INVALID_VALUE = 0
  STORAGE_FULL  = 1
}

interface Errors {

  /// A query whose only outcome is failure has no success path.
  query onlyFails(limit: Level): DiagError

  /// Failure flowing toward a provider: the caller has nothing to report.
  command absorb(fault: DiagError)

  /// The inline `T | E` spelling is canonical in return position.
  query paged(limit: Level): NamedResult
}
