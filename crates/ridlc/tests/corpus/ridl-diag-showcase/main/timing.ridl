// Timing diagnostics (ridl §9, §9.2, §16.1): RIDL-100, 101, 102, 103, 108,
// 112.

package diag.ridl

interface Timing {

  /// No `@` annotation — the configured default is applied and reported.
  /// The manifest's `[defaults].timing` is invalid (MANI-009), so the bounds
  /// reported here are the built-in `[100ms..1000ms]`.
  signal untimed : Speed

  /// Lower bound above upper bound.
  signal inverted : Speed @[500ms..100ms]

  /// Zero duration.
  signal zero : Speed @0ms

  /// Equal bounds — a degenerate range, not a strict period (ridl §9.2).
  signal degenerate : Speed @[250ms..250ms]

  /// Strict periodic on an event: an isochronous rate is meaningless for
  /// occurrences.
  event tick : Sample @100ms

  /// Strict periodic on a command — RIDL-103, widened by ADR-0015: a caller
  /// is not isochronous by contract. This drew RIDL-106 until `command` and
  /// `query` admitted the range form.
  command timedCommand() @1s

  /// Nor on a query.
  query timedQuery(): Level @1s

  /// A query with no declared response bound — warned (RIDL-112), never
  /// defaulted: absent means absent in the IR (ADR-0015).
  query unbounded(): Level

  /// `@[20ms..]` declares a call throttle and no response bound, so it warns
  /// exactly as the bare query above does. A missing `min` draws nothing.
  command throttledOnly(level: Level) @[20ms..]
}
