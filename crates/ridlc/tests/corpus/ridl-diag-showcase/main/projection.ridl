// RIDL-149: two names in one scope that collide after the pinned name
// transform (ADR-0016 decision 3). The names differ in source, so RIDL-402
// (the same name declared twice) does not apply — only the projection
// collides, and a target whose namespace is snake_case would carry one
// identifier twice.

package diag.ridl

/// Two members whose projections collide. `parseHTTPResponse` and
/// `parseHttpResponse` both become `parse_http_response`.
interface Projection {
  signal parseHTTPResponse : Ratio @[100ms..1s]
  signal parseHttpResponse : Ratio @[100ms..1s]
}

/// The same collision, reached through a service's inline shape (ridl
/// §14.5) rather than a named `interface`. An inline shape is an interface
/// shape, so RIDL-149 applies to its members too (ADR-0016 decision 4) —
/// see `inline_shape.ridl` for the other per-member checks proved the same
/// way.
service diag.showcase.projection {
  signal parseHTTPResponse : Ratio @[100ms..1s]
  signal parseHttpResponse : Ratio @[100ms..1s]
}

/// Two parameters whose projections collide. Rust would emit one function
/// with two identically named arguments, which does not compile.
interface ProjectionParams {
  command setIt(vinNumber : Ratio, vin_number : Ratio) @[..500ms]
}

/// Two struct fields whose projections collide. `parseHTTPResponse` and
/// `parseHttpResponse` both become `parse_http_response` — the same
/// collision as `Projection` above, one typl declaration kind lower: a
/// struct field is checked by the same rule as an interaction member or a
/// command parameter (ADR-0016 decision 4).
struct ProjectionFields {
  parseHTTPResponse : Ratio
  parseHttpResponse : Ratio
}

// TYPL-215 and RIDL-413: a name declared twice, exactly — not a
// transform-only collision, because the two source names are already the
// same before any transform runs, and RIDL-149's message ("both become …
// under the name transform") would be false of this input (issue #244).
// Both examples still lower; neither check drops the duplicate member.

/// Two struct fields declared under the same name.
struct DuplicateField {
  value : Ratio
  value : Ratio
}

/// Two parameters declared under the same name.
interface DuplicateParams {
  command setBoth(value : Ratio, value : Ratio) @[..500ms]
}
