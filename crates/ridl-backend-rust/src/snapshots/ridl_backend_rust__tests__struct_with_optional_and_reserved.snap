}
impl ::core::convert::From<Label> for String {
    fn from(value: Label) -> Self {
        value.0
    }
}
#[derive(Debug, Clone, PartialEq)]
pub struct DriverProfile {
    pub name: Label,
    pub speed: Speed,
    pub r#override: Option<Speed>,
}
/// A zero-copy accessor over FlatBuffers bytes `DriverProfile`'s `verify` accepted.
///
/// A scalar, a string, a byte sequence and a nested table are
/// read in place and allocate nothing. A union and a collection
/// are decoded on access instead: a union's arms and a
/// collection's elements have no one view type to hand back.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[allow(deprecated)]
pub struct DriverProfileFbView<'a> {
    buf: &'a [u8],
    table: usize,
}
#[allow(deprecated)]
impl<'a> DriverProfileFbView<'a> {
    /// The verified bytes this view reads.
    pub fn bytes(&self) -> &'a [u8] {
        self.buf
    }
    /// Reads `DriverProfile`'s `name` field in place.
    pub fn name(&self) -> &'a str {
        let __p = ::ridl_rt::flatbuffers::field(self.buf, self.table, 0u16, 4usize)
            .unwrap_or(::core::option::Option::None)
            .unwrap_or(0usize);
        ::ridl_rt::flatbuffers::string(self.buf, __p).unwrap_or("")
    }
    /// Reads `DriverProfile`'s `speed` field in place.
    pub fn speed(&self) -> Speed {
        let __p = ::ridl_rt::flatbuffers::field(self.buf, self.table, 2u16, 4usize)
            .unwrap_or(::core::option::Option::None)
            .unwrap_or(0usize);
        Speed::new_unchecked(
            f64::from(::ridl_rt::flatbuffers::read_f32(self.buf, __p).unwrap_or(0.0f32)),
        )
    }
    /// Reads `DriverProfile`'s `r#override` field in place.
    pub fn r#override(&self) -> Option<Speed> {
        match ::ridl_rt::flatbuffers::field(self.buf, self.table, 3u16, 4usize) {
            ::core::result::Result::Ok(::core::option::Option::Some(__p)) => {
                ::core::option::Option::Some(
                    Speed::new_unchecked(
                        f64::from(
                            ::ridl_rt::flatbuffers::read_f32(self.buf, __p)
                                .unwrap_or(0.0f32),
                        ),
                    ),
                )
            }
            _ => ::core::option::Option::None,
        }
    }
}
/// Writes `DriverProfile` as a FlatBuffers table and returns its position.
#[allow(deprecated)]
fn __ridl_fb_encode_driver_profile(
    value: &DriverProfile,
    builder: &mut ::ridl_rt::flatbuffers::Builder<'_>,
) -> ::core::result::Result<
    ::ridl_rt::flatbuffers::Pos,
    ::ridl_rt::payload::EncodeError,
> {
    let mut __fields = [::ridl_rt::flatbuffers::TableField {
        slot: 0u16,
        offset: 4u16,
        value: ::ridl_rt::flatbuffers::Field::Bool(false),
    }; 3usize];
    let mut __n = 0usize;
    __fields[__n] = ::ridl_rt::flatbuffers::TableField {
        slot: 0u16,
        offset: 4u16,
        value: ::ridl_rt::flatbuffers::Field::Offset(
            builder.push_string(&value.name.get())?,
        ),
    };
    __n += 1;
    __fields[__n] = ::ridl_rt::flatbuffers::TableField {
        slot: 2u16,
        offset: 8u16,
        value: {
            let __s = value.speed;
            ::ridl_rt::flatbuffers::Field::F32(__s.get() as f32)
        },
    };
    __n += 1;
    if let ::core::option::Option::Some(__v) = &value.r#override {
        __fields[__n] = ::ridl_rt::flatbuffers::TableField {
            slot: 3u16,
            offset: 12u16,
            value: {
                let __s = *__v;
                ::ridl_rt::flatbuffers::Field::F32(__s.get() as f32)
            },
        };
        __n += 1;
    }
    builder.push_table(16usize, 4usize, 4u16, &__fields[..__n])
}
/// Checks the FlatBuffers table at `table` against `DriverProfile`'s shape.
///
/// **The typl constraints of a named scalar are not checked
/// here yet.** The structure is checked in full, and so are an
/// enum and an enum-set discriminant and a collection's declared
/// element count. A named scalar's range, length and pattern are
/// not: checking them over a borrow needs the `check` beside
/// `new` that story E11.7 stage K6 adds. Until it lands, bytes
/// this function accepts can hold a named scalar outside its
/// declared bound.
#[allow(deprecated)]
fn __ridl_fb_verify_driver_profile(
    buf: &[u8],
    table: usize,
) -> ::core::result::Result<(), ::ridl_rt::payload::VerifyError> {
    match ::ridl_rt::flatbuffers::field(buf, table, 0u16, 4usize)
        .map_err(::ridl_rt::payload::VerifyError::Structure)?
    {
        ::core::option::Option::Some(__p) => {
            ::ridl_rt::flatbuffers::string(buf, __p)
                .map_err(::ridl_rt::payload::VerifyError::Structure)?;
        }
        ::core::option::Option::None => {
            return ::core::result::Result::Err(
                ::ridl_rt::payload::VerifyError::Structure(
                    ::ridl_rt::payload::Malformed::MissingRequired,
                ),
            );
        }
    }
    match ::ridl_rt::flatbuffers::field(buf, table, 2u16, 4usize)
        .map_err(::ridl_rt::payload::VerifyError::Structure)?
    {
        ::core::option::Option::Some(__p) => {
            ::ridl_rt::flatbuffers::read_f32(buf, __p)
                .map_err(::ridl_rt::payload::VerifyError::Structure)?;
        }
        ::core::option::Option::None => {
            return ::core::result::Result::Err(
                ::ridl_rt::payload::VerifyError::Structure(
                    ::ridl_rt::payload::Malformed::MissingRequired,
                ),
            );
        }
    }
    match ::ridl_rt::flatbuffers::field(buf, table, 3u16, 4usize)
        .map_err(::ridl_rt::payload::VerifyError::Structure)?
    {
        ::core::option::Option::Some(__p) => {
            ::ridl_rt::flatbuffers::read_f32(buf, __p)
                .map_err(::ridl_rt::payload::VerifyError::Structure)?;
        }
        ::core::option::Option::None => {}
    }
    ::core::result::Result::Ok(())
}
/// Builds `DriverProfile` from the FlatBuffers table at `table`.
///
/// It cannot fail. A read that could is discharged with the
/// neutral value of its own type — zero, the empty string or
/// collection, the first declared enum variant — and `verify` is
/// what makes those branches unreachable.
///
/// **A named scalar is built with its unchecked constructor over
/// a value `verify` has not range-checked**, because `verify`
/// does not check one yet — story E11.7 stage K6 adds that. Until
/// it lands, a hostile buffer yields a value outside its declared
/// typl bound through a safe call.
#[allow(deprecated)]
fn __ridl_fb_decode_driver_profile(buf: &[u8], table: usize) -> DriverProfile {
    DriverProfile {
        name: {
            let __p = ::ridl_rt::flatbuffers::field(buf, table, 0u16, 4usize)
                .unwrap_or(::core::option::Option::None)
                .unwrap_or(0usize);
            Label::new_unchecked(
                String::from(::ridl_rt::flatbuffers::string(buf, __p).unwrap_or("")),
            )
        },
        speed: {
            let __p = ::ridl_rt::flatbuffers::field(buf, table, 2u16, 4usize)
                .unwrap_or(::core::option::Option::None)
                .unwrap_or(0usize);
            Speed::new_unchecked(
                f64::from(::ridl_rt::flatbuffers::read_f32(buf, __p).unwrap_or(0.0f32)),
            )
        },
        r#override: match ::ridl_rt::flatbuffers::field(buf, table, 3u16, 4usize) {
            ::core::result::Result::Ok(::core::option::Option::Some(__p)) => {
                ::core::option::Option::Some(
                    Speed::new_unchecked(
                        f64::from(
                            ::ridl_rt::flatbuffers::read_f32(buf, __p).unwrap_or(0.0f32),
                        ),
                    ),
                )
            }
            _ => ::core::option::Option::None,
        },
    }
}
#[allow(deprecated)]
impl ::ridl_rt::payload::Payload<::ridl_rt::encoding::FlatBuffers> for DriverProfile {
    /// The largest FlatBuffers buffer any legal `DriverProfile` encodes to: 1118 bytes.
    ///
    /// `ridl_ir::projection::flatbuffers::max_size` computed it,
    /// which is the one implementation of the bound (design note
