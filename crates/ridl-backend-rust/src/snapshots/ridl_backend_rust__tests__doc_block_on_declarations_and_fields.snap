/// Vehicle speed over ground
///
/// # Rules
///
/// - range 0.0 ..= 250.0
/// - step 0.5
/// - unit km/h
#[derive(Debug, Clone, Copy, PartialEq, PartialOrd)]
#[repr(transparent)]
pub struct Speed(::core::primitive::f64);
impl Speed {
