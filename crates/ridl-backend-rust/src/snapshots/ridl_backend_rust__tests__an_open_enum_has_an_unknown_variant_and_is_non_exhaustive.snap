    fn bytes(&self) -> &'a [::core::primitive::u8] {
        self.buf
    }
}
#[allow(deprecated)]
impl<'a> DtcStatusFbView<'a> {
    /// The value the bytes hold. `DtcStatus` is one value, so this decodes it rather than borrowing it, which costs one read.
    pub fn value(&self) -> DtcStatus {
        __ridl_fb_decode_DtcStatus(self.buf, self.table)
    }
