///A value outside the declared ones is valid and is read as `Unknown`, which holds the integer.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
#[non_exhaustive]
pub enum DtcStatus {
    Inactive,
    Active,
    /// An undeclared value, kept as the integer the wire carried.
    Unknown(UnknownDtcStatus),
}
///An undeclared value of `DtcStatus`: the integer the wire carried, which `raw` reads. Only `From<i64>` for `DtcStatus` builds one, and it builds one for no declared value.
#[derive(Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Debug)]
pub struct UnknownDtcStatus(::core::primitive::i64);
impl UnknownDtcStatus {
    /// The integer the wire carried.
    pub const fn raw(self) -> ::core::primitive::i64 {
        self.0
    }
}
impl ::core::convert::From<::core::primitive::i64> for DtcStatus {
    fn from(value: ::core::primitive::i64) -> Self {
        match value {
            0 => Self::Inactive,
            1 => Self::Active,
            other => Self::Unknown(UnknownDtcStatus(other)),
        }
    }
}
impl ::core::convert::From<DtcStatus> for ::core::primitive::i64 {
    fn from(value: DtcStatus) -> Self {
        match value {
            DtcStatus::Inactive => 0,
            DtcStatus::Active => 1,
            DtcStatus::Unknown(unknown) => unknown.0,
        }
    }
}
#[allow(clippy::derivable_impls)]
impl ::core::default::Default for DtcStatus {
    fn default() -> Self {
        DtcStatus::Inactive
    }
}
