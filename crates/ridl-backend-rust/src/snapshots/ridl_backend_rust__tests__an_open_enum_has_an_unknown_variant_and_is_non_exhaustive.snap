    match ::ridl_rt::flatbuffers::field(buf, table, 0u16, 8usize) {
        ::core::result::Result::Ok(::core::option::Option::Some(__p)) => {
            <DtcStatus as ::core::convert::From<
                ::core::primitive::i64,
            >>::from(::ridl_rt::flatbuffers::read_i64(buf, __p).unwrap_or(0i64))
