/// Vehicle speed over ground
///
/// Quantization (`step`) is not checked by `new`.
#[repr(transparent)]
pub struct Speed(f64);
impl Speed {
    /// Constructs the value, enforcing its typl constraints.
    pub fn new(value: f64) -> Result<Self, ::ridl_rt::payload::Violation> {
        if value < 0.0 {
            return Err(::ridl_rt::payload::Violation {
                type_name: "Speed",
                rule: ::ridl_rt::payload::Rule::Range,
            });
        }
        if value > 250.0 {
            return Err(::ridl_rt::payload::Violation {
                type_name: "Speed",
                rule: ::ridl_rt::payload::Rule::Range,
            });
        }
        Ok(Self(value))
    }
    /// Constructs the value without checking its constraints.
    ///
    /// Safe: nothing here relies on the invariant for memory
    /// soundness. Use it only for a value already known to satisfy
    /// the contract.
    pub const fn new_unchecked(value: f64) -> Self {
        Self(value)
    }
    pub const fn get(self) -> f64 {
        self.0
    }
}
impl TryFrom<f64> for Speed {
    type Error = ::ridl_rt::payload::Violation;
    fn try_from(value: f64) -> Result<Self, Self::Error> {
        Self::new(value)
    }
}
impl From<Speed> for f64 {
    fn from(value: Speed) -> Self {
        value.0
    }
}
impl Default for Speed {
    fn default() -> Self {
        Speed::new_unchecked(0.0)
    }
}
pub const MAX_SPEED: Speed = Speed::new_unchecked(250.0);
pub const MAX_GEAR: i64 = 6;
#[repr(transparent)]
pub struct Greeting(String);
impl Greeting {
    /// Constructs the value, enforcing its typl constraints.
    pub fn new(value: String) -> Result<Self, ::ridl_rt::payload::Violation> {
        Ok(Self(value))
    }
    /// Constructs the value without checking its constraints.
    ///
    /// Safe: nothing here relies on the invariant for memory
    /// soundness. Use it only for a value already known to satisfy
    /// the contract.
    pub const fn new_unchecked(value: String) -> Self {
        Self(value)
    }
    pub fn get(&self) -> &str {
        &self.0
    }
    pub fn into_inner(self) -> String {
        self.0
    }
}
impl TryFrom<String> for Greeting {
    type Error = ::ridl_rt::payload::Violation;
    fn try_from(value: String) -> Result<Self, Self::Error> {
        Self::new(value)
    }
}
impl From<Greeting> for String {
    fn from(value: Greeting) -> Self {
        value.0
    }
}
impl Default for Greeting {
    fn default() -> Self {
        Greeting::new_unchecked(String::new())
    }
}
pub const BANNER: &str = "hello";
pub const VIN_PATTERN: &str = "^[A-HJ-NPR-Z0-9]{17}$";
