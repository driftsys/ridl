                let __factor: ::core::primitive::f64 = 1f64;
                let __original_step: ::core::primitive::f64 = 0.5f64;
                let __step: ::core::primitive::f64 = 0.5f64;
                let __step_low: ::core::primitive::f64 = 0f64;
                let __phase: ::core::primitive::f64 = 0f64;
                let __phase_low: ::core::primitive::f64 = 0f64;
