/// Vehicle speed over ground
///
/// # Rules
///
/// - range 0.0 ..= 250.0
/// - step 0.5
/// - unit km/h
#[derive(Debug, Clone, Copy, PartialEq, PartialOrd)]
#[repr(transparent)]
pub struct Speed(::core::primitive::f64);
impl Speed {
    /// Constructs the value, enforcing its typl constraints.
    pub fn new(
        value: ::core::primitive::f64,
