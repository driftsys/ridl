package veh.docs

/// A temperature.
type Temperature: integer [0..100]

/// The horn.
interface Horn {
  /// The active state.
  signal active: Temperature @10ms
}

/// Same module [Temperature]; explicit member [Horn.active].
struct Reading {
  /// Field [Temperature].
  value: Temperature
}

/// Module [Temperature].
interface Climate {
  /// Nested [Temperature].
  query read(
    /// Query parameter [Temperature].
    window: Temperature
  ): Temperature @[..1s]
  /// Sets the temperature.
  command set(
    /// Command parameter [Temperature].
    target: Temperature
  ) @[..1s]
}
