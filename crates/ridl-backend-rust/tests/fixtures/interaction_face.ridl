// The interaction-face MVP fixture (docs/design/interaction-face.md; the
// approved design is docs/archive/2026-09-16-interaction-face-v0-design.md §7).
// A single-file, single-catalog package kept to the shapes the hand-written
// payload stand-in could carry when it was written: fixed-width named scalars,
// one enum, and one struct whose fields are all fixed size. No optional field,
// no sequence, no map, no union, no string, no bytes. The stand-in is gone and
// the generated codec carries every typl shape; the fixture stays small because
// the round trips need no more.
//
// Kept self-contained (no cross-package import), because the compile path this
// fixture is read through (`ridlc::compile`) wraps one file as a single-file
// synthetic package.

package face.demo

// ---------- Named scalars (all integer-backed, fixed width) ----------

/// Cabin temperature, in degrees.
type Temperature : integer [-40..85]

/// A control level.
type Level : integer [0..100]

/// A window length, in samples.
type Window : integer [0..100000]

/// An averaged reading.
type Average : integer [0..1000]

// ---------- Enum ----------

enum Health {
  OK   = 0
  WARN = 1
  FAIL = 2
}

// ---------- Struct (all fields fixed size) ----------

struct Warning {
  code   : Level
  health : Health
}

// ---------- The interface the round trip runs against ----------

// The interface and its members carry doc comments, a link, an `@see` and an
// `@since`, which the face renders on its module and its methods.

/// The cabin climate controller. It publishes the cabin [Temperature] and
/// takes a control [Level].
/// @see Horn
/// @since 1.0
interface Cabin {
  /// The cabin temperature, read from [Cabin.average]'s source sensor.
  signal  temperature : Temperature @10ms
  /// A warning the controller raises.
  event   warning      : Warning @[100ms..1s]
  /// Sets the control level.
  command setLevel(
    /// The level to hold.
    level: Level
  ) @[..50ms] [
    require level < 100
  ]
  /// The average cabin temperature over a window of samples.
  /// @since 1.1
  query   average(window: Window): Average @[..200ms] [
    require window > 0
    ensure  result >= 0
  ]
}

// ---------- A signal-only interface, for the port-bound test ----------

interface Horn {
  signal active : Health @10ms
}

// ---------- An event-only interface, for the port-bound test ----------
//
// Its `Client` is bound on `EventSource` and `Wakeable` and on nothing else:
// `Wakeable` because `next_event` returns a future that waits on the event
// queue, and no `Clock`, because an event has no response bound (the async
// face design, note F-10). Named to sort after `Horn`: provisional interface
// numbers follow the sorted names, and the descriptor tests pin `Cabin` as 1
// and `Horn` as 2.

interface Siren {
  event tripped : Warning @[100ms..1s]
}

// ------ A calls-only interface with no written timing, for two tests ------
//
// Its `Client` is bound on `Caller`, `Clock` and `Wakeable` and on nothing
// else. Neither call writes a timing annotation, so each takes the built-in
// default response bound for its kind (ridl §9.3): 1 s for `open` and 3 s for
// `pressure`. Named to sort after `Siren`, for the reason `Siren` gives.

interface Valve {
  command open(level: Level)
  query pressure(window: Window): Average
}

// ------ An interface with a fixed before a signal, for the size table ------
//
// A `fixed` is provisioned, never in flight, so its row of the size table is
// 0; the signal after it keeps its own row, so a table that dropped the
// fixed's row would shift the signal's. Named to sort after `Valve`, for the
// reason `Siren` gives.

interface Wiper {
  fixed  blades : Level
  signal speed  : Level @10ms
}

// ------ An interface with deprecated members, for the deprecation guard ------
//
// The face marks each deprecated member's client methods, and a call's
// `Provider` method, `#[deprecated]`, and every generated item that calls one
// of them allows the lint, so the include site in `tests/interaction_face.rs`
// compiles under `deny(deprecated)`. The three members pin the three sites
// that allow it: the blocking client's signal read, the blocking client's
// call, and `dispatch`, once for a command and once for a query. No test calls
// them. Named to sort after `Wiper`, for the reason `Siren` gives.

interface Zone {
  /// The zone level.
  /// @deprecated "use Cabin.temperature"
  signal level : Level @10ms
  /// Sets the zone level.
  /// @deprecated "use Cabin.setLevel"
  command setLevel(level: Level)
  /// The average zone level over a window of samples.
  /// @deprecated "use Cabin.average"
  query average(window: Window): Average
}

// ------ An interface carrying bounded collections, for the encode check ------
//
// A bounded list and a bounded map are plain public fields, so a provider can
// hold a value longer than the declared bound. Each sits in a payload of its
// own, as that payload's first field, so a value refused by the encoder is
// refused before anything is written to the output buffer. `Log.note` is
// never set by a test; it is there so that `Log`'s `MAX_SIZE` provisions a
// string, which leaves room for a list one element longer than its bound to
// encode within `MAX_SIZE`. `Tally` needs no such field: its map's declared
// maximum provisions three sixteen-character keys. The signal, the command
// and the two queries reach the three sites that encode a payload: the
// publisher's setter, a client's send, and `dispatch`'s reply. Named to sort
// after `Zone`, for the reason `Siren` gives. `Log.samples` holds `Window`
// rather than `Level` because a vector of a one-byte element makes the codec
// emit `__c.len() * 1usize`, which `clippy::identity_op` refuses in this
// crate's own test build.

/// A tag on a log entry.
type Tag : string [1..16]

/// A log of recent levels.
struct Log {
  samples : [Window; 2..8]
  note    : Tag?
}

/// A count of levels by tag.
struct Tally {
  entries : [Tag : Level; 0..3]
}

interface ZoneLog {
  signal  recent : Log @10ms
  command record(entry: Log)
  query   recall(window: Window): Log @[..200ms]
  query   tally(window: Window): Tally @[..200ms]
}
