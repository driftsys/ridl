// Two events whose payloads differ in what they can derive, for the rule the
// `Event` enum follows (driftsys/ridl#486): it derives `Debug` always, and
// `Clone`, `Copy`, `PartialEq` and `Eq` when every payload it carries derives
// all four.
//
// `Reading` is a struct of one integer-backed named scalar, so it derives all
// four. `Note` holds a string-backed named scalar, which is not `Copy`, so it
// derives fewer. Each payload is carried by an interface of its own, so that
// each `Event` enum states one answer.

package face.events

/// A control level.
type Level : integer [0..100]

/// A tag on a note.
type Tag : string [1..16]

/// A reading of the control level.
struct Reading {
  level : Level
}

/// A note a controller raises.
struct Note {
  tag : Tag
}

/// A controller whose event payload derives everything.
interface Plain {
  /// The level changed.
  event changed : Reading @[100ms..1s]
}

/// A controller whose event payload does not derive `Copy`.
interface Noted {
  /// A note was raised.
  event logged : Note @[100ms..1s]
}
