// A package with two interfaces under proto3: `Probe` has one member whose
// payload has no proto3 bound — the argument message of `set`, which holds
// two `Big` strings whose sum does not fit a u32 bound — beside two members
// whose payloads are bounded; `Gauge` has bounded payloads only. `Probe` gets
// a `Bounds<Proto3>` with no bound in the row of `set` and no `Sizes<Proto3>`;
// `Gauge` gets a `Sizes<Proto3>`.

package pb.unbounded.face

type Count : integer [0..200]

type Big : string [0..1000000000]

interface Probe {
  signal count : Count @10ms
  command set(first: Big, second: Big) @[..50ms]
  query fetch(count: Count): Count @[..50ms]
}

interface Gauge {
  signal count : Count @10ms
}
