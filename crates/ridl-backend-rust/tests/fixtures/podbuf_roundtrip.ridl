// The podbuf encoder fixture.
//
// One declaration per shape whose bytes the encoder test pins against the
// first-fit law: a head of two bytes padded to eight, a descriptor with pads
// around it and a field pushed past it, an optional field with its flags
// byte, an array of struct heads with their strings after the block, a map
// whose entries are sorted by key, and a deprecated field written as its init
// value. The measured layouts are the worked examples of the design.
//
// Kept self-contained, with no cross-package import: the compile path this
// fixture is read through (`ridlc::compile`) wraps one file as a single-file
// synthetic package.

package podbuf.demo

/// A map key.
type Name : string [0..16]

/// A map value.
type Weight : integer [0..255]

/// Two bytes: `sensorId` at 0, `isOpen` at 1, pad 2..8.
struct DoorPayload {
  sensorId : integer [0..15]
  isOpen   : boolean
}

/// `code` at 0, pad 2..4, the descriptor of `message` at 4..12, pad 12..16,
/// `timestamp` at 16..24: the descriptor keeps `timestamp` out of 8..16.
struct FaultEvent {
  code      : integer [0..65535]
  message   : string [0..256]
  timestamp : integer [-9223372036854775808..9223372036854775807]
}

/// `severity` at 0, the flags byte at 1, pad 2..4, the descriptor of
/// `category` at 4..12, pad 12..16.
struct DiagFilter {
  severity : integer [0..255]
  category : string [0..32]?
}

/// One descriptor at 0..8 with an element size of 24, the size of a
/// `FaultEvent` head.
struct FaultPage {
  faults : [FaultEvent; 0..64]
}

/// One descriptor at 0..8 to entries of `{ key, value }`, sorted by key.
struct Labels {
  byName : [Name : Weight; 0..8]
}

/// A deprecated field: the encoder writes its init value, 5, whatever the
/// domain value holds.
struct Legacy {
  /// The retired field.
  /// @deprecated "no longer read"
  legacy : integer [1..9] = 5
}

/// An enum, one byte wide.
enum Health {
  OK   = 0
  WARN = 1
  FAIL = 2
}

/// A union: the tag at 0, the arm descriptor at 4..12, pad 1..4 and 12..16.
/// `ok` writes a `DoorPayload` head; `bad` writes a one-field head.
union Outcome {
  ok  : DoorPayload
  bad : Health
}

/// `door` at 0..8 (an inline head, at alignment 8), `health` at 8,
/// `readings` at 10..14 (a later small field fills the gap), `span` at
/// 16..24 (a tuple is an inline struct rounded to 8); pads 9..10 and 14..16.
struct Nested {
  door     : DoorPayload
  health   : Health
  span     : (lo: integer [0..15], hi: integer [0..65535])
  readings : [integer [0..65535]; 2]
}

/// Three tail-writing fields in declaration order, so the tail order and
/// the alignment of each block are visible: the string's bytes first, then
/// the block of 64-bit integers at alignment 8, then the block of
/// `FaultEvent` heads at alignment 8 with its elements' strings after it.
struct Ordered {
  label  : string [0..16]
  xs     : [integer [-9223372036854775808..9223372036854775807]; 0..4]
  faults : [FaultEvent; 0..4]
}

/// A string before a map: the entry block starts at alignment 8.
struct Keyed {
  label  : string [0..16]
  byName : [Name : Weight; 0..8]
}

/// A string before an inline union: the arm's head starts at alignment 8.
struct Wrapped {
  label   : string [0..16]
  outcome : Outcome
}

/// A map keyed by a float: a NaN key is refused, and `0.0` and `-0.0` are
/// one key.
struct Scored {
  byScore : [float : Weight; 0..8]
}

/// A strict enum, one byte wide.
enum GearPosition {
  PARK    = 0
  REVERSE = 1
  NEUTRAL = 2
  DRIVE   = 3
}

/// Three declared bits, so bit 7 is undeclared.
enumset WarningFlags {
  LOW_FUEL    = 0
  LOW_OIL     = 1
  DOOR_AJAR   = 2
}

/// A strict enum at head offset 0.
struct Shifter {
  gear : GearPosition
}

/// An enum set at head offset 0.
struct Warnings {
  flags : WarningFlags
}

/// Two descriptors, at 0..8 and 8..16.
struct TwoStrings {
  a : string [0..8]
  b : string [0..8]
}

/// A string bounded at two scalar values: at most eight bytes on the wire.
struct Short2 {
  s : string [0..2]
}

/// An array of two-byte scalars: the stride is the element size, exactly.
struct Readings {
  xs : [integer [0..65535]; 0..8]
}

/// A struct with no field: a head of size 0.
struct Empty {}

/// A union whose first arm has an empty head.
union Maybe {
  none : Empty
  some : DoorPayload
}

/// A float with no range: any bit pattern is a value.
struct FreeFloat {
  x : float
}

/// Exact-length bytes: four bytes inline at offset 0.
struct Digest {
  hash : bytes [4]
}

/// Bounded bytes, and a required array of at least one element.
struct Blob {
  data  : bytes [0..8]
  marks : [integer [0..255]; 1..4]
}

/// A constrained map value.
type Score : integer [0..100]

/// An eight-byte integer first, then a constrained byte at 8: a 16-byte
/// head whose second half holds the constrained field, so a producer that
/// wrote only the first half leaves that field past its size.
struct Tall {
  big   : integer [-9223372036854775808..9223372036854775807]
  small : integer [0..15]
}

/// An array of `Tall` heads: the stride is 16.
struct Talls {
  items : [Tall; 0..4]
}

/// A map whose value is constrained below its byte width.
struct Ranked {
  byName : [Name : Score; 0..8]
}
