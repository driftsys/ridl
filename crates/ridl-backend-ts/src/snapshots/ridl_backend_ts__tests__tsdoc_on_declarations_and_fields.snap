import * as $rt from '@driftsys/ridl-runtime';

/**
 * Vehicle speed over ground
 *
 * Build a value with `makeSpeed`.
 *
 * @remarks
 * Rules:
 * - range 0.0 ..= 250.0
 * - step 0.5
 * - unit km/h
 *
 * @unit km/h
 * @range [0.0..250.0 step 0.5]
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

/** Builds a `Speed`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeSpeed(value: number): Speed {
  if (!globalThis.Number.isFinite(value)) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value < 0.0) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value > 250.0) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if ($rt.offFloatStep(value, true, [1.0, 0.5, 0.5, 0.0, 0.0, 0.0])) {
    throw new $rt.ConstraintError('step', 'veh.common.Speed', value, 'step 0.5 from 0.0');
  }
  return value as Speed;
}

/** Builds a `Speed` without checking a value already known to satisfy its constraints. */
export function makeSpeedUnchecked(value: number): Speed {
  return value as Speed;
}

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

/**
 * Build a value with `makeVin`.
 *
 * @remarks
 * Rules:
 * - length 17
 * - pattern `/[A-HJ-NPR-Z0-9]{17}/`
 */
export type Vin = string & { readonly __ridl: 'veh.common.Vin' };

const __ridlPatternVin = new globalThis.RegExp('[A-HJ-NPR-Z0-9]{17}');

/** Builds a `Vin`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeVin(value: string): Vin {
  if (!$rt.isWellFormedString(value)) {
    throw new $rt.ConstraintError('utf8', 'veh.common.Vin', value, 'well-formed text');
  }
  if ($rt.codePointLength(value) < 17) {
    throw new $rt.ConstraintError('length', 'veh.common.Vin', value, '[17..17]');
  }
  if ($rt.codePointLength(value) > 17) {
    throw new $rt.ConstraintError('length', 'veh.common.Vin', value, '[17..17]');
  }
  if (!__ridlPatternVin.test(value)) {
    throw new $rt.ConstraintError('pattern', 'veh.common.Vin', value, '/[A-HJ-NPR-Z0-9]{17}/');
  }
  return value as Vin;
}

/** Builds a `Vin` without checking a value already known to satisfy its constraints. */
export function makeVinUnchecked(value: string): Vin {
  return value as Vin;
}

type Hidden = number & { readonly __ridl: 'veh.common.Hidden' };

function initHidden(): Hidden {
  return 0 as Hidden;
}

/**
 * Combines {@link Speed} and {@link Reading.speed}, from `other.pkg.Thing`, `veh.common.Hidden` and `veh.common.BLOB`.
 *
 * @see {@link Speed}
 * @see `other.pkg.Thing`
 * @since 0.3
 * @since 0.4
 * @deprecated use Frame
 */
export interface Reading {
  /**
   * The speed of this reading.
   *
   * @remarks
   * Rules:
   * - range 0.0 ..= 250.0
   * - step 0.5
   * - unit km/h
   *
   * @see {@link Vin}
   * @since 0.2
   */
  speed: Speed;
  /**
   * The raw samples.
   *
   * @remarks
   * Rules:
   * - count 1 ..= 8
   *
   * @bounds 1..8
   */
  samples: readonly Speed[];
  /**
   * @remarks
   * Rules:
   * - length 17
   * - pattern `/[A-HJ-NPR-Z0-9]{17}/`
   *
   * @deprecated use the frame number
   */
  vin: Vin;
}
