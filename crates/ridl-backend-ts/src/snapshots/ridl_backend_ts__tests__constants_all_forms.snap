import * as $rt from '@driftsys/ridl-runtime';

/**
 * Vehicle speed over ground
 *
 * Build a value with `makeSpeed`.
 *
 * @remarks
 * Rules:
 * - range 0.0 ..= 250.0
 * - step 0.5
 * - unit km/h
 *
 * @unit km/h
 * @range [0.0..250.0 step 0.5]
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

/** Builds a `Speed`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeSpeed(value: number): Speed {
  if (!globalThis.Number.isFinite(value)) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value < 0.0) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value > 250.0) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if ($rt.offFloatStep(value, true, [1.0, 0.5, 0.5, 0.0, 0.0, 0.0])) {
    throw new $rt.ConstraintError('step', 'veh.common.Speed', value, 'step 0.5 from 0.0');
  }
  return value as Speed;
}

/** Builds a `Speed` without checking a value already known to satisfy its constraints. */
export function makeSpeedUnchecked(value: number): Speed {
  return value as Speed;
}

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

export const MAX_SPEED = 250.0;

export const MAX_GEAR = 6;

/**
 * Build a value with `makeOdometer`.
 *
 * @remarks
 * Rules:
 * - range 0 ..= 18446744073709551615
 *
 * @range [0..18446744073709551615]
 */
export type Odometer = bigint & { readonly __ridl: 'veh.common.Odometer' };

/** Builds a `Odometer`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeOdometer(value: bigint): Odometer {
  if (value < 0n) {
    throw new $rt.ConstraintError('range', 'veh.common.Odometer', value, '[0..9223372036854775807]');
  }
  if (value > 9223372036854775807n) {
    throw new $rt.ConstraintError('range', 'veh.common.Odometer', value, '[0..9223372036854775807]');
  }
  return value as Odometer;
}

/** Builds a `Odometer` without checking a value already known to satisfy its constraints. */
export function makeOdometerUnchecked(value: bigint): Odometer {
  return value as Odometer;
}

export function initOdometer(): Odometer {
  return 0n as Odometer;
}

export const MAX_ODOMETER = 18446744073709551615n;

/**
 * Build a value with `makeGreeting`.
 */
export type Greeting = string & { readonly __ridl: 'veh.common.Greeting' };

/** Builds a `Greeting`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeGreeting(value: string): Greeting {
  if (!$rt.isWellFormedString(value)) {
    throw new $rt.ConstraintError('utf8', 'veh.common.Greeting', value, 'well-formed text');
  }
  return value as Greeting;
}

/** Builds a `Greeting` without checking a value already known to satisfy its constraints. */
export function makeGreetingUnchecked(value: string): Greeting {
  return value as Greeting;
}

export function initGreeting(): Greeting {
  return '' as Greeting;
}

export const BANNER = 'hello' as const;

export const VIN_PATTERN = '^[A-HJ-NPR-Z0-9]{17}$' as const;
