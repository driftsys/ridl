import { ConstraintError } from '@driftsys/ridl-runtime';

/**
 * Build a value with `makeValue`.
 *
 * @remarks
 * Rules:
 * - range -1.5 ..= 2.5
 *
 * @range [-1.5..2.5]
 */
export type Value = number & { readonly __ridl: 'test.ctor.Value' };

/** Builds a `Value`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeValue(value: number): Value {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'test.ctor.Value', value, '[-1.5..2.5]');
  }
  if (value < -1.5) {
    throw new ConstraintError('range', 'test.ctor.Value', value, '[-1.5..2.5]');
  }
  if (value > 2.5) {
    throw new ConstraintError('range', 'test.ctor.Value', value, '[-1.5..2.5]');
  }
  return value as Value;
}

/** Builds a `Value` without checking a value already known to satisfy its constraints. */
export function makeValueUnchecked(value: number): Value {
  return value as Value;
}
