export type WideFlags = bigint & { readonly __ridl: 'veh.common.WideFlags' };

export const WideFlagsBits = {
  LOW: 1n,
  TOP: 9223372036854775808n,
  /** The bits of `value` that no bit of this set declares. */
  unknownBits(value: WideFlags): WideFlags {
    return BigInt.asIntN(64, value & ~9223372036854775809n) as WideFlags;
  },
} as const;

export function initWideFlags(): WideFlags {
  return 0n as WideFlags;
}
