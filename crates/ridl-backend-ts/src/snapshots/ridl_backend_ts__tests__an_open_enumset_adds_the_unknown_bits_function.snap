export type Flags = number & { readonly __ridl: 'veh.common.Flags' };

export const FlagsBits = {
  A: 1,
  B: 2,
  /** The bits of `value` that no bit of this set declares. */
  unknownBits(value: Flags): Flags {
    return ((value & ~3) >>> 0) as Flags;
  },
} as const;

export function initFlags(): Flags {
  return 0 as Flags;
}
