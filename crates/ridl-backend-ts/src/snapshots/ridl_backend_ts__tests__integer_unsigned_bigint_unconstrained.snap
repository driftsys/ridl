import * as $rt from '@driftsys/ridl-runtime';

/**
 * Build a value with `makeValue`.
 */
export type Value = bigint & { readonly __ridl: 'test.ctor.Value' };

/** Builds a `Value`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeValue(value: bigint): Value {
  if (value < 0n) {
    throw new $rt.ConstraintError('range', 'test.ctor.Value', value, '[0..9223372036854775807]');
  }
  if (value > 9223372036854775807n) {
    throw new $rt.ConstraintError('range', 'test.ctor.Value', value, '[0..9223372036854775807]');
  }
  return value as Value;
}

/** Builds a `Value` without checking a value already known to satisfy its constraints. */
export function makeValueUnchecked(value: bigint): Value {
  return value as Value;
}
