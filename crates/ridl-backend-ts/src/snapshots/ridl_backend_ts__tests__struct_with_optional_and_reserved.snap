/**
 * Vehicle speed over ground
 *
 * @remarks
 * Rules:
 * - range 0.0 ..= 250.0
 * - step 0.5
 * - unit km/h
 *
 * @unit km/h
 * @range [0.0..250.0 step 0.5]
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

export type Label = string & { readonly __ridl: 'veh.common.Label' };

export interface DriverProfile {
  name: Label;
  /**
   * @remarks
   * Rules:
   * - range 0.0 ..= 250.0
   * - step 0.5
   * - unit km/h
   */
  speed: Speed;
  /**
   * @remarks
   * Rules:
   * - range 0.0 ..= 250.0
   * - step 0.5
   * - unit km/h
   */
  override?: Speed;
}
