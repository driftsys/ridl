import { ConstraintError, codePointLength } from '@driftsys/ridl-runtime';

/**
 * Build a value with `makeHidden`.
 *
 * @remarks
 * Rules:
 * - length ..= 4
 * - pattern `/x/`
 */
type Hidden = string & { readonly __ridl: 'veh.common.Hidden' };

const __ridlPatternHidden = new globalThis.RegExp('x');

/** Builds a `Hidden`. Throws a `ConstraintError` when a checked constraint is broken. */
function makeHidden(value: string): Hidden {
  if (codePointLength(value) > 4) {
    throw new ConstraintError('length', 'veh.common.Hidden', value, '[..4]');
  }
  if (!__ridlPatternHidden.test(value)) {
    throw new ConstraintError('pattern', 'veh.common.Hidden', value, '/x/');
  }
  return value as Hidden;
}

/** Builds a `Hidden` without checking a value already known to satisfy its constraints. */
function makeHiddenUnchecked(value: string): Hidden {
  return value as Hidden;
}
