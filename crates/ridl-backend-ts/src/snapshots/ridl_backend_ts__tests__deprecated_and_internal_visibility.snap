import { ConstraintError } from '@driftsys/ridl-runtime';

/**
 * Vehicle speed over ground
 *
 * Build a value with `makeSpeed`.
 *
 * @remarks
 * Rules:
 * - range 0.0 ..= 250.0
 * - step 0.5
 * - unit km/h
 *
 * @unit km/h
 * @range [0.0..250.0 step 0.5]
 * @deprecated use Velocity
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

/** Builds a `Speed`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeSpeed(value: number): Speed {
  if (!globalThis.Number.isFinite(value)) {
    throw new ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value < 0.0) {
    throw new ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value > 250.0) {
    throw new ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  return value as Speed;
}

/** Builds a `Speed` without checking a value already known to satisfy its constraints. */
export function makeSpeedUnchecked(value: number): Speed {
  return value as Speed;
}

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

/**
 * Build a value with `makeOldFlag`.
 *
 * @deprecated
 */
export type OldFlag = boolean & { readonly __ridl: 'veh.common.OldFlag' };

/** Builds a `OldFlag`. */
export function makeOldFlag(value: boolean): OldFlag {
  return value as OldFlag;
}

export function initOldFlag(): OldFlag {
  return false as OldFlag;
}

/**
 * Build a value with `makeRawTicks`.
 */
type RawTicks = number & { readonly __ridl: 'veh.common.RawTicks' };

/** Builds a `RawTicks`. Throws a `ConstraintError` when a checked constraint is broken. */
function makeRawTicks(value: number): RawTicks {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new ConstraintError('range', 'veh.common.RawTicks', value, 'a safe integer');
  }
  return value as RawTicks;
}

/** Builds a `RawTicks` without checking a value already known to satisfy its constraints. */
function makeRawTicksUnchecked(value: number): RawTicks {
  return value as RawTicks;
}

function initRawTicks(): RawTicks {
  return 0 as RawTicks;
}
