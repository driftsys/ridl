import * as $rt from '@driftsys/ridl-runtime';

/**
 * Vehicle speed over ground
 *
 * Build a value with `makeSpeed`.
 *
 * @remarks
 * Rules:
 * - range 0.0 ..= 250.0
 * - step 0.5
 * - unit km/h
 *
 * @unit km/h
 * @range [0.0..250.0 step 0.5]
 */
export type Speed = number & { readonly __ridl: 'veh.common.Speed' };

/** Builds a `Speed`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeSpeed(value: number): Speed {
  if (!globalThis.Number.isFinite(value)) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value < 0.0) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if (value > 250.0) {
    throw new $rt.ConstraintError('range', 'veh.common.Speed', value, '[0.0..250.0]');
  }
  if ($rt.offFloatStep(value, true, [1.0, 0.5, 0.5, 0.0, 0.0, 0.0])) {
    throw new $rt.ConstraintError('step', 'veh.common.Speed', value, 'step 0.5 from 0.0');
  }
  return value as Speed;
}

/** Builds a `Speed` without checking a value already known to satisfy its constraints. */
export function makeSpeedUnchecked(value: number): Speed {
  return value as Speed;
}

export function initSpeed(): Speed {
  return 0.0 as Speed;
}

/**
 * Build a value with `makeCounter`.
 */
export type Counter = number & { readonly __ridl: 'veh.common.Counter' };

/** Builds a `Counter`. Throws a `ConstraintError` when a checked constraint is broken. */
export function makeCounter(value: number): Counter {
  if (!globalThis.Number.isSafeInteger(value)) {
    throw new $rt.ConstraintError('range', 'veh.common.Counter', value, 'a safe integer');
  }
  return value as Counter;
}

/** Builds a `Counter` without checking a value already known to satisfy its constraints. */
export function makeCounterUnchecked(value: number): Counter {
  return value as Counter;
}

export function initCounter(): Counter {
  return 0 as Counter;
}

export interface SensorReading {
  /**
   * @remarks
   * Rules:
   * - range 0.0 ..= 250.0
   * - step 0.5
   * - unit km/h
   */
  value: Speed;
}

export function initSensorReading(): SensorReading {
  return {
    value: initSpeed(),
  };
}

export interface SensorFault {
  code: Counter;
}

export function initSensorFault(): SensorFault {
  return {
    code: initCounter(),
  };
}

export type SensorResult =
  /**
   * Successful reading
   */
  | { kind: 'ok'; value: SensorReading }
  | { kind: 'err'; value: SensorFault };

export function initSensorResult(): SensorResult {
  return { kind: 'ok', value: initSensorReading() };
}
