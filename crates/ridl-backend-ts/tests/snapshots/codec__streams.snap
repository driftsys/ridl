/** Encodes a `streams.demo.Count` payload. */
export function encodeCount(value: t.Count): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.CountBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `streams.demo.Count` payload the codec has verified. */
export function decodeCount(bytes: Uint8Array): t.Count {
  return t.makeCountUnchecked(fb.CountBox.getRootAsCountBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

