/** Encodes a `streams.demo.Count` payload. */
export function encodeCount(value: t.Count): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.CountBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `streams.demo.Count` payload the codec has verified. */
export function decodeCount(bytes: Uint8Array): t.Count {
  return fb.CountBox.getRootAsCountBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as t.Count;
}

/** Encodes a `streams.demo.Data` payload. */
export function encodeData(value: t.Data): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.DataBoxT(Array.from(value)).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `streams.demo.Data` payload the codec has verified. */
export function decodeData(bytes: Uint8Array): t.Data {
  return Uint8Array.from(fb.DataBox.getRootAsDataBox(new flatbuffers.ByteBuffer(bytes)).unpack().value) as t.Data;
}

/** Encodes a `streams.demo.Text` payload. */
