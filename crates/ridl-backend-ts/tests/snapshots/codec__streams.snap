  zero: { iface: 1, ord: 10, kind: "query", request: codecFeedZeroParams, streams: [{ no: 0, form: "bytes" }], limit: 64 },
  latest: { iface: 1, ord: 11, kind: "query", request: codecFeedLatestParams, reply: codecCount },
  upload: { iface: 1, ord: 12, kind: "command", request: codecFeedUploadParams, streams: [{ no: 1, form: "bytes" }], limit: 64 },
  duplex: { iface: 1, ord: 13, kind: "query", request: codecFeedDuplexParams, streams: [{ no: 0, form: "elements", element: codecChunk }, { no: 1, form: "bytes" }] },
  duplexNamed: { iface: 1, ord: 14, kind: "query", request: codecFeedDuplexNamedParams, streams: [{ no: 0, form: "elements", element: codecChunk }, { no: 1, form: "elements", element: codecChunk }] },
  duplexText: { iface: 1, ord: 15, kind: "query", request: codecFeedDuplexTextParams, streams: [{ no: 0, form: "text" }, { no: 1, form: "text" }] },
  duplexBytes: { iface: 1, ord: 16, kind: "query", request: codecFeedDuplexBytesParams, streams: [{ no: 0, form: "bytes" }, { no: 1, form: "elements", element: codecChunk }] },
  // multiple has no entry: multiple parameter streams are not supported
