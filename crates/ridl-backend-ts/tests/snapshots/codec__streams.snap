const codecChunk: PayloadCodec<t.Chunk> = { type: "streams.demo.Chunk", encode: encodeChunk, decode: decodeChunk };
const codecChoice: PayloadCodec<t.Choice> = { type: "streams.demo.Choice", encode: encodeChoice, decode: decodeChoice };
const codecStatus: PayloadCodec<t.StatusValue> = { type: "streams.demo.Status", encode: encodeStatus, decode: decodeStatus };
