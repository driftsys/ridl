  uploadNamed: { iface: 1, ord: 19, kind: "command", request: codecFeedUploadNamedParams, streams: [{ no: 1, form: "elements", element: codecChunk }], limit: 512 },
  uploadData: { iface: 1, ord: 20, kind: "command", request: codecFeedUploadDataParams, streams: [{ no: 1, form: "elements", element: codecData }], limit: 512 },
  uploadText: { iface: 1, ord: 21, kind: "command", request: codecCount, streams: [{ no: 1, form: "text" }], limit: 64 },
  uploadChoice: { iface: 1, ord: 22, kind: "query", request: codecFeedUploadChoiceParams, reply: codecUploadResult, streams: [{ no: 1, form: "elements", element: codecChunk }], limit: 512 },
  uploadTuple: { iface: 1, ord: 23, kind: "query", request: codecFeedUploadTupleParams, reply: codecFeedUploadTupleReply, streams: [{ no: 1, form: "bytes" }] },
