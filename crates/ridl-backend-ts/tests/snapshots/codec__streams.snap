const codecElementTypeFetchParams: $rt.PayloadCodec<ElementTypeFetchParams> = { type: "streams.demo.ElementTypeFetchParams", encode: encodeElementTypeFetchParams, decode: decodeElementTypeFetchParams };
const codecStreamEntryFetchParams: $rt.PayloadCodec<StreamEntryFetchParams> = { type: "streams.demo.StreamEntryFetchParams", encode: encodeStreamEntryFetchParams, decode: decodeStreamEntryFetchParams };
const codecStreamEntry1FetchParams: $rt.PayloadCodec<StreamEntry1FetchParams> = { type: "streams.demo.StreamEntry1FetchParams", encode: encodeStreamEntry1FetchParams, decode: decodeStreamEntry1FetchParams };

function checkStreamSession(session: $rt.StreamSession, limit: number | undefined): void {
  const hash = session.codec.catalogHash;
  if (hash.length !== CATALOG_HASH.length || CATALOG_HASH.some((byte, i) => byte !== hash[i])) {
    throw new $rt.CatalogMismatch(
      Array.from(CATALOG_HASH, (b) => b.toString(16).padStart(2, "0")).join(""),
      Array.from(hash, (b) => b.toString(16).padStart(2, "0")).join(""),
    );
  }
  if (limit === 0) throw new $rt.StreamError({ category: "corrupt" });
}

function encodeStreamRequest<T>(session: $rt.StreamSession, payload: $rt.PayloadCodec<T>, typeId: number, value: T, limit: number | undefined): Uint8Array {
  let bytes: Uint8Array;
  try {
    bytes = payload.encode(value);
  } catch (error) {
    if (typeof error === "object" && error !== null && "name" in error && (error.name === "RuleError" || error.name === "ConstraintError") && "rule" in error && (RULES as readonly unknown[]).includes(error.rule)) {
      throw new $rt.StreamError({ category: "contract", contract: { category: "invalid-value", rule: error.rule as typeof RULES[number] } }, { cause: error });
    }
    throw new $rt.StreamError({ category: "corrupt" }, { cause: error });
  }
  if (limit !== undefined && bytes.length > limit) throw new $rt.StreamError({ category: "corrupt" });
  const result = session.codec.verify(typeId, bytes);
  if (!result.ok) {
    if (result.kind === "malformed") throw new $rt.StreamError({ category: "corrupt" });
    if (result.kind === "rule" && (RULES as readonly string[]).includes(result.rule ?? "")) {
      throw new $rt.StreamError({ category: "contract", contract: { category: "invalid-value", rule: result.rule as typeof RULES[number] } });
    }
    throw new $rt.CodecError("unknown payload type or rule during request verification");
  }
  return bytes;
}

function decodeStreamReply<T>(session: $rt.StreamSession, payload: $rt.PayloadCodec<T>, typeId: number, bytes: Uint8Array): T {
  const result = session.codec.verify(typeId, bytes);
  if (!result.ok) {
    if (result.kind === "malformed") throw new $rt.StreamError({ category: "corrupt" });
    if (result.kind === "rule" && (RULES as readonly string[]).includes(result.rule ?? "")) {
      throw new $rt.StreamError({ category: "contract", contract: { category: "invalid-value", rule: result.rule as typeof RULES[number] } });
    }
    throw new $rt.CodecError("unknown payload type or rule during reply verification");
  }
  try {
    return payload.decode(bytes);
  } catch (error) {
    if (typeof error === "object" && error !== null && "name" in error && error.name === "RuleError" && "rule" in error && (RULES as readonly unknown[]).includes(error.rule)) {
      throw new $rt.StreamError({ category: "contract", contract: { category: "invalid-value", rule: error.rule as typeof RULES[number] } }, { cause: error });
    }
    throw new $rt.StreamError({ category: "corrupt" }, { cause: error });
  }
}

