import type { StreamSession, StreamOptions } from "@driftsys/ridl-runtime";
import { CatalogMismatch, CodecError, StreamError, decodeStream, decodeTextStream } from "@driftsys/ridl-runtime";
import * as flatbuffers from "flatbuffers";
import type { PayloadCodec } from "@driftsys/ridl-runtime";
import type * as t from "./streams.demo.js";
// `flatc --ts --gen-object-api` writes this module when its `-o` is the directory
// of this file.
import * as fb from "./streams/demo.js";

/** Thrown for a value the codec refuses, with the text of the rule it breaks. */
export class RuleError extends RangeError {
  readonly rule: (typeof RULES)[number];
  constructor(rule: (typeof RULES)[number], message: string) {
    super(message);
    this.name = "RuleError";
    this.rule = rule;
  }
}

/** The name of the catalog unit this package belongs to. */
export const CATALOG_NAME = "streams.demo";
/** The hash of the catalog unit, which the wasm module carries. */
export const CATALOG_HASH: Uint8Array = Uint8Array.from([86, 34, 78, 114, 55, 240, 150, 35, 158, 50, 119, 109, 104, 190, 39, 84, 88, 98, 245, 107, 103, 10, 161, 71, 113, 155, 134, 116, 187, 144, 198, 56]);
/** The qualified names of the payload types of this package, which name the wasm type ids. */
export const PAYLOAD_TYPES = [
  "streams.demo.Choice",
  "streams.demo.Chunk",
  "streams.demo.Count",
  "streams.demo.Data",
  "streams.demo.FeedDataParams",
  "streams.demo.FeedDuplexParams",
  "streams.demo.FeedFetchParams",
  "streams.demo.FeedLabelsParams",
  "streams.demo.FeedLatestParams",
  "streams.demo.FeedMultipleParams",
  "streams.demo.FeedScalarsParams",
  "streams.demo.FeedStatusesParams",
  "streams.demo.FeedTextParams",
  "streams.demo.FeedUnionsParams",
  "streams.demo.FeedUploadParams",
  "streams.demo.FeedZeroParams",
  "streams.demo.OtherFetchParams",
  "streams.demo.Status",
  "streams.demo.Text",
] as const;
/** The text of each rule code the wasm module reports, rule code n at index n - 2. */
export const RULES = ["length", "pattern", "range", "step", "unique", "utf8", "variant"] as const;

/** The induced tuple of `Feed.scalars`. */
export type FeedScalarsParams = Record<string, never>;

/** The induced tuple of `Feed.unions`. */
export interface FeedUnionsParams {
  session: t.Count;
  session1: t.Count;
  opts: t.Count;
}

