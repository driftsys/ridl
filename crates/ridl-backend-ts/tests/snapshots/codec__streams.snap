export function encodeText(value: t.Text): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.TextBoxT($rt.checkWellFormed(value, "streams.demo.Text")).pack(builder));
  return builder.asUint8Array();
}
