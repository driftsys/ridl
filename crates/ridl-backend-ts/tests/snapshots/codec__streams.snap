function checkStreamSession(session: StreamSession, limit: number | undefined): void {
  const hash = session.codec.catalogHash;
  if (hash.length !== CATALOG_HASH.length || CATALOG_HASH.some((byte, i) => byte !== hash[i])) {
    throw new CatalogMismatch(
      Array.from(CATALOG_HASH, (b) => b.toString(16).padStart(2, "0")).join(""),
      Array.from(hash, (b) => b.toString(16).padStart(2, "0")).join(""),
    );
  }
  if (limit === 0) throw new StreamError({ category: "corrupt" });
}

function encodeStreamRequest<T>(session: StreamSession, payload: PayloadCodec<T>, typeId: number, value: T, limit: number | undefined): Uint8Array {
  let bytes: Uint8Array;
  try {
    bytes = payload.encode(value);
  } catch (error) {
    if (error instanceof RuleError) {
      throw new StreamError({ category: "contract", contract: { category: "invalid-value", rule: error.rule } });
    }
    throw new StreamError({ category: "corrupt" });
  }
  if (limit !== undefined && bytes.length > limit) throw new StreamError({ category: "corrupt" });
  const result = session.codec.verify(typeId, bytes);
  if (!result.ok) {
    if (result.kind === "malformed") throw new StreamError({ category: "corrupt" });
    if (result.kind === "rule" && (RULES as readonly string[]).includes(result.rule ?? "")) {
      throw new StreamError({ category: "contract", contract: { category: "invalid-value", rule: result.rule as typeof RULES[number] } });
    }
    throw new CodecError("unknown payload type or rule during request verification");
  }
  return bytes;
}

/** The members of interface `Feed`, interface number `1`. */
export const Feed = {
  iface: 1,
  scalars: { iface: 1, ord: 2, kind: "query", request: codecFeedScalarsParams, streams: [{ no: 0, form: "elements", element: codecCount }] },
  structs: { iface: 1, ord: 3, kind: "query", request: codecCount, streams: [{ no: 0, form: "elements", element: codecChunk }] },
  unions: { iface: 1, ord: 4, kind: "query", request: codecFeedUnionsParams, streams: [{ no: 0, form: "elements", element: codecChoice }] },
  statuses: { iface: 1, ord: 5, kind: "query", request: codecFeedStatusesParams, streams: [{ no: 0, form: "elements", element: codecStatus }] },
  data: { iface: 1, ord: 6, kind: "query", request: codecFeedDataParams, streams: [{ no: 0, form: "elements", element: codecData }] },
  labels: { iface: 1, ord: 7, kind: "query", request: codecFeedLabelsParams, streams: [{ no: 0, form: "elements", element: codecText }] },
  readBytes: { iface: 1, ord: 8, kind: "query", request: codecCount, streams: [{ no: 0, form: "bytes" }], limit: 512 },
  text: { iface: 1, ord: 9, kind: "query", request: codecFeedTextParams, streams: [{ no: 0, form: "text" }] },
  zero: { iface: 1, ord: 10, kind: "query", request: codecFeedZeroParams, streams: [{ no: 0, form: "bytes" }], limit: 64 },
  latest: { iface: 1, ord: 11, kind: "query", request: codecFeedLatestParams, reply: codecCount },
  // upload has no entry: parameter streams are not generated yet
  // duplex has no entry: duplex streams are not generated yet
  // multiple has no entry: multiple parameter streams are not supported
  fetch: { iface: 1, ord: 15, kind: "query", request: codecFeedFetchParams, streams: [{ no: 0, form: "bytes" }] },
} as const;

/**
 * Reads sequence numbers.
 *
 * @remarks
 * Rules:
 * - response within 50000 us
 */
export function Feed_scalars(session: StreamSession, opts: StreamOptions): ReadableStream<t.Count> {
  const entry = Feed.scalars;
  checkStreamSession(session, undefined);
  const requestType = session.codec.typeId(entry.request.type);
  const element = entry.streams[0].element;
  const elementType = session.codec.typeId(element.type);
  const args = encodeStreamRequest(session, entry.request, requestType, {  }, undefined);
  const raw = session.transport.queryStream(entry.iface, entry.ord, args, opts);
  return raw.pipeThrough(decodeStream((bytes) => element.decode(bytes), (bytes) => session.codec.verify(elementType, bytes)));
}

/**
 * Reads numbered elements for {@link t.Count}.
 *
 * @remarks
 * Rules:
 * - response within 50000 us
 *
 * @param seed - The first sequence number.
 * @since 1.0.0
 * @deprecated Use scalars.
 */
export function Feed_structs(session: StreamSession, seed: t.Count, opts: StreamOptions): ReadableStream<t.Chunk> {
  const entry = Feed.structs;
  checkStreamSession(session, undefined);
  const requestType = session.codec.typeId(entry.request.type);
  const element = entry.streams[0].element;
  const elementType = session.codec.typeId(element.type);
  const args = encodeStreamRequest(session, entry.request, requestType, seed, undefined);
