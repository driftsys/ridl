/** Decodes a `streams.demo.Permission` payload the codec has verified. */
export function decodePermission(bytes: Uint8Array): t.Permission {
  return unpackPermission(fb.PermissionBox.getRootAsPermissionBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

function unpackPermission(raw: number): t.Permission {
  const n = raw;
  if (!([0] as readonly number[]).includes(n)) {
    throw new RuleError("variant", `value ${raw} is not a value of streams.demo.Permission`);
  }
  return n as t.Permission;
}

