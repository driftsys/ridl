/** Encodes a `streams.demo.Chunk` payload. */
export function encodeChunk(value: t.Chunk): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packChunk(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `streams.demo.Chunk` payload the codec has verified. */
export function decodeChunk(bytes: Uint8Array): t.Chunk {
  return unpackChunk(fb.Chunk.getRootAsChunk(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packChunk(value: t.Chunk): fb.ChunkT {
  const object = new fb.ChunkT();
  object.value = value.value;
  return object;
}
function unpackChunk(object: fb.ChunkT): t.Chunk {
  return {
    value: object.value as t.Count,
  };
}

/** Encodes a `streams.demo.Choice` payload. */
export function encodeChoice(value: t.Choice): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packChoice(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `streams.demo.Choice` payload the codec has verified. */
export function decodeChoice(bytes: Uint8Array): t.Choice {
  return unpackChoice(fb.Choice.getRootAsChoice(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packChoice(value: t.Choice): fb.ChoiceT {
  switch (value.kind) {
    case "ok":
      return new fb.ChoiceT(fb.ChoiceUnion.ok, packChunk(value.value));
    case "err":
      return new fb.ChoiceT(fb.ChoiceUnion.err, new fb.ChoiceErrBoxT(value.value));
  }
}
function unpackChoice(object: fb.ChoiceT): t.Choice {
  switch (object.valueType) {
    case fb.ChoiceUnion.ok:
      return { kind: "ok", value: unpackChunk(object.value as fb.ChunkT) };
    case fb.ChoiceUnion.err:
      return { kind: "err", value: (object.value as fb.ChoiceErrBoxT).value as t.Count };
    default:
      throw new RangeError("union streams.demo.Choice carries no arm");
  }
}

/** Encodes a `streams.demo.Status` payload. */
export function encodeStatus(value: t.StatusValue): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.StatusBoxT(packStatus(value)).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `streams.demo.Status` payload the codec has verified. */
export function decodeStatus(bytes: Uint8Array): t.StatusValue {
  return unpackStatus(fb.StatusBox.getRootAsStatusBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

function packStatus(value: t.StatusValue): bigint {
  const raw = typeof value === "number" ? value : value.unknown;
  if (!Number.isSafeInteger(raw)) {
    throw new RuleError("variant", `value ${raw} of streams.demo.Status is not a safe integer`);
  }
  return BigInt(raw);
}
function unpackStatus(raw: bigint | null): t.StatusValue {
  const value = raw ?? 0n;
  if (value > 9007199254740991n || value < -9007199254740991n) {
    throw new RuleError("variant", `value ${value} of streams.demo.Status is outside the safe integers`);
  }
  const n = Number(value);
  return ([0, 1] as readonly number[]).includes(n)
    ? n as t.Status
    : { unknown: n };
}

