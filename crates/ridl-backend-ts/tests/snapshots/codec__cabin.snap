/** Encodes a `veh.cabin.Glyph` payload. */
export function encodeGlyph(value: t.Glyph): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.GlyphBoxT($rt.checkWellFormed(value, "veh.cabin.Glyph")).pack(builder));
