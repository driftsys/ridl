/** Encodes a `veh.cabin.Tag` payload. */
export function encodeTag(value: t.Tag): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.TagBoxT($rt.checkWellFormed(value, "veh.cabin.Tag")).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Tag` payload the codec has verified. */
export function decodeTag(bytes: Uint8Array): t.Tag {
  return t.makeTagUnchecked(fb.TagBox.getRootAsTagBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as string);
}

/** Encodes a `veh.cabin.Code` payload. */
export function encodeCode(value: t.Code): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.CodeBoxT($rt.checkWellFormed(value, "veh.cabin.Code")).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Code` payload the codec has verified. */
export function decodeCode(bytes: Uint8Array): t.Code {
  return t.makeCodeUnchecked(fb.CodeBox.getRootAsCodeBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as string);
