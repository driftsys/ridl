/** Encodes a `veh.cabin.Block` payload. */
export function encodeBlock(value: t.Block): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.BlockBoxT(Array.from(value)).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Block` payload the codec has verified. */
export function decodeBlock(bytes: Uint8Array): t.Block {
  return t.makeBlockUnchecked(Uint8Array.from(fb.BlockBox.getRootAsBlockBox(new flatbuffers.ByteBuffer(bytes)).unpack().value));
}

const codecTemperature: $rt.PayloadCodec<t.Temperature> = { type: "veh.cabin.Temperature", encode: encodeTemperature, decode: decodeTemperature };
const codecLevel: $rt.PayloadCodec<t.Level> = { type: "veh.cabin.Level", encode: encodeLevel, decode: decodeLevel };
const codecWindow: $rt.PayloadCodec<t.Window> = { type: "veh.cabin.Window", encode: encodeWindow, decode: decodeWindow };
const codecAverage: $rt.PayloadCodec<t.Average> = { type: "veh.cabin.Average", encode: encodeAverage, decode: decodeAverage };
const codecHealth: $rt.PayloadCodec<t.Health> = { type: "veh.cabin.Health", encode: encodeHealth, decode: decodeHealth };
const codecWarning: $rt.PayloadCodec<t.Warning> = { type: "veh.cabin.Warning", encode: encodeWarning, decode: decodeWarning };

/** The members of interface `Cabin`, interface number `1`. */
export const Cabin = {
  iface: 1,
  temperature: { iface: 1, ord: 1, kind: "signal", payload: codecTemperature },
  warning: { iface: 1, ord: 2, kind: "event", payload: codecWarning },
  setLevel: { iface: 1, ord: 3, kind: "command", request: codecLevel },
  average: { iface: 1, ord: 4, kind: "query", request: codecWindow, reply: codecAverage },
} as const;

/** The members of interface `Horn`, interface number `2`. */
export const Horn = {
  iface: 2,
  active: { iface: 2, ord: 1, kind: "signal", payload: codecHealth },
} as const;

function signalCheck(codec: $rt.Codec, entry: { readonly iface: number; readonly ord: number; readonly payload: { readonly type: string } }): $rt.SignalCheckEntry {
  const typeId = codec.typeId(entry.payload.type);
  return {
    iface: entry.iface,
    ord: entry.ord,
    check: (bytes) => {
      const result = codec.verify(typeId, bytes);
      if (result.ok) return undefined;
      if (result.kind !== "rule") return "corrupt";
      const rule = (RULES as readonly string[]).find((known) => known === result.rule);
      if (rule === undefined) throw new $rt.CodecError("unknown rule during signal verification");
      return { rule: rule as (typeof RULES)[number] };
    },
  };
}

/** Returns the check of each signal of this package, for the `checks` option of `connect`. The checks resolve the type ids of `codec` once, here. */
export function signalChecks(codec: $rt.Codec): readonly $rt.SignalCheckEntry[] {
  return [
    signalCheck(codec, Cabin.temperature),
    signalCheck(codec, Horn.active),
  ];
}
