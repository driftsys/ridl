import * as $rt from "@driftsys/ridl-runtime";
import * as flatbuffers from "flatbuffers";
import * as t from "./veh.cabin.js";
// `flatc --ts --gen-object-api` writes this module when its `-o` is the directory
// of this file.
import * as fb from "./veh/cabin.js";

/** Thrown for a value the codec refuses, with the text of the rule it breaks. */
export class RuleError extends RangeError {
  readonly rule: (typeof RULES)[number];
  constructor(rule: (typeof RULES)[number], message: string) {
    super(message);
    this.name = "RuleError";
    this.rule = rule;
  }
}

/** The name of the catalog unit this package belongs to. */
export const CATALOG_NAME = "veh.cabin";
/** The hash of the catalog unit, which the wasm module carries. */
export const CATALOG_HASH: Uint8Array = Uint8Array.from([89, 185, 249, 36, 131, 82, 68, 160, 215, 181, 151, 232, 10, 255, 27, 31, 234, 139, 7, 172, 241, 146, 116, 74, 247, 242, 3, 62, 203, 41, 66, 222]);
/** The qualified names of the payload types of this package, which name the wasm type ids. */
export const PAYLOAD_TYPES = [
  "veh.cabin.Average",
  "veh.cabin.Block",
  "veh.cabin.Code",
  "veh.cabin.Diagnostic",
  "veh.cabin.Digited",
  "veh.cabin.Glyph",
  "veh.cabin.Health",
  "veh.cabin.Level",
  "veh.cabin.Setpoint",
  "veh.cabin.Subsystems",
  "veh.cabin.Tag",
  "veh.cabin.Temperature",
  "veh.cabin.Tenth",
  "veh.cabin.Warning",
  "veh.cabin.Window",
] as const;
/** The text of each rule code the wasm module reports, rule code n at index n - 2. */
export const RULES = ["length", "pattern", "range", "step", "unique", "utf8", "variant"] as const;

/** Encodes a `veh.cabin.Temperature` payload. */
export function encodeTemperature(value: t.Temperature): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.TemperatureBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Temperature` payload the codec has verified. */
export function decodeTemperature(bytes: Uint8Array): t.Temperature {
  return t.makeTemperatureUnchecked(fb.TemperatureBox.getRootAsTemperatureBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Level` payload. */
export function encodeLevel(value: t.Level): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.LevelBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Level` payload the codec has verified. */
export function decodeLevel(bytes: Uint8Array): t.Level {
  return t.makeLevelUnchecked(fb.LevelBox.getRootAsLevelBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Window` payload. */
export function encodeWindow(value: t.Window): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.WindowBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Window` payload the codec has verified. */
export function decodeWindow(bytes: Uint8Array): t.Window {
  return t.makeWindowUnchecked(fb.WindowBox.getRootAsWindowBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Average` payload. */
export function encodeAverage(value: t.Average): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.AverageBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Average` payload the codec has verified. */
export function decodeAverage(bytes: Uint8Array): t.Average {
  return t.makeAverageUnchecked(fb.AverageBox.getRootAsAverageBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Health` payload. */
export function encodeHealth(value: t.Health): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.HealthBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Health` payload the codec has verified. */
export function decodeHealth(bytes: Uint8Array): t.Health {
  return unpackHealth(fb.HealthBox.getRootAsHealthBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

function unpackHealth(raw: number): t.Health {
  const n = raw;
  if (!([0, 1, 2] as readonly number[]).includes(n)) {
    throw new RuleError("variant", `value ${raw} is not a value of veh.cabin.Health`);
  }
  return n as t.Health;
}

/** Encodes a `veh.cabin.Warning` payload. */
export function encodeWarning(value: t.Warning): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packWarning(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Warning` payload the codec has verified. */
export function decodeWarning(bytes: Uint8Array): t.Warning {
  return unpackWarning(fb.Warning.getRootAsWarning(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packWarning(value: t.Warning): fb.WarningT {
  const object = new fb.WarningT();
  object.code = value.code;
  object.health = value.health;
  return object;
}
function unpackWarning(object: fb.WarningT): t.Warning {
  return {
    code: t.makeLevelUnchecked(object.code),
    health: unpackHealth(object.health),
  };
}

/** Encodes a `veh.cabin.Subsystems` payload. */
export function encodeSubsystems(value: t.Subsystems): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.SubsystemsBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Subsystems` payload the codec has verified. */
export function decodeSubsystems(bytes: Uint8Array): t.Subsystems {
  return unpackSubsystems(fb.SubsystemsBox.getRootAsSubsystemsBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

function unpackSubsystems(value: number): t.Subsystems {
  if ((value & ~3) !== 0) {
    throw new RuleError("variant", `value ${value} has a bit that veh.cabin.Subsystems does not declare`);
  }
  return value as t.Subsystems;
}

/** Encodes a `veh.cabin.Diagnostic` payload. */
export function encodeDiagnostic(value: t.Diagnostic): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packDiagnostic(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Diagnostic` payload the codec has verified. */
export function decodeDiagnostic(bytes: Uint8Array): t.Diagnostic {
  return unpackDiagnostic(fb.Diagnostic.getRootAsDiagnostic(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packDiagnostic(value: t.Diagnostic): fb.DiagnosticT {
  const object = new fb.DiagnosticT();
  object.covers = value.covers;
  object.health = value.health;
  object.loop = value.loop;
  return object;
}
function unpackDiagnostic(object: fb.DiagnosticT): t.Diagnostic {
  return {
    covers: unpackSubsystems(object.covers),
    health: unpackHealth(object.health),
    loop: t.makeLevelUnchecked(object.loop),
  };
}

