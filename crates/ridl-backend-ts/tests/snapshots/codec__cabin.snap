---
source: crates/ridl-backend-ts/tests/codec.rs
expression: "module(&cabin_model(), \"veh.cabin\")"
---
import * as $rt from "@driftsys/ridl-runtime";
import * as flatbuffers from "flatbuffers";
import * as t from "./veh.cabin.js";
// `flatc --ts --gen-object-api` writes this module when its `-o` is the directory
// of this file.
import * as fb from "./veh/cabin.js";

/** Thrown for a value the codec refuses, with the text of the rule it breaks. */
export class RuleError extends RangeError {
  readonly rule: (typeof RULES)[number];
  constructor(rule: (typeof RULES)[number], message: string) {
    super(message);
    this.name = "RuleError";
    this.rule = rule;
  }
}

/** The name of the catalog unit this package belongs to. */
export const CATALOG_NAME = "veh.cabin";
/** The hash of the catalog unit, which the wasm module carries. */
export const CATALOG_HASH: Uint8Array = Uint8Array.from([89, 185, 249, 36, 131, 82, 68, 160, 215, 181, 151, 232, 10, 255, 27, 31, 234, 139, 7, 172, 241, 146, 116, 74, 247, 242, 3, 62, 203, 41, 66, 222]);
/** The qualified names of the payload types of this package, which name the wasm type ids. */
export const PAYLOAD_TYPES = [
  "veh.cabin.Average",
  "veh.cabin.Block",
  "veh.cabin.Code",
  "veh.cabin.Diagnostic",
  "veh.cabin.Digited",
  "veh.cabin.Glyph",
  "veh.cabin.Health",
  "veh.cabin.Level",
  "veh.cabin.Setpoint",
  "veh.cabin.Subsystems",
  "veh.cabin.Tag",
  "veh.cabin.Temperature",
  "veh.cabin.Tenth",
  "veh.cabin.Warning",
  "veh.cabin.Window",
] as const;
/** The text of each rule code the wasm module reports, rule code n at index n - 2. */
export const RULES = ["length", "pattern", "range", "step", "unique", "utf8", "variant"] as const;

/** Encodes a `veh.cabin.Temperature` payload. */
export function encodeTemperature(value: t.Temperature): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.TemperatureBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Temperature` payload the codec has verified. */
export function decodeTemperature(bytes: Uint8Array): t.Temperature {
  return t.makeTemperatureUnchecked(fb.TemperatureBox.getRootAsTemperatureBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Level` payload. */
export function encodeLevel(value: t.Level): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.LevelBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Level` payload the codec has verified. */
export function decodeLevel(bytes: Uint8Array): t.Level {
  return t.makeLevelUnchecked(fb.LevelBox.getRootAsLevelBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Window` payload. */
export function encodeWindow(value: t.Window): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.WindowBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Window` payload the codec has verified. */
export function decodeWindow(bytes: Uint8Array): t.Window {
  return t.makeWindowUnchecked(fb.WindowBox.getRootAsWindowBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Average` payload. */
export function encodeAverage(value: t.Average): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.AverageBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Average` payload the codec has verified. */
export function decodeAverage(bytes: Uint8Array): t.Average {
  return t.makeAverageUnchecked(fb.AverageBox.getRootAsAverageBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Health` payload. */
export function encodeHealth(value: t.Health): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.HealthBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Health` payload the codec has verified. */
export function decodeHealth(bytes: Uint8Array): t.Health {
  return unpackHealth(fb.HealthBox.getRootAsHealthBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

function unpackHealth(raw: number): t.Health {
  const n = raw;
  if (!([0, 1, 2] as readonly number[]).includes(n)) {
    throw new RuleError("variant", `value ${raw} is not a value of veh.cabin.Health`);
  }
  return n as t.Health;
}

/** Encodes a `veh.cabin.Warning` payload. */
export function encodeWarning(value: t.Warning): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packWarning(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Warning` payload the codec has verified. */
export function decodeWarning(bytes: Uint8Array): t.Warning {
  return unpackWarning(fb.Warning.getRootAsWarning(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packWarning(value: t.Warning): fb.WarningT {
  const object = new fb.WarningT();
  object.code = value.code;
  object.health = value.health;
  return object;
}
function unpackWarning(object: fb.WarningT): t.Warning {
  return {
    code: t.makeLevelUnchecked(object.code),
    health: unpackHealth(object.health),
  };
}

/** Encodes a `veh.cabin.Subsystems` payload. */
export function encodeSubsystems(value: t.Subsystems): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.SubsystemsBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Subsystems` payload the codec has verified. */
export function decodeSubsystems(bytes: Uint8Array): t.Subsystems {
  return unpackSubsystems(fb.SubsystemsBox.getRootAsSubsystemsBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

function unpackSubsystems(value: number): t.Subsystems {
  if ((value & ~3) !== 0) {
    throw new RuleError("variant", `value ${value} has a bit that veh.cabin.Subsystems does not declare`);
  }
  return value as t.Subsystems;
}

/** Encodes a `veh.cabin.Diagnostic` payload. */
export function encodeDiagnostic(value: t.Diagnostic): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packDiagnostic(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Diagnostic` payload the codec has verified. */
export function decodeDiagnostic(bytes: Uint8Array): t.Diagnostic {
  return unpackDiagnostic(fb.Diagnostic.getRootAsDiagnostic(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packDiagnostic(value: t.Diagnostic): fb.DiagnosticT {
  const object = new fb.DiagnosticT();
  object.covers = value.covers;
  object.health = value.health;
  object.loop = value.loop;
  return object;
}
function unpackDiagnostic(object: fb.DiagnosticT): t.Diagnostic {
  return {
    covers: unpackSubsystems(object.covers),
    health: unpackHealth(object.health),
    loop: t.makeLevelUnchecked(object.loop),
  };
}

/** Encodes a `veh.cabin.Setpoint` payload. */
export function encodeSetpoint(value: t.Setpoint): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.SetpointBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Setpoint` payload the codec has verified. */
export function decodeSetpoint(bytes: Uint8Array): t.Setpoint {
  return t.makeSetpointUnchecked(fb.SetpointBox.getRootAsSetpointBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Tenth` payload. */
export function encodeTenth(value: t.Tenth): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.TenthBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Tenth` payload the codec has verified. */
export function decodeTenth(bytes: Uint8Array): t.Tenth {
  return t.makeTenthUnchecked(fb.TenthBox.getRootAsTenthBox(new flatbuffers.ByteBuffer(bytes)).unpack().value);
}

/** Encodes a `veh.cabin.Tag` payload. */
export function encodeTag(value: t.Tag): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.TagBoxT($rt.checkWellFormed(value, "veh.cabin.Tag")).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Tag` payload the codec has verified. */
export function decodeTag(bytes: Uint8Array): t.Tag {
  return t.makeTagUnchecked(fb.TagBox.getRootAsTagBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as string);
}

/** Encodes a `veh.cabin.Code` payload. */
export function encodeCode(value: t.Code): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.CodeBoxT($rt.checkWellFormed(value, "veh.cabin.Code")).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Code` payload the codec has verified. */
export function decodeCode(bytes: Uint8Array): t.Code {
  return t.makeCodeUnchecked(fb.CodeBox.getRootAsCodeBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as string);
}

/** Encodes a `veh.cabin.Glyph` payload. */
export function encodeGlyph(value: t.Glyph): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.GlyphBoxT($rt.checkWellFormed(value, "veh.cabin.Glyph")).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Glyph` payload the codec has verified. */
export function decodeGlyph(bytes: Uint8Array): t.Glyph {
  return t.makeGlyphUnchecked(fb.GlyphBox.getRootAsGlyphBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as string);
}

/** Encodes a `veh.cabin.Digited` payload. */
export function encodeDigited(value: t.Digited): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.DigitedBoxT($rt.checkWellFormed(value, "veh.cabin.Digited")).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Digited` payload the codec has verified. */
export function decodeDigited(bytes: Uint8Array): t.Digited {
  return t.makeDigitedUnchecked(fb.DigitedBox.getRootAsDigitedBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as string);
}

/** Encodes a `veh.cabin.Block` payload. */
export function encodeBlock(value: t.Block): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.BlockBoxT(Array.from(value)).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.cabin.Block` payload the codec has verified. */
export function decodeBlock(bytes: Uint8Array): t.Block {
  return t.makeBlockUnchecked(Uint8Array.from(fb.BlockBox.getRootAsBlockBox(new flatbuffers.ByteBuffer(bytes)).unpack().value));
}

const codecTemperature: $rt.PayloadCodec<t.Temperature> = { type: "veh.cabin.Temperature", encode: encodeTemperature, decode: decodeTemperature };
const codecLevel: $rt.PayloadCodec<t.Level> = { type: "veh.cabin.Level", encode: encodeLevel, decode: decodeLevel };
const codecWindow: $rt.PayloadCodec<t.Window> = { type: "veh.cabin.Window", encode: encodeWindow, decode: decodeWindow };
const codecAverage: $rt.PayloadCodec<t.Average> = { type: "veh.cabin.Average", encode: encodeAverage, decode: decodeAverage };
const codecHealth: $rt.PayloadCodec<t.Health> = { type: "veh.cabin.Health", encode: encodeHealth, decode: decodeHealth };
const codecWarning: $rt.PayloadCodec<t.Warning> = { type: "veh.cabin.Warning", encode: encodeWarning, decode: decodeWarning };

/** The members of interface `Cabin`, interface number `1`. */
export const Cabin = {
  iface: 1,
  temperature: { iface: 1, ord: 1, kind: "signal", payload: codecTemperature },
  warning: { iface: 1, ord: 2, kind: "event", payload: codecWarning },
  setLevel: { iface: 1, ord: 3, kind: "command", request: codecLevel },
  average: { iface: 1, ord: 4, kind: "query", request: codecWindow, reply: codecAverage },
} as const;

/** One occurrence of an event of interface `Cabin`, as `CabinClient.onEvent` delivers it. */
export type CabinEvent =
  | { readonly event: "warning"; readonly occurrence: $rt.Occurrence<t.Warning> };

/**
 * The cabin's own interface: a signal, an event, a command and a query, so
 * the proof covers every interaction kind that carries a payload.
 */
export class CabinClient {
  readonly #port: $rt.Caller & $rt.SignalReader & $rt.EventSource;
  readonly #codec: $rt.Codec;
  readonly #ids: { readonly temperature: { readonly payload: number }; readonly warning: { readonly payload: number }; readonly setLevel: { readonly request: number }; readonly average: { readonly request: number; readonly reply: number } };

  private constructor(port: $rt.Caller & $rt.SignalReader & $rt.EventSource, codec: $rt.Codec) {
    this.#port = port;
    this.#codec = codec;
    this.#ids = {
      temperature: { payload: codec.typeId(Cabin.temperature.payload.type) },
      warning: { payload: codec.typeId(Cabin.warning.payload.type) },
      setLevel: { request: codec.typeId(Cabin.setLevel.request.type) },
      average: { request: codec.typeId(Cabin.average.request.type), reply: codec.typeId(Cabin.average.reply.type) },
    };
  }

  /**
   * Binds the client to a port and a loaded codec, and registers the check of each signal with the port. Throws `CatalogMismatch` when
   * the catalog hash of the port or of the codec differs from `CATALOG_HASH`.
   */
  static bind<P extends $rt.Caller & $rt.SignalReader & $rt.EventSource>(port: P, codec: $rt.Codec): CabinClient {
    $rt.checkCatalog(CATALOG_HASH, port, codec);
    const client = new CabinClient(port, codec);
    {
      const entry = signalCheck(codec, Cabin.temperature, client.#ids.temperature.payload);
      port.checkWith(entry.iface, entry.ord, entry.check);
    }
    return client;
  }

  /** Subscribes to signal `temperature`. The promise resolves when the provider answered; `opts.bound` and `opts.signal` limit the wait, and the promise rejects with a `CallError` of the category `down` when the session has ended. */
  subscribeTemperature(opts?: $rt.WaitOptions): Promise<void> {
    return this.#port.subscribe(Cabin.temperature.iface, Cabin.temperature.ord, opts);
  }

  /**
   * The current cabin air temperature.
   *
   * @remarks
   * Rules:
   * - period 10000 us
   *
   * @returns The held sample at once. This method never throws: after the session ended the session holds no sample, so it returns the init sample (`readX` and `subscribeX` reject with `down`). Before the first publish it is the init sample: provenance `init` and the init value of the type. Under `init` and `invalid` the value is the last good one when there is one, else the init value. A live payload that fails verification becomes provenance `invalid` with `detected` set.
   */
  temperature(): $rt.Sample<t.Temperature> {
    const raw = this.#port.sample(Cabin.temperature.iface, Cabin.temperature.ord);
    return raw === undefined ? $rt.initSample(t.initTemperature) : $rt.decodeSample(this.#codec, Cabin.temperature.payload, this.#ids.temperature.payload, raw, t.initTemperature);
  }

  /** Waits for the next publish of signal `temperature`. `opts.bound` and `opts.signal` limit the wait. */
  async readTemperature(opts?: $rt.WaitOptions): Promise<$rt.Sample<t.Temperature>> {
    const raw = await this.#port.read(Cabin.temperature.iface, Cabin.temperature.ord, opts);
    return $rt.decodeSample(this.#codec, Cabin.temperature.payload, this.#ids.temperature.payload, raw, t.initTemperature);
  }

  /** Calls `listener` with every accepted publish of signal `temperature` and returns the function that removes it. */
  watchTemperature(listener: (sample: $rt.Sample<t.Temperature>) => void): () => void {
    return this.#port.watch(Cabin.temperature.iface, Cabin.temperature.ord, (raw) => listener($rt.decodeSample(this.#codec, Cabin.temperature.payload, this.#ids.temperature.payload, raw, t.initTemperature)));
  }

  /** Subscribes to event `warning`. The promise resolves when the provider answered; `opts.bound` and `opts.signal` limit the wait, and the promise rejects with a `CallError` of the category `down` when the session has ended. */
  subscribeWarning(opts?: $rt.WaitOptions): Promise<void> {
    return this.#port.subscribe(Cabin.warning.iface, Cabin.warning.ord, opts);
  }

  /**
   * Sets the cabin level, below 100.
   *
   * @remarks
   * Rules:
   * - response within 50000 us
   * - require `level < 100`
   *
   * @param opts - The bound defaults to the declared maximum response time, 50 ms. `opts.signal` aborts the call; a provider that already received the command may still run it.
   * @returns Resolves when the provider accepted the command.
   */
  async setLevel(level: t.Level, opts?: Partial<$rt.CallOptions>): Promise<void> {
    const args = $rt.encodeRequest(this.#codec, Cabin.setLevel.request, this.#ids.setLevel.request, level);
    await this.#port.command(Cabin.setLevel.iface, Cabin.setLevel.ord, args, { ...opts, bound: opts?.bound ?? 50 });
  }

  /**
   * The average level over the window, in milliseconds.
   *
   * @remarks
   * Rules:
   * - response within 200000 us
   * - require `window > 0`
   * - ensure `result >= 0`
   *
   * @param opts - The bound defaults to the declared maximum response time, 200 ms. `opts.signal` aborts the call.
   */
  async average(window: t.Window, opts?: Partial<$rt.CallOptions>): Promise<t.Average> {
    const args = $rt.encodeRequest(this.#codec, Cabin.average.request, this.#ids.average.request, window);
    const raw = await this.#port.query(Cabin.average.iface, Cabin.average.ord, args, { ...opts, bound: opts?.bound ?? 200 });
    return $rt.decodeReply(this.#codec, Cabin.average.reply, this.#ids.average.reply, raw);
  }

  /**
   * Calls `listener` with every accepted occurrence of every subscribed event of the
   * interface, in arrival order, and returns the function that removes it. An occurrence
   * that the port refused, and one whose payload fails the verification of this class
   * (a rule failure included), has `occurrence.detected` set to `"corrupt"` and no value.
   */
  onEvent(listener: (event: CabinEvent) => void): () => void {
    return this.#port.listen(Cabin.warning.iface, (raw) => {
      switch (raw.ord) {
        case Cabin.warning.ord:
          listener({
            event: "warning",
            occurrence: $rt.decodeOccurrence(this.#codec, Cabin.warning.payload, this.#ids.warning.payload, raw),
          });
          break;
      }
    });
  }
}

/** The members of interface `Horn`, interface number `2`. */
export const Horn = {
  iface: 2,
  active: { iface: 2, ord: 1, kind: "signal", payload: codecHealth },
} as const;

/**
 * A second interface with a signal and nothing else, so the emitted crate
 * holds more than one interface module and the per-interface buffer bound is
 * visibly computed per interface rather than fixed.
 */
export class HornClient {
  readonly #port: $rt.SignalReader;
  readonly #codec: $rt.Codec;
  readonly #ids: { readonly active: { readonly payload: number } };

  private constructor(port: $rt.SignalReader, codec: $rt.Codec) {
    this.#port = port;
    this.#codec = codec;
    this.#ids = {
      active: { payload: codec.typeId(Horn.active.payload.type) },
    };
  }

  /**
   * Binds the client to a port and a loaded codec, and registers the check of each signal with the port. Throws `CatalogMismatch` when
   * the catalog hash of the port or of the codec differs from `CATALOG_HASH`.
   */
  static bind<P extends $rt.SignalReader>(port: P, codec: $rt.Codec): HornClient {
    $rt.checkCatalog(CATALOG_HASH, port, codec);
    const client = new HornClient(port, codec);
    {
      const entry = signalCheck(codec, Horn.active, client.#ids.active.payload);
      port.checkWith(entry.iface, entry.ord, entry.check);
    }
    return client;
  }

  /** Subscribes to signal `active`. The promise resolves when the provider answered; `opts.bound` and `opts.signal` limit the wait, and the promise rejects with a `CallError` of the category `down` when the session has ended. */
  subscribeActive(opts?: $rt.WaitOptions): Promise<void> {
    return this.#port.subscribe(Horn.active.iface, Horn.active.ord, opts);
  }

  /**
   * The health of the horn.
   *
   * @remarks
   * Rules:
   * - period 10000 us
   *
   * @returns The held sample at once. This method never throws: after the session ended the session holds no sample, so it returns the init sample (`readX` and `subscribeX` reject with `down`). Before the first publish it is the init sample: provenance `init` and the init value of the type. Under `init` and `invalid` the value is the last good one when there is one, else the init value. A live payload that fails verification becomes provenance `invalid` with `detected` set.
   */
  active(): $rt.Sample<t.Health> {
    const raw = this.#port.sample(Horn.active.iface, Horn.active.ord);
    return raw === undefined ? $rt.initSample(t.initHealth) : $rt.decodeSample(this.#codec, Horn.active.payload, this.#ids.active.payload, raw, t.initHealth);
  }

  /** Waits for the next publish of signal `active`. `opts.bound` and `opts.signal` limit the wait. */
  async readActive(opts?: $rt.WaitOptions): Promise<$rt.Sample<t.Health>> {
    const raw = await this.#port.read(Horn.active.iface, Horn.active.ord, opts);
    return $rt.decodeSample(this.#codec, Horn.active.payload, this.#ids.active.payload, raw, t.initHealth);
  }

  /** Calls `listener` with every accepted publish of signal `active` and returns the function that removes it. */
  watchActive(listener: (sample: $rt.Sample<t.Health>) => void): () => void {
    return this.#port.watch(Horn.active.iface, Horn.active.ord, (raw) => listener($rt.decodeSample(this.#codec, Horn.active.payload, this.#ids.active.payload, raw, t.initHealth)));
  }
}

function signalCheck(codec: $rt.Codec, entry: { readonly iface: number; readonly ord: number; readonly payload: { readonly type: string } }, typeId: number = codec.typeId(entry.payload.type)): $rt.SignalCheckEntry {
  return {
    iface: entry.iface,
    ord: entry.ord,
    check: (bytes) => {
      const result = codec.verify(typeId, bytes);
      if (result.ok) return undefined;
      if (result.kind !== "rule") return "corrupt";
      const rule = (RULES as readonly string[]).find((known) => known === result.rule);
      if (rule === undefined) throw new $rt.CodecError("unknown rule during signal verification");
      return { rule: rule as (typeof RULES)[number] };
    },
  };
}

/** Returns the check of each signal of this package, for the `checks` option of `connect`. The checks resolve the type ids of `codec` once, here. */
export function signalChecks(codec: $rt.Codec): readonly $rt.SignalCheckEntry[] {
  return [
    signalCheck(codec, Cabin.temperature),
    signalCheck(codec, Horn.active),
  ];
}
