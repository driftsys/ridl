function packSensorBounds(value: t.SensorBounds): fb.SensorBoundsT {
  const object = new fb.SensorBoundsT();
  object.range = packSensorBoundsRange(value.range);
  object.readings = [...value.readings];
  object.labels = [...value.labels];
  object.meta = value.meta.map(([key, value]) => { const entry = new fb.SensorBoundsMetaEntryT(); entry.key = key; entry.value = value; return entry; });
  return object;
}
function unpackSensorBounds(object: fb.SensorBoundsT): t.SensorBounds {
