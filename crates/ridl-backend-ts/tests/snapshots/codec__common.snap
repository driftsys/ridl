/** Encodes a `veh.common.SpeedLimitPayload` payload. */
export function encodeSpeedLimitPayload(value: t.SpeedLimitPayload): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packSpeedLimitPayload(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.SpeedLimitPayload` payload the codec has verified. */
export function decodeSpeedLimitPayload(bytes: Uint8Array): t.SpeedLimitPayload {
  return unpackSpeedLimitPayload(fb.SpeedLimitPayload.getRootAsSpeedLimitPayload(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packSpeedLimitPayload(value: t.SpeedLimitPayload): fb.SpeedLimitPayloadT {
  const object = new fb.SpeedLimitPayloadT();
  object.limit = value.limit;
  object.actual = value.actual;
  return object;
}
function unpackSpeedLimitPayload(object: fb.SpeedLimitPayloadT): t.SpeedLimitPayload {
  return {
    limit: object.limit as t.Speed,
    actual: object.actual as t.Speed,
  };
}

/** Encodes a `veh.common.DriverProfile` payload. */
export function encodeDriverProfile(value: t.DriverProfile): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packDriverProfile(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.DriverProfile` payload the codec has verified. */
export function decodeDriverProfile(bytes: Uint8Array): t.DriverProfile {
  return unpackDriverProfile(fb.DriverProfile.getRootAsDriverProfile(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packDriverProfile(value: t.DriverProfile): fb.DriverProfileT {
  const object = new fb.DriverProfileT();
  object.name = value.name;
  object.speed = value.speed;
  object.override = value.override === undefined ? null : value.override;
  object.gears = value.gears;
  return object;
}
function unpackDriverProfile(object: fb.DriverProfileT): t.DriverProfile {
  const result: t.DriverProfile = {
    name: object.name as ridl_std.Name,
    speed: object.speed as t.Speed,
    gears: object.gears,
  };
  if (object.override !== null) result.override = object.override as t.Speed;
  return result;
}

/** Encodes a `veh.common.SensorBounds` payload. */
export function encodeSensorBounds(value: t.SensorBounds): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packSensorBounds(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.SensorBounds` payload the codec has verified. */
export function decodeSensorBounds(bytes: Uint8Array): t.SensorBounds {
  return unpackSensorBounds(fb.SensorBounds.getRootAsSensorBounds(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packSensorBounds(value: t.SensorBounds): fb.SensorBoundsT {
  const object = new fb.SensorBoundsT();
  object.range = packSensorBoundsRange(value.range);
  object.readings = [...value.readings];
  object.labels = [...value.labels];
  object.meta = value.meta.map(([key, value]) => { const entry = new fb.SensorBoundsMetaEntryT(); entry.key = key; entry.value = value; return entry; });
  return object;
}
function unpackSensorBounds(object: fb.SensorBoundsT): t.SensorBounds {
  return {
    range: object.range === null ? absent("veh.common.SensorBounds", "range") : unpackSensorBoundsRange(object.range),
    readings: object.readings.map((element) => element as t.Speed),
    labels: object.labels.map((element) => element as ridl_std.Label),
    meta: object.meta.map((entry) => [entry.key as ridl_std.Label, entry.value as ridl_std.Name] as const),
  };
}

/** Encodes a `veh.common.SensorResult` payload. */
export function encodeSensorResult(value: t.SensorResult): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packSensorResult(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.SensorResult` payload the codec has verified. */
export function decodeSensorResult(bytes: Uint8Array): t.SensorResult {
  return unpackSensorResult(fb.SensorResult.getRootAsSensorResult(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packSensorResult(value: t.SensorResult): fb.SensorResultT {
  switch (value.kind) {
    case "ok":
      return new fb.SensorResultT(fb.SensorResultUnion.ok, packSensorReading(value.value));
    case "err":
      return new fb.SensorResultT(fb.SensorResultUnion.err, packSensorFault(value.value));
  }
}
function unpackSensorResult(object: fb.SensorResultT): t.SensorResult {
  switch (object.valueType) {
    case fb.SensorResultUnion.ok:
      return { kind: "ok", value: unpackSensorReading(object.value as fb.SensorReadingT) };
    case fb.SensorResultUnion.err:
      return { kind: "err", value: unpackSensorFault(object.value as fb.SensorFaultT) };
    default:
      throw new RangeError("union veh.common.SensorResult carries no arm");
  }
}

