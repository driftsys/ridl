    pair: object.pair === null ? absent("veh.common.Pairs", "pair") : unpackPairsPair(object.pair),
    list: object.list.map((element) => unpackPairsListElement(element)),
  };
}

/** Encodes a `veh.common.Phrase` payload. */
export function encodePhrase(value: t.Phrase): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packPhrase(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.Phrase` payload the codec has verified. */
export function decodePhrase(bytes: Uint8Array): t.Phrase {
  return unpackPhrase(fb.Phrase.getRootAsPhrase(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packPhrase(value: t.Phrase): fb.PhraseT {
  switch (value.kind) {
    case "remark":
      return new fb.PhraseT(fb.PhraseUnion.remark, new fb.PhraseRemarkBoxT(checkWellFormed(value.value, "veh.common.Phrase.remark")));
    case "gear":
      return new fb.PhraseT(fb.PhraseUnion.gear, new fb.PhraseGearBoxT(BigInt(value.value)));
  }
}
function unpackPhrase(object: fb.PhraseT): t.Phrase {
  switch (object.valueType) {
    case fb.PhraseUnion.remark:
      return { kind: "remark", value: t.makeRemarkUnchecked((object.value as fb.PhraseRemarkBoxT).value as string) };
    case fb.PhraseUnion.gear:
      return { kind: "gear", value: unpackGearPosition((object.value as fb.PhraseGearBoxT).value) };
    default:
      throw new RangeError("union veh.common.Phrase carries no arm");
  }
}

/** Encodes a `veh.common.Pick` payload. */
export function encodePick(value: t.Pick): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packPick(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.Pick` payload the codec has verified. */
export function decodePick(bytes: Uint8Array): t.Pick {
  return unpackPick(fb.Pick.getRootAsPick(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packPick(value: t.Pick): fb.PickT {
  switch (value.kind) {
    case "speed":
      return new fb.PickT(fb.PickUnion.speed, new fb.PickSpeedBoxT(value.value));
    case "gear":
      return new fb.PickT(fb.PickUnion.gear, new fb.PickGearBoxT(BigInt(value.value)));
    case "reading":
      return new fb.PickT(fb.PickUnion.reading, packSensorReading(value.value));
  }
}
function unpackPick(object: fb.PickT): t.Pick {
  switch (object.valueType) {
    case fb.PickUnion.speed:
      return { kind: "speed", value: t.makeSpeedUnchecked((object.value as fb.PickSpeedBoxT).value) };
    case fb.PickUnion.gear:
      return { kind: "gear", value: unpackGearPosition((object.value as fb.PickGearBoxT).value) };
    case fb.PickUnion.reading:
      return { kind: "reading", value: unpackSensorReading(object.value as fb.SensorReadingT) };
    default:
      throw new RangeError("union veh.common.Pick carries no arm");
  }
}

function packSensorBoundsRange(value: { min: t.Speed; max: t.Speed }, _at: string): fb.SensorBoundsRangeT {
  const tuple = new fb.SensorBoundsRangeT();
  tuple.field1 = value.min;
  tuple.field2 = value.max;
  return tuple;
}
function unpackSensorBoundsRange(object: fb.SensorBoundsRangeT): { min: t.Speed; max: t.Speed } {
  return { min: t.makeSpeedUnchecked(object.field1), max: t.makeSpeedUnchecked(object.field2) };
}

function packBoundsSummaryRange(value: { min: t.Speed; max: t.Speed }, _at: string): fb.BoundsSummaryRangeT {
  const tuple = new fb.BoundsSummaryRangeT();
  tuple.field1 = value.min;
  tuple.field2 = value.max;
  return tuple;
}
function unpackBoundsSummaryRange(object: fb.BoundsSummaryRangeT): { min: t.Speed; max: t.Speed } {
  return { min: t.makeSpeedUnchecked(object.field1), max: t.makeSpeedUnchecked(object.field2) };
}

function packExtrasWide(value: { big: bigint; sparse: readonly t.Speed[] }, _at: string): fb.ExtrasWideT {
  const tuple = new fb.ExtrasWideT();
  tuple.field1 = value.big;
  tuple.field2 = [...value.sparse];
  return tuple;
}
function unpackExtrasWide(object: fb.ExtrasWideT): { big: bigint; sparse: readonly t.Speed[] } {
  return { big: object.field1, sparse: object.field2.map((element) => t.makeSpeedUnchecked(element)) };
}

function packPairsPair(value: { text: string; count: t.Speed }, at: string): fb.PairsPairT {
  const tuple = new fb.PairsPairT();
  tuple.field1 = checkWellFormed(value.text, at + ".text");
  tuple.field2 = value.count;
  return tuple;
}
function unpackPairsPair(object: fb.PairsPairT): { text: string; count: t.Speed } {
  return { text: object.field1 as string, count: t.makeSpeedUnchecked(object.field2) };
}

function packPairsListElement(value: { text: string; deep: { word: string } }, at: string): fb.PairsListElementT {
  const tuple = new fb.PairsListElementT();
  tuple.field1 = checkWellFormed(value.text, at + ".text");
  tuple.field2 = packPairsListElementDeep(value.deep, at + ".deep");
  return tuple;
}
function unpackPairsListElement(object: fb.PairsListElementT): { text: string; deep: { word: string } } {
  return { text: object.field1 as string, deep: object.field2 === null ? absent("veh.common.PairsListElement", "deep") : unpackPairsListElementDeep(object.field2) };
}

function packPairsListElementDeep(value: { word: string }, at: string): fb.PairsListElementField2T {
  const tuple = new fb.PairsListElementField2T();
  tuple.field1 = checkWellFormed(value.word, at + ".word");
  return tuple;
}
function unpackPairsListElementDeep(object: fb.PairsListElementField2T): { word: string } {
  return { word: object.field1 as string };
}

