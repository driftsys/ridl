import * as flatbuffers from "flatbuffers";
import type { PayloadCodec } from "@driftsys/ridl-runtime";
import type * as t from "./veh.common.js";
import type * as ridl_std from "./ridl.std.js";
// `flatc --ts --gen-object-api` writes this module when its `-o` is the directory
// of this file.
import * as fb from "./veh/common.js";
import * as ridl_std_codec from "./ridl.std.codec.js";

/** Throws for a required field the buffer leaves out. */
function absent(type: string, field: string): never {
  throw new RangeError(`field ${field} of ${type} is absent`);
}

/** The name of the catalog unit this package belongs to. */
export const CATALOG_NAME = "veh.common";
/** The hash of the catalog unit, which the wasm module carries. */
export const CATALOG_HASH: Uint8Array = Uint8Array.from([223, 225, 162, 41, 146, 95, 47, 169, 16, 82, 155, 70, 113, 176, 17, 27, 62, 152, 110, 51, 140, 54, 126, 37, 56, 145, 179, 58, 123, 215, 182, 63]);
/** The qualified names of the payload types of this package, which name the wasm type ids. */
export const PAYLOAD_TYPES = [
  "veh.common.Counter",
  "veh.common.DriverProfile",
  "veh.common.Gain",
  "veh.common.GearPosition",
  "veh.common.Mode",
  "veh.common.Outcome",
  "veh.common.RPM",
  "veh.common.Ratio",
  "veh.common.RawWheelFrame",
  "veh.common.SensorBounds",
  "veh.common.SensorFault",
  "veh.common.SensorReading",
  "veh.common.SensorResult",
  "veh.common.SensorsSetLimitParams",
  "veh.common.SensorsSpanParams",
  "veh.common.SensorsSpanReply",
  "veh.common.Setting",
  "veh.common.Speed",
  "veh.common.SpeedLimitPayload",
  "veh.common.Temperature",
  "veh.common.Warning",
  "veh.common.WarningFlags",
] as const;
/** The text of each rule code the wasm module reports, rule code n at index n - 2. */
export const RULES = ["length", "pattern", "range", "step", "unique", "variant"] as const;

/** The induced tuple of `Sensors.setLimit`. */
export interface SensorsSetLimitParams {
  limit: t.Speed;
  actual: t.Speed;
}

/** The induced tuple of `Sensors.span`. */
export interface SensorsSpanParams {}

/** The induced tuple of `Sensors.span`. */
export interface SensorsSpanReply {
  min: t.Speed;
  max: t.Speed;
}

/** Encodes a `veh.common.Speed` payload. */
export function encodeSpeed(value: t.Speed): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(new fb.SpeedBoxT(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.Speed` payload the codec has verified. */
export function decodeSpeed(bytes: Uint8Array): t.Speed {
  return fb.SpeedBox.getRootAsSpeedBox(new flatbuffers.ByteBuffer(bytes)).unpack().value as t.Speed;
}

