  object.meta = value.meta.map(([key, value]) => { const entry = new fb.SensorBoundsMetaEntryT(); entry.key = checkWellFormed(key, "veh.common.SensorBounds.meta.key"); entry.value = checkWellFormed(value, "veh.common.SensorBounds.meta.value"); return entry; });
