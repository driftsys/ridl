function packOutcome(value: t.Outcome): fb.OutcomeT {
  switch (value.kind) {
    case "okReading":
      return new fb.OutcomeT(fb.OutcomeUnion.ok_reading, packSensorReading(value.value));
    case "errFault":
      return new fb.OutcomeT(fb.OutcomeUnion.err_fault, packSensorFault(value.value));
