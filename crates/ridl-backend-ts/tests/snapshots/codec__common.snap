const codecCounter: PayloadCodec<t.Counter> = { type: "veh.common.Counter", encode: encodeCounter, decode: decodeCounter };
const codecDriverProfile: PayloadCodec<t.DriverProfile> = { type: "veh.common.DriverProfile", encode: encodeDriverProfile, decode: decodeDriverProfile };
const codecSensorResult: PayloadCodec<t.SensorResult> = { type: "veh.common.SensorResult", encode: encodeSensorResult, decode: decodeSensorResult };
const codecSensorReading: PayloadCodec<t.SensorReading> = { type: "veh.common.SensorReading", encode: encodeSensorReading, decode: decodeSensorReading };
const codecSetting: PayloadCodec<t.Setting> = { type: "veh.common.Setting", encode: encodeSetting, decode: decodeSetting };
const codecNote: PayloadCodec<t.Note> = { type: "veh.common.Note", encode: encodeNote, decode: decodeNote };
const codecBoundsSummary: PayloadCodec<t.BoundsSummary> = { type: "veh.common.BoundsSummary", encode: encodeBoundsSummary, decode: decodeBoundsSummary };
const codecExtras: PayloadCodec<t.Extras> = { type: "veh.common.Extras", encode: encodeExtras, decode: decodeExtras };
const codecPick: PayloadCodec<t.Pick> = { type: "veh.common.Pick", encode: encodePick, decode: decodePick };
const codecSensorsSetLimitParams: PayloadCodec<SensorsSetLimitParams> = { type: "veh.common.SensorsSetLimitParams", encode: encodeSensorsSetLimitParams, decode: decodeSensorsSetLimitParams };
const codecSensorsSpanParams: PayloadCodec<SensorsSpanParams> = { type: "veh.common.SensorsSpanParams", encode: encodeSensorsSpanParams, decode: decodeSensorsSpanParams };
const codecSensorsSpanReply: PayloadCodec<SensorsSpanReply> = { type: "veh.common.SensorsSpanReply", encode: encodeSensorsSpanReply, decode: decodeSensorsSpanReply };
const codecRidlStdName: PayloadCodec<ridl_std.Name> = { type: "ridl.std.Name", encode: ridl_std_codec.encodeName, decode: ridl_std_codec.decodeName };

/** The members of interface `Sensors`, interface number `1`. */
export const Sensors = {
  iface: 1,
  latest: { iface: 1, ord: 1, kind: "signal", payload: codecSensorReading },
  result: { iface: 1, ord: 3, kind: "event", payload: codecSensorResult },
  bounds: { iface: 1, ord: 4, kind: "event", payload: codecBoundsSummary },
  setLimit: { iface: 1, ord: 5, kind: "command", request: codecSensorsSetLimitParams },
  profile: { iface: 1, ord: 6, kind: "query", request: codecRidlStdName, reply: codecDriverProfile },
  span: { iface: 1, ord: 7, kind: "query", request: codecSensorsSpanParams, reply: codecSensorsSpanReply },
  setting: { iface: 1, ord: 8, kind: "signal", payload: codecSetting },
  note: { iface: 1, ord: 9, kind: "signal", payload: codecNote, limit: 4096 },
  fetch: { iface: 1, ord: 10, kind: "query", request: codecCounter },
  extras: { iface: 1, ord: 11, kind: "signal", payload: codecExtras },
  pick: { iface: 1, ord: 12, kind: "signal", payload: codecPick },
} as const;

function signalCheck(codec: Codec, entry: { readonly iface: number; readonly ord: number; readonly payload: { readonly type: string } }): SignalCheckEntry {
  const typeId = codec.typeId(entry.payload.type);
  return {
    iface: entry.iface,
    ord: entry.ord,
    check: (bytes) => {
      const result = codec.verify(typeId, bytes);
      if (result.ok) return undefined;
      if (result.kind !== "rule") return "corrupt";
      const rule = (RULES as readonly string[]).find((known) => known === result.rule);
      if (rule === undefined) throw new CodecError("unknown rule during signal verification");
      return { rule: rule as (typeof RULES)[number] };
    },
  };
}

/** Returns the check of each signal of this package, for the `checks` option of `connect`. The checks resolve the type ids of `codec` once, here. */
export function signalChecks(codec: Codec): readonly SignalCheckEntry[] {
  return [
    signalCheck(codec, Sensors.latest),
    signalCheck(codec, Sensors.setting),
    signalCheck(codec, Sensors.note),
    signalCheck(codec, Sensors.extras),
    signalCheck(codec, Sensors.pick),
  ];
}
