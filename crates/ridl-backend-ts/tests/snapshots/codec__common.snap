function unpackSensorResult(object: fb.SensorResultT): t.SensorResult {
  switch (object.valueType) {
    case fb.SensorResultUnion.ok:
      return { kind: "ok", value: unpackSensorReading(object.value as fb.SensorReadingT) };
    case fb.SensorResultUnion.err:
      return { kind: "err", value: unpackSensorFault(object.value as fb.SensorFaultT) };
    default:
      throw new RangeError("union veh.common.SensorResult carries no arm");
