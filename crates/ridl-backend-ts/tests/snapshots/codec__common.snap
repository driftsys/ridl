function packSensorResult(value: t.SensorResult): fb.SensorResultT {
  switch (value.kind) {
    case "ok":
      return new fb.SensorResultT(fb.SensorResultUnion.ok, packSensorReading(value.value));
    case "err":
      return new fb.SensorResultT(fb.SensorResultUnion.err, packSensorFault(value.value));
