function unpackGearPosition(raw: number | bigint): t.GearPosition {
  const n = Number(raw);
  if (!([0, 1, 2, 3] as readonly number[]).includes(n)) {
    throw new RuleError("variant", `value ${raw} is not a value of veh.common.GearPosition`);
  }
  return n as t.GearPosition;
}

