export function decodeExtras(bytes: Uint8Array): t.Extras {
  return unpackExtras(fb.Extras.getRootAsExtras(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packExtras(value: t.Extras): fb.ExtrasT {
