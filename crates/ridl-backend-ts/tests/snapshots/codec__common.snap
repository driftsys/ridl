/** Encodes a `veh.common.Pick` payload. */
export function encodePick(value: t.Pick): Uint8Array {
  const builder = new flatbuffers.Builder();
  builder.finish(packPick(value).pack(builder));
  return builder.asUint8Array();
}
/** Decodes a `veh.common.Pick` payload the codec has verified. */
export function decodePick(bytes: Uint8Array): t.Pick {
  return unpackPick(fb.Pick.getRootAsPick(new flatbuffers.ByteBuffer(bytes)).unpack());
}

function packPick(value: t.Pick): fb.PickT {
  switch (value.kind) {
    case "speed":
      return new fb.PickT(fb.PickUnion.speed, new fb.PickSpeedBoxT(value.value));
    case "gear":
      return new fb.PickT(fb.PickUnion.gear, new fb.PickGearBoxT(BigInt(value.value)));
    case "reading":
      return new fb.PickT(fb.PickUnion.reading, packSensorReading(value.value));
  }
}
function unpackPick(object: fb.PickT): t.Pick {
  switch (object.valueType) {
    case fb.PickUnion.speed:
      return { kind: "speed", value: (object.value as fb.PickSpeedBoxT).value as t.Speed };
    case fb.PickUnion.gear:
      return { kind: "gear", value: unpackGearPosition((object.value as fb.PickGearBoxT).value) };
    case fb.PickUnion.reading:
      return { kind: "reading", value: unpackSensorReading(object.value as fb.SensorReadingT) };
    default:
      throw new RangeError("union veh.common.Pick carries no arm");
  }
}

function packSensorBoundsRange(value: { min: t.Speed; max: t.Speed }): fb.SensorBoundsRangeT {
  const tuple = new fb.SensorBoundsRangeT();
  tuple.field1 = value.min;
  tuple.field2 = value.max;
  return tuple;
}
function unpackSensorBoundsRange(object: fb.SensorBoundsRangeT): { min: t.Speed; max: t.Speed } {
  return { min: object.field1 as t.Speed, max: object.field2 as t.Speed };
}

function packBoundsSummaryRange(value: { min: t.Speed; max: t.Speed }): fb.BoundsSummaryRangeT {
  const tuple = new fb.BoundsSummaryRangeT();
  tuple.field1 = value.min;
  tuple.field2 = value.max;
  return tuple;
}
function unpackBoundsSummaryRange(object: fb.BoundsSummaryRangeT): { min: t.Speed; max: t.Speed } {
  return { min: object.field1 as t.Speed, max: object.field2 as t.Speed };
}

function packExtrasWide(value: { big: bigint; sparse: readonly t.Speed[] }): fb.ExtrasWideT {
  const tuple = new fb.ExtrasWideT();
  tuple.field1 = value.big;
  tuple.field2 = [...value.sparse];
  return tuple;
}
function unpackExtrasWide(object: fb.ExtrasWideT): { big: bigint; sparse: readonly t.Speed[] } {
  return { big: object.field1, sparse: object.field2.map((element) => element as t.Speed) };
}

