package ctor

/// A bounded integer.
type Small : integer [-10..20]

/// An integer with only a lower bound.
type Lower : integer [-10..]

/// An integer with only an upper bound.
type Upper : integer [..20]

/// An integer with bounds beyond the safe number interval.
type Wide : integer [-9007199254740993..9007199254740993]

/// An integer with the Rust backing's maximum.
type Maximum : integer [0..9223372036854775807]

/// An integer without bounds.
type FreeInteger : integer

/// A bounded floating-point value.
type Real : float [-1.5..2.5]

/// A floating-point value with only a lower bound.
type LowerReal : float [-1.5..]

/// A floating-point value with only an upper bound.
type UpperReal : float [..2.5]

/// A floating-point value without bounds.
type Unbounded : float

/// A floating-point range whose declared grid derives a 32-bit width.
type NarrowReal : float [-1.0..2.0 step 1.0]

/// A 32-bit float on a decimal grid.
type Tenth : float [0.0..1.0 step 0.1]

/// A 32-bit float on a decimal grid that starts between two multiples of the step.
type Shifted : float [0.05..1.05 step 0.1]

/// A 64-bit float on a fine decimal grid.
type Precise : float [-1.0..1.0 step 0.0000000001]

/// A float grid whose minimum is negative and not a multiple of the step.
type Negative : float [-1.05..1.0 step 0.1]

/// A string of one to four characters.
type Word : string [1..4]

/// A string of exactly three characters.
type Triple : string [3..3]

/// A string that may be empty.
type Short : string [0..8]

/// A string with the default length bound of 0 through 256 characters.
type Free : string

/// A string whose pattern is anchored at both ends.
type Capitals : string [1..8 match /^[A-Z]+$/]

/// A string whose pattern is not anchored, so a match anywhere accepts it.
type Contains : string [0..16 match /ab/]

/// A string of exactly one UTF-16 unit by pattern, which is one character.
type Dot : string [0..4 match /^.$/]

/// A string whose pattern holds an escape and a quote.
type Quoted : string [0..16 match /^\d+'x$/]

/// A byte string of two to four bytes.
type Blob : bytes [2..4]

/// A byte string that may be empty.
type Raw : bytes [0..8]

/// A name that the runtime package exports as a class.
type ConstraintError : integer [0..100]

/// A name that the runtime package exports as a function.
type codePointLength : string [1..4]

/// A name that the runtime package exports as a function.
type isWellFormedString : string [0..8 match /^[a-z]*$/]

/// A name that the runtime package exports as a function.
type offFloatPoints : float [0.0..1.0 step 0.25]

/// A name that the runtime package exports as a function.
type offFloatStep : float [0.0..1.0 step 0.1]
