# .primignore — prim's committed escape hatch (gitignore syntax).
# Paths listed here are left byte-for-byte unchanged by prim.
# prim is the driftsys connective-tissue formatter: https://github.com/driftsys/prim

# git-std generates CHANGELOG.md; prim must not reflow generated content.
CHANGELOG.md

# mdBook build output.
book/

# The committed baseline snapshot for the E2.11b desk-check corpus member. It
# is written by `ridl baseline` and read back by `ridl check`, so it must stay
# byte-for-byte as the toolchain wrote it.
crates/ridl/tests/baseline-corpus/.ridl/baseline/*.ir.json
