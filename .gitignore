# mdBook build output (docs/ is the source; mdBook builds to ./book)
/book

# Rust build output (docs/ROADMAP.md epic E0)
/target
**/target
**/*.rs.bk

# The demo's generated crate — written by `just demo` from
# `examples/cabin/cabin.ridl`, never edited and never committed. What is in
# git is the schema it is generated from and the program that links it.
/examples/cabin/generated/

# The crate `just demo` generates from `crates/ridlc/tests/corpus/veh-cluster`
# for its `no_std` check, which cabin's schema alone cannot reach: it has no
# string, bytes, array, map or pattern.
/examples/cabin/generated-corpus/

# The crate `just demo` generates from `crates/ridlc/tests/corpus/rust-shapes`
# for its clippy, format and doc runs over every shape the Rust backend emits.
/examples/cabin/generated-shapes/

# The schema, the TypeScript and the wasm codec that `just cabin-ws-demo`
# writes for the cabin web program: `ridl build --emit flatbuffers` and
# `flatc` output, and veh_cabin.wasm.
/examples/cabin/web/generated/

# Node (the VS Code extension's own dependencies)
node_modules/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code worktrees
.claude/worktrees/

# Superpowers orchestration scratch — not part of the repo
/.superpowers/

# insta pending snapshots — accepted .snap files are committed, drafts are not
*.snap.new
*.pending-snap

# VS Code extension build output (docs/ROADMAP.md, epic E1.17)
editors/vscode/node_modules
editors/vscode/*.vsix
editors/vscode/out
editors/vscode/bin/
editors/vscode/skills/

# Raw eval transcripts stay local; the result files are committed.
evals/results/*/transcripts/

# The npm package `just ts-npm-check` builds with dnt.
/packages/ridl-transport-ws/npm/
/packages/ridl-transport-ws/deno.lock
/packages/ridl-runtime/npm/
/packages/ridl-runtime/deno.lock
