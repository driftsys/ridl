  path : Path
  controllerId : RosString
  goalCheckerId : RosString
  progressCheckerId : RosString
  pathHandlerId : RosString
}
struct FollowPathResult {

// result definition

// Error codes
// Note: The expected priority order of the errors should match the message order
  // ROS constant NONE = 0; package constant FOLLOW_PATH_RESULT_NONE
  // ROS constant GOAL_REJECTED = 1; package constant FOLLOW_PATH_RESULT_GOAL_REJECTED
  // ROS constant SEND_GOAL_FAILURE = 2; package constant FOLLOW_PATH_RESULT_SEND_GOAL_FAILURE
  // ROS constant UNKNOWN = 100; package constant FOLLOW_PATH_RESULT_UNKNOWN
  // ROS constant INVALID_CONTROLLER = 101; package constant FOLLOW_PATH_RESULT_INVALID_CONTROLLER
  // ROS constant TF_ERROR = 102; package constant FOLLOW_PATH_RESULT_TF_ERROR
  // ROS constant INVALID_PATH = 103; package constant FOLLOW_PATH_RESULT_INVALID_PATH
  // ROS constant PATIENCE_EXCEEDED = 104; package constant FOLLOW_PATH_RESULT_PATIENCE_EXCEEDED
  // ROS constant FAILED_TO_MAKE_PROGRESS = 105; package constant FOLLOW_PATH_RESULT_FAILED_TO_MAKE_PROGRESS
  // ROS constant NO_VALID_CONTROL = 106; package constant FOLLOW_PATH_RESULT_NO_VALID_CONTROL
  // ROS constant CONTROLLER_TIMED_OUT = 107; package constant FOLLOW_PATH_RESULT_CONTROLLER_TIMED_OUT
  // ROS constant TIMEOUT = 108; package constant FOLLOW_PATH_RESULT_TIMEOUT

  result : Empty
  errorCode : RosUInt16
  errorMsg : RosString
}
struct FollowPathFeedback {

// feedback definition
// Real-time tracking error indicating which side of the path the robot is on
// If the position_tracking_error is positive, the robot is to the left of the path
// If the heading_tracking_error is positive, the robot heading is rotated to the right of the path direction
  trackingFeedback : TrackingFeedback
}
const FOLLOW_PATH_RESULT_NONE : RosUInt16 = 0
const FOLLOW_PATH_RESULT_GOAL_REJECTED : RosUInt16 = 1
const FOLLOW_PATH_RESULT_SEND_GOAL_FAILURE : RosUInt16 = 2
