const WAIT_RESULT_TIMEOUT : RosUInt16 = 741
interface Nav2MsgsInteractions {
  query clearEntireCostmap(plugins: ClearEntireCostmapRequest): ClearEntireCostmapResponse
  query getCostmap(specs: CostmapMetaData): GetCostmapResponse
  query isPathValid(path: Path, maxCost: RosUInt8, considerUnknownAsObstacle: RosBoolean, layerName: RosString, footprint: RosString, stopAtFirstCollision: RosBoolean, maxLookaheadDistance: RosFloat64): IsPathValidResponse
  query loadMap(mapUrl: RosString): LoadMapResponse
  query manageLifecycleNodes(commandValue: RosUInt8): ManageLifecycleNodesResponse
  query saveMap(mapTopic: RosString, mapUrl: RosString, imageFormat: RosString, mapMode: RosString, freeThresh: RosFloat32, occupiedThresh: RosFloat32): SaveMapResponse
  command assistedTeleop(goal: AssistedTeleopGoal)
  event assistedTeleopFeedback : AssistedTeleopFeedback
  command backUp(goal: BackUpGoal)
  event backUpFeedback : BackUpFeedback
  command followPath(goal: FollowPathGoal)
  event followPathFeedback : FollowPathFeedback
  command followWaypoints(goal: FollowWaypointsGoal)
  event followWaypointsFeedback : FollowWaypointsFeedback
  command navigateToPose(goal: NavigateToPoseGoal)
  event navigateToPoseFeedback : NavigateToPoseFeedback
  command spin(goal: SpinGoal)
  event spinFeedback : SpinFeedback
  command wait(goal: WaitGoal)
  event waitFeedback : WaitFeedback
}
