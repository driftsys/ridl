// Upstream: nav2_msgs/srv/SaveMap.srv
struct SaveMapRequest {
// URL of map resource
// Can be an absolute path to a file: file:///path/to/maps/floor1.yaml
// Or, relative to a ROS package: package://my_ros_package/maps/floor2.yaml
  mapTopic : RosString
  mapUrl : RosString
// Constants for image_format. Supported formats: pgm, png, bmp
  imageFormat : RosString
// Map modes: trinary, scale or raw
  mapMode : RosString
// Thresholds. Values in range of [0.0 .. 1.0]
  freeThresh : RosFloat32
  occupiedThresh : RosFloat32
}
struct SaveMapResponse {

  result : RosBoolean
}
