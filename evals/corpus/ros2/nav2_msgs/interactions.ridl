// Modified ROS 2-to-RIDL translation. Inputs and pinned revisions: PROVENANCE.md.
package nav2msgs
import builtininterfaces.Duration
import geometrymsgs.Point
import geometrymsgs.PoseStamped
import navmsgs.OccupancyGrid
import navmsgs.Path
import stdmsgs.Empty
type RosInt16 : integer [-32768..32767]
type RosInt32 : integer [-2147483648..2147483647]
// Upstream: nav2_msgs/srv/ClearEntireCostmap.srv
struct ClearEntireCostmapRequest {
// Clears all layers on the costmap

  plugins : [RosString; 0..18446744073709551615]
}
struct ClearEntireCostmapResponse {

  success : RosBoolean
}
// Upstream: nav2_msgs/srv/GetCostmap.srv
struct GetCostmapRequest {
// Get the costmap

// Specifications for the requested costmap
  specs : CostmapMetaData
}
struct GetCostmapResponse {

  map : Costmap
}
// Upstream: nav2_msgs/srv/IsPathValid.srv
struct IsPathValidRequest {
//Determine if the current path is still valid

  path : Path
  maxCost : RosUInt8 = 254
  considerUnknownAsObstacle : RosBoolean = false
  layerName : RosString = ""
  footprint : RosString = ""
  stopAtFirstCollision : RosBoolean = true
  maxLookaheadDistance : RosFloat64 = -1.0
}
struct IsPathValidResponse {

  success : RosBoolean
  isValid : RosBoolean
  invalidPoseIndices : [RosInt32; 0..18446744073709551615]
}
// Upstream: nav2_msgs/srv/LoadMap.srv
struct LoadMapRequest {
// URL of map resource
// Can be an absolute path to a file: file:///path/to/maps/floor1.yaml
// Or, relative to a ROS package: package://my_ros_package/maps/floor2.yaml
  mapUrl : RosString
}
struct LoadMapResponse {

// Result code definitions
  // ROS constant RESULT_SUCCESS = 0; package constant LOAD_MAP_RESPONSE_RESULT_SUCCESS
  // ROS constant RESULT_MAP_DOES_NOT_EXIST = 1; package constant LOAD_MAP_RESPONSE_RESULT_MAP_DOES_NOT_EXIST
  // ROS constant RESULT_INVALID_MAP_DATA = 2; package constant LOAD_MAP_RESPONSE_RESULT_INVALID_MAP_DATA
  // ROS constant RESULT_INVALID_MAP_METADATA = 3; package constant LOAD_MAP_RESPONSE_RESULT_INVALID_MAP_METADATA
  // ROS constant RESULT_UNDEFINED_FAILURE = 255; package constant LOAD_MAP_RESPONSE_RESULT_UNDEFINED_FAILURE

// Returned map is only valid if result equals RESULT_SUCCESS
  map : OccupancyGrid
  result : RosUInt8
}
const LOAD_MAP_RESPONSE_RESULT_SUCCESS : RosUInt8 = 0
const LOAD_MAP_RESPONSE_RESULT_MAP_DOES_NOT_EXIST : RosUInt8 = 1
const LOAD_MAP_RESPONSE_RESULT_INVALID_MAP_DATA : RosUInt8 = 2
const LOAD_MAP_RESPONSE_RESULT_INVALID_MAP_METADATA : RosUInt8 = 3
const LOAD_MAP_RESPONSE_RESULT_UNDEFINED_FAILURE : RosUInt8 = 255
