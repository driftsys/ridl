# git-std hooks — pre-commit.hooks
#
#   !  check     run command, block commit on failure
#   ?  advisory  run command, never block commit
#   ~  format    run command in place, restage the result
#
# Format the connective tissue before committing.
~ prim .
~ cargo fmt --all   *.rs
~ deno fmt --config packages/ridl-runtime/deno.json packages/ridl-runtime   packages/ridl-runtime/**/*.ts
~ deno fmt --config packages/ridl-transport-ws/deno.json packages/ridl-transport-ws   packages/ridl-transport-ws/**/*.ts
